        КлиентКП = "ООО АльфаМарт";

        Если Данные <> Неопределено И Данные.Свойство("client_name") Тогда КлиентКП = Данные.client_name; КонецЕсли;

        ТекстКП = СформироватьКоммерческоеПредложениеНаСервере(КлиентКП);

        ДобавитьСообщениеВЧатНаСервере(ТекстКП, "bot", "generate_commercial_proposal", Неопределено);

