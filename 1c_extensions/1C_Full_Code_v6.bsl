// 10. СЛУЖЕБНЫЙ БЛОК СЕТЕВОГО ВЗАИМОДЕЙСТВИЯ (Префикс «Ш_»)















// =============================================================================































&НаСервере















Процедура ПолучитьТокенАвторизацииНаСервере()















    ШПолучитьТокенАвторизации();















КонецПроцедуры































&НаСервере















Функция ВыполнитьHTTPЗапрос(Путь, ТелоЗапроса = "", Метод = "POST")















    Возврат ШВыполнитьHTTPЗапрос(Путь, ТелоЗапроса, Метод);















КонецФункции































&НаСервере















Процедура ШПолучитьТокенАвторизации()















    Если Не ПустаяСтрока(MiddlewareТокен) Тогда















        Возврат;















    КонецЕсли;















    















    Логин = СокрЛП(ЛогинMiddleware);















    Если ПустаяСтрока(Логин) Тогда















        Логин = "1c_service";















        ЛогинMiddleware = "1c_service";















    КонецЕсли;















    















    Пароль = СокрЛП(ПарольMiddleware);















    Если ПустаяСтрока(Пароль) Тогда















        Пароль = "1c_service_2024";















        ПарольMiddleware = "1c_service_2024";















    КонецЕсли;















    















    Попытка















        HTTP = ШСоздатьСоединение();















        Заголовки = Новый Соответствие;















        Заголовки.Вставить("Content-Type", "application/json");















        















        Запрос = Новый HTTPЗапрос("/auth/login", Заголовки);















        Тело = ШСериализоватьВJSON(Новый Структура("username, password", Логин, Пароль));















        Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);















        















        Ответ = HTTP.ОтправитьДляОбработки(Запрос);















        Если Ответ.КодСостояния = 200 Тогда















            Структура = ШДесериализоватьИзJSON(Ответ.ПолучитьТелоКакСтроку());















            Если Структура <> Неопределено И Структура.Свойство("access_token") Тогда















                MiddlewareТокен = Структура.access_token;















            КонецЕсли;















        КонецЕсли;















    Исключение















        MiddlewareТокен = "";















    КонецПопытки;















КонецПроцедуры































&НаСервере















Функция ШСоздатьСоединение()















    Адрес = СокрЛП(АдресMiddleware);















    Если ПустаяСтрока(Адрес) Тогда















        Адрес = "http://127.0.0.1:8000";















        АдресMiddleware = "http://127.0.0.1:8000";















    КонецЕсли;















    















    ИспользоватьSSL = ИспользоватьHTTPS;















    Если СтрНачинаетсяС(НРег(Адрес), "https://") Тогда















        ИспользоватьSSL = Истина;















        Адрес = Сред(Адрес, 9);















    ИначеЕсли СтрНачинаетсяС(НРег(Адрес), "http://") Тогда















        Адрес = Сред(Адрес, 8);















    КонецЕсли;















    















    // Выделение порта















    Порт = ?(ИспользоватьSSL, 443, 8000);















    ИндПорта = СтрНайти(Адрес, ":");















    Если ИндПорта > 0 Тогда















        ПортСтрока = Сред(Адрес, ИндПорта + 1);















        Адрес = Лев(Адрес, ИндПорта - 1);















        ИндСлэшаПорт = СтрНайти(ПортСтрока, "/");















        Если ИндСлэшаПорт > 0 Тогда















            ПортСтрока = Лев(ПортСтрока, ИндСлэшаПорт - 1);















        КонецЕсли;















        Попытка















            Порт = Число(ПортСтрока);















        Исключение















            Порт = 8000;















        КонецПопытки;















    КонецЕсли;















    















    // Удаление завершающего слэша















    ИндСлэша = СтрНайти(Адрес, "/");















    Если ИндСлэша > 0 Тогда















        Адрес = Лев(Адрес, ИндСлэша - 1);















    КонецЕсли;















    















    Если ПустаяСтрока(Адрес) Тогда















        Адрес = "127.0.0.1";















    КонецЕсли;















    















    Если ИспользоватьSSL Тогда















        Возврат Новый HTTPСоединение(Адрес, Порт, , , , 60, Новый ЗащищенноеСоединениеOpenSSL());















    Иначе















        Возврат Новый HTTPСоединение(Адрес, Порт, , , , 60);















    КонецЕсли;















