Функция ШШестнадцатьВЧисло(Симв1, Симв2)















    Стр16 = "0123456789ABCDEF";















    С1 = ВРег(Симв1);















    С2 = ВРег(Симв2);















    И1 = СтрНайти(Стр16, С1) - 1;















    И2 = СтрНайти(Стр16, С2) - 1;















    Если И1 < 0 ИЛИ И2 < 0 Тогда Возврат 0; КонецЕсли;















    Возврат (И1 * 16) + И2;















КонецФункции































&НаКлиенте















Функция ШДекодироватьURL(Знач ВходнаяСтрока)















    Если ПустаяСтрока(ВходнаяСтрока) ИЛИ СтрНайти(ВходнаяСтрока, "%") = 0 Тогда















        Возврат СтрЗаменить(ВходнаяСтрока, "+", " ");















    КонецЕсли;















    















    Рез = "";















    Длина = СтрДлина(ВходнаяСтрока);















    Инд = 1;















    















    Пока Инд <= Длина Цикл















        Симв = Сред(ВходнаяСтрока, Инд, 1);















        Если Симв = "%" И (Инд + 2 <= Длина) Тогда















            Б1 = ШШестнадцатьВЧисло(Сред(ВходнаяСтрока, Инд + 1, 1), Сред(ВходнаяСтрока, Инд + 2, 1));















            















            Если Б1 < 128 Тогда















                Рез = Рез + Символ(Б1);















                Инд = Инд + 3;















            ИначеЕсли Б1 >= 192 И Б1 <= 223 И (Инд + 5 <= Длина) И Сред(ВходнаяСтрока, Инд + 3, 1) = "%" Тогда















                // 2-байтовый UTF-8 (Кириллица)















                Б2 = ШШестнадцатьВЧисло(Сред(ВходнаяСтрока, Инд + 4, 1), Сред(ВходнаяСтрока, Инд + 5, 1));















                Код = ((Б1 % 32) * 64) + (Б2 % 64);















                Рез = Рез + Символ(Код);















                Инд = Инд + 6;















            ИначеЕсли Б1 >= 224 И Б1 <= 239 И (Инд + 8 <= Длина) И Сред(ВходнаяСтрока, Инд + 3, 1) = "%" И Сред(ВходнаяСтрока, Инд + 6, 1) = "%" Тогда















                // 3-байтовый UTF-8















                Б2 = ШШестнадцатьВЧисло(Сред(ВходнаяСтрока, Инд + 4, 1), Сред(ВходнаяСтрока, Инд + 5, 1));















                Б3 = ШШестнадцатьВЧисло(Сред(ВходнаяСтрока, Инд + 7, 1), Сред(ВходнаяСтрока, Инд + 8, 1));















                Код = ((Б1 % 16) * 4096) + ((Б2 % 64) * 64) + (Б3 % 64);















                Рез = Рез + Символ(Код);















                Инд = Инд + 9;















            ИначеЕсли Б1 >= 240 И (Инд + 11 <= Длина) И Сред(ВходнаяСтрока, Инд + 3, 1) = "%" И Сред(ВходнаяСтрока, Инд + 6, 1) = "%" И Сред(ВходнаяСтрока, Инд + 9, 1) = "%" Тогда















                // 4-байтовый UTF-8 (эмодзи и спецсимволы SMP) — безопасно пропускаем















                Инд = Инд + 12;















            Иначе















                Рез = Рез + Символ(Б1);















                Инд = Инд + 3;















            КонецЕсли;















        ИначеЕсли Симв = "+" Тогда















            Рез = Рез + " ";















            Инд = Инд + 1;















        Иначе















            Рез = Рез + Симв;















            Инд = Инд + 1;















        КонецЕсли;















    КонецЦикла;















    















    Возврат Рез;















КонецФункции















































Функция РазобратьПараметрыURL(СтрокаПараметров)















    Результат = Новый Структура;















    Если ПустаяСтрока(СтрокаПараметров) Тогда















        Возврат Результат;















    КонецЕсли;















    















    МассивПар = СтрРазделить(СтрокаПараметров, "&");















    Для Каждого Пара Из МассивПар Цикл















        ИндРавно = СтрНайти(Пара, "=");















        Если ИндРавно > 0 Тогда















            Ключ = СокрЛП(Лев(Пара, ИндРавно - 1));















            Значение = Сред(Пара, ИндРавно + 1);















            Значение = СтрЗаменить(Значение, "+", " ");















            Значение = СтрЗаменить(Значение, "%20", " ");















            Значение = СтрЗаменить(Значение, "%23", "#");















            Значение = СтрЗаменить(Значение, "%26", "&");















            Значение = СтрЗаменить(Значение, "%3D", "=");















            Значение = СтрЗаменить(Значение, "%2F", "/");















            Значение = СтрЗаменить(Значение, "%3A", ":");















            Значение = СтрЗаменить(Значение, "%3F", "?");















            Попытка















                Результат.Вставить(Ключ, Значение);















            Исключение















            КонецПопытки;















        КонецЕсли;















    КонецЦикла;















    















    Возврат Результат;















КонецФункции































