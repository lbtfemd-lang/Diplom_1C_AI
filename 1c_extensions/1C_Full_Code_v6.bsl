&НаКлиенте
Функция ЭтоМобильныйКлиент()
    Инфо = ПолучитьИнформациюОСистемеКлиента();
    Возврат Инфо.ТипПлатформы = ТипПлатформы.Android ИЛИ Инфо.ТипПлатформы = ТипПлатформы.iOS;
КонецФункции

&НаКлиенте
Процедура БезопасноОткрытьФорму(ИмяФормы, Описание = "", Параметры = Неопределено)
    Попытка
        Если Параметры <> Неопределено Тогда
            ОткрытьФорму(ИмяФормы, Параметры);
        Иначе
            ОткрытьФорму(ИмяФормы);
        КонецЕсли;
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        Если Не ПустаяСтрока(Описание) Тогда
            ДобавитьСообщениеВЧатНаСервере("Не удалось открыть «" + Описание + "» — форма недоступна. Обратитесь к администратору." + Символы.ПС + "(" + ТекстОшибки + ")", "bot");
        Иначе
            ДобавитьСообщениеВЧатНаСервере("Форма недоступна: " + ИмяФормы + Символы.ПС + "(" + ТекстОшибки + ")", "bot");
