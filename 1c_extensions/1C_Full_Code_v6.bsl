            Выборка = Запрос.Выполнить().Выбрать();















        Исключение















            Выборка = Неопределено;















        КонецПопытки;















    КонецПопытки;















    















    Если Выборка = Неопределено ИЛИ НЕ Выборка.Следующий() Тогда















        Возврат "Номенклатура «" + ИмяТовара + "» не найдена в справочнике 1С:УНФ.";















    КонецЕсли;















    















    ИмяН = Выборка.Наименование;















    RefН = Строка(Выборка.Номенклатура.УникальныйИдентификатор());















    Ед = ?(ЗначениеЗаполнено(Выборка.ЕдИзм), Выборка.ЕдИзм, "шт");















    Остаток = Выборка.Остаток;















    Цена = Выборка.Цена;















    















    IconTag = "<svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='#38bdf8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><path d='M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z'/><line x1='7' y1='7' x2='7.01' y2='7'/></svg>";















    IconCart = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><circle cx='9' cy='21' r='1'/><circle cx='20' cy='21' r='1'/><path d='M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6'/></svg>";















    















    HTML = "<div class='table-container' style='padding:14px;border:1px solid #38bdf8;'>"















        + "<div style='font-size:14px;font-weight:700;color:#38bdf8;margin-bottom:8px;'>" + IconTag + "Карточка товара: " + ШЭкранироватьHTML(ИмяН) + "</div>"















        + "<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:12px;margin-bottom:12px;'>"















