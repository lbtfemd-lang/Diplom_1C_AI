    IconList = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><line x1='8' y1='6' x2='21' y2='6'/><line x1='8' y1='12' x2='21' y2='12'/><line x1='8' y1='18' x2='21' y2='18'/><line x1='3' y1='6' x2='3.01' y2='6'/><line x1='3' y1='12' x2='3.01' y2='12'/><line x1='3' y1='18' x2='3.01' y2='18'/></svg>";















    















    HTML = "<div class='table-container'>"















        + "<div class='section-title'>"















        + IconCart + "Оперативный список заказов покупателей</div>"















        + "<table class='table-data'>"















        + "<thead><tr>"















        + "<th>Заказ</th>"















