&НаСервере
Функция ВыполнитьHTTPЗапрос(Путь, ТелоЗапроса = "", Метод = "POST")
    Возврат ШВыполнитьHTTPЗапрос(Путь, ТелоЗапроса, Метод);
КонецФункции

&НаСервере
Функция ВыполнитьHTTPЗапросНаСервере(Путь, ТелоЗапроса, Метод = "POST")
    Ответ = ШВыполнитьHTTPЗапрос(Путь, ТелоЗапроса, Метод);
    Если Ответ = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Результат = Новый Структура;
    Результат.Вставить("КодСостояния", Ответ.КодСостояния);
    Результат.Вставить("Тело", Ответ.ПолучитьТелоКакСтроку());
    Возврат Результат;
КонецФункции

