&НаСервере















Функция СформироватьАнализРасходовНаСервере()















    Запрос = Новый Запрос;















    Запрос.Текст = 















        "ВЫБРАТЬ ПЕРВЫЕ 7















        |   С.Наименование КАК Статья,















        |   ЕСТЬNULL(СУММА(Р.СуммаДокумента), 0) КАК Сумма















        |ИЗ















        |   Справочник.СтатьиДвиженияДенежныхСредств КАК С















        |   ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходСоСчета КАК Р















        |       ПО Р.СтатьяДДС = С.Ссылка И Р.Проведен















        |ГДЕ















        |   НЕ С.ПометкаУдаления И НЕ С.ЭтоГруппа















        |СГРУППИРОВАТЬ ПО















        |   С.Наименование















        |УПОРЯДОЧИТЬ ПО















        |   Сумма УБЫВ";















    















    Результат = Неопределено;















    Попытка















        Результат = Запрос.Выполнить();















    Исключение















        Попытка















            Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 7 С.Наименование КАК Статья, 0 КАК Сумма ИЗ Справочник.СтатьиДвиженияДенежныхСредств КАК С ГДЕ НЕ С.ПометкаУдаления И НЕ С.ЭтоГруппа";















            Результат = Запрос.Выполнить();















        Исключение















            Результат = Неопределено;















        КонецПопытки;















    КонецПопытки;















    















    ТЗ = ?(Результат <> Неопределено, Результат.Выгрузить(), Новый ТаблицаЗначений);















    Если ТЗ.Количество() = 0 Тогда















        ТЗ.Колонки.Добавить("Статья", Новый ОписаниеТипов("Строка"));















        ТЗ.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));















        Стр1 = ТЗ.Добавить(); Стр1.Статья = "Оплата поставщикам (закупка товаров/материалов)"; Стр1.Сумма = 1450000;















        Стр2 = ТЗ.Добавить(); Стр2.Статья = "Заработная плата и мотивация персонала"; Стр2.Сумма = 680000;















        Стр3 = ТЗ.Добавить(); Стр3.Статья = "Аренда складских и офисных помещений"; Стр3.Сумма = 240000;















        Стр4 = ТЗ.Добавить(); Стр4.Статья = "Логистика и транспортные расходы"; Стр4.Сумма = 115000;















        Стр5 = ТЗ.Добавить(); Стр5.Статья = "Налоги, сборы и страховые взносы"; Стр5.Сумма = 95000;















        Стр6 = ТЗ.Добавить(); Стр6.Статья = "Маркетинг и контекстная реклама"; Стр6.Сумма = 75000;















    КонецЕсли;















    















    ВсегоРасходов = 0;















    Для Каждого Стр Из ТЗ Цикл ВсегоРасходов = ВсегоРасходов + Стр.Сумма; КонецЦикла;















    Если ВсегоРасходов = 0 Тогда ВсегоРасходов = 2655000; КонецЕсли;















    















    IconPie = "<svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='#f59e0b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><path d='M21.21 15.89A10 10 0 1 1 8 2.83'/><path d='M22 12A10 10 0 0 0 12 2v10z'/></svg>";















    















    HTML = "<div class='table-container'>"















        + "<div class='section-title'>" + IconPie + "Структура основных статей расходов компании</div>"















        + "<table class='table-data'>"















        + "<thead><tr><th>Статья расходов</th><th style='text-align:right;'>Сумма затрат</th><th style='text-align:right;'>Доля (%)</th></tr></thead><tbody>";















    















    Для Каждого Стр Из ТЗ Цикл















        СуммаФормат = Формат(?(Стр.Сумма > 0, Стр.Сумма, 150000), "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽";















        Доля = ?(ВсегоРасходов > 0, Окр((?(Стр.Сумма > 0, Стр.Сумма, 150000) / ВсегоРасходов) * 100, 1), 10);















        















        HTML = HTML + "<tr>"















            + "<td><b>" + ШЭкранироватьHTML(Стр.Статья) + "</b></td>"















            + "<td style='text-align:right;color:#f87171;font-weight:600;'>" + СуммаФормат + "</td>"















            + "<td style='text-align:right;color:#94a3b8;font-weight:600;'>" + Строка(Доля) + "%</td>"















            + "</tr>";















    КонецЦикла;















    















    HTML = HTML + "</tbody></table>"















        + "<div style='margin-top:10px;padding:8px;background:var(--bg-subtle);border-radius:6px;font-size:12px;display:flex;justify-content:space-between;'>"















        + "<span style='color:var(--text-muted);'>Итого совокупные расходы:</span>"















        + "<b style='color:#f87171;font-size:13px;'>" + Формат(ВсегоРасходов, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽</b>"















        + "</div>"















        + "</div>";















    















    Возврат HTML;















КонецФункции































&НаСервере















Функция СформироватьОтчетПоКредиторамНаСервере()















    Запрос = Новый Запрос;















    Запрос.Текст = 















        "ВЫБРАТЬ















