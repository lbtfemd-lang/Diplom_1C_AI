&НаКлиенте
Процедура ОбновитьМетаданные(Команда)
    ДобавитьСообщениеВЧатНаСервере("Собираю метаданные...", "bot");
    Адрес = СобратьМетаданныеНаСервере();
    JSON = ПолучитьТекстИзВременногоХранилища(Адрес);
    Попытка
        Ответ = ВыполнитьHTTPЗапросНаСервере("/update_metadata", JSON);
        Если Ответ <> Неопределено И Ответ.КодСостояния = 200 Тогда
            ДобавитьСообщениеВЧатНаСервере("Метаданные обновлены!", "bot");
        Иначе
            ДобавитьСообщениеВЧатНаСервере("Ошибка: " + ?(Ответ=Неопределено, "нет связи с сервером", Строка(Ответ.КодСостояния)), "bot");
        КонецЕсли;
    Исключение
        ДобавитьСообщениеВЧатНаСервере("Ошибка: " + ОписаниеОшибки(), "bot");
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция СобратьМетаданныеНаСервере()
    Список = Новый Массив;
    Коллекции = Новый Массив;
    Коллекции.Добавить("Справочники"); Коллекции.Добавить("Документы"); Коллекции.Добавить("Отчеты");
    Для Каждого ИмяКоллекции Из Коллекции Цикл
        Для Каждого МетаОбъект Из Метаданные[ИмяКоллекции] Цикл
            ИмяТипа = ?(ИмяКоллекции="Справочники", "Справочник", ?(ИмяКоллекции="Документы", "Документ", "Отчет"));
            МассивПолей = Новый Массив;
            Для Каждого Рек Из МетаОбъект.Реквизиты Цикл
                МассивПолей.Добавить(Новый Структура("name, synonym, type", Рек.Имя, Рек.Синоним, Строка(Рек.Тип)));
            КонецЦикла;
            Список.Добавить(Новый Структура("name, synonym, fields", ИмяТипа + "." + МетаОбъект.Имя, ?(ПустаяСтрока(МетаОбъект.Синоним), МетаОбъект.Имя, МетаОбъект.Синоним), МассивПолей));
        КонецЦикла;
    КонецЦикла;
    Пакет = Новый Структура("items", Список);
    ЗаписьJSON = Новый ЗаписьJSON; ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Пакет);
    Возврат ПоместитьВоВременноеХранилище(ЗаписьJSON.Закрыть(), УникальныйИдентификатор);
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекстИзВременногоХранилища(Адрес)
    Возврат ПолучитьИзВременногоХранилища(Адрес);
