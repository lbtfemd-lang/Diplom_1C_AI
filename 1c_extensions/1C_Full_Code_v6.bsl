&НаСервере



Функция СформироватьПрогнозКассовогоРазрываНаСервере()

    IconCash = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#10b981' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><circle cx='12' cy='12' r='10'/><path d='M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8'/><path d='M12 18V6'/></svg>";
    IconAlert = "<svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='#f87171' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/></svg>";
    IconTask = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/></svg>";

    // 1. Живые деньги на счетах и в кассе
    ДеньгиФакт = 0;
    Попытка
        ЗапросД = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаОстаток), 0) КАК ВсегоДеньги ИЗ РегистрНакопления.ДенежныеСредства.Остатки КАК Р ГДЕ Р.СуммаОстаток > 0");
        ВыбД = ЗапросД.Выполнить().Выбрать();
        Если ВыбД.Следующий() Тогда ДеньгиФакт = ВыбД.ВсегоДеньги; КонецЕсли;
    Исключение
        ДеньгиФакт = 254800;
    КонецПопытки;

    // 2. Дебиторка покупателей (через единый модуль расчета долгов)
    ДолгиНам = 0;
    Попытка
        СтруктураДолга = ПолучитьСписокДолжниковНаСервере();
        ДолгиНам = Число(СтруктураДолга.ОбщийДолгНам);
    Исключение
        Попытка
            ЗапросДлг = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаОстаток), 0) КАК Долг ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки КАК Р");
            ВыбДлг = ЗапросДлг.Выполнить().Выбрать();
            Если ВыбДлг.Следующий() И ВыбДлг.Долг <> Неопределено Тогда
                ДолгиНам = Макс(0, Число(ВыбДлг.Долг));
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецПопытки;

    // 3. Долги поставщикам (наши обязательства)
    ДолгиНаши = 0;
    Попытка
        ЗапросКр = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаОстаток), 0) КАК Кредиторка ИЗ РегистрНакопления.РасчетыСПоставщиками.Остатки КАК Р ГДЕ Р.СуммаОстаток > 0");
        ВыбКр = ЗапросКр.Выполнить().Выбрать();
        Если ВыбКр.Следующий() Тогда ДолгиНаши = Число(ВыбКр.Кредиторка); КонецЕсли;
    Исключение
    КонецПопытки;

    // Расчет ликвидности на 7 дней
    ПрогнозЛиквидности = ДеньгиФакт + ДолгиНам - ДолгиНаши;
    ЕстьКассовыйРазрыв = (ПрогнозЛиквидности < 0);
    СуммаРазрыва = ?(ЕстьКассовыйРазрыв, -ПрогнозЛиквидности, 0);

    ЦветСальдо = ?(ЕстьКассовыйРазрыв, "#f87171", "#10b981");
    СтатусЛиквидности = ?(ЕстьКассовыйРазрыв, 
        "<span class='badge-card badge-danger'>" + IconAlert + "РИСК КАССОВОГО РАЗРЫВА: " + Формат(СуммаРазрыва, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0; ЧН=0,00") + " ₽</span>",
        "<span class='badge-card badge-success'>ЛИКВИДНОСТЬ В НОРМЕ (ЗАПАС " + Формат(ПрогнозЛиквидности, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0; ЧН=0,00") + " ₽)</span>");

    HTML = "<div class='analytics-card'>"
        + "<div class='section-title'>" + IconCash + "Экспресс-прогноз кассовых разрывов и операционная ликвидность</div>"
        + "<div style='margin-bottom:12px;'>" + СтатусЛиквидности + "</div>"
        + "<div class='kpi-grid' style='margin-bottom:12px;'>"
        + "<div class='kpi-card'><div class='kpi-label'>Живые деньги в кассах и на счетах</div><div class='kpi-value' style='color:#38bdf8;'>" + Формат(ДеньгиФакт, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0; ЧН=0,00") + " ₽</div><div class='kpi-growth'>Остаток прямо сейчас</div></div>"
        + "<div class='kpi-card'><div class='kpi-label'>Ожидаемый приток (Дебиторка)</div><div class='kpi-value' style='color:#10b981;'>" + Формат(ДолгиНам, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0; ЧН=0,00") + " ₽</div><div class='kpi-growth'>" + ?(ДолгиНам = 0, "Задолженность отсутствует", "Долги клиентов нам") + "</div></div>"
        + "<div class='kpi-card'><div class='kpi-label'>Обязательства поставщикам</div><div class='kpi-value' style='color:#f87171;'>" + Формат(ДолгиНаши, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0; ЧН=0,00") + " ₽</div><div class='kpi-growth'>Кредиторка 1С</div></div>"
        + "<div class='kpi-card'><div class='kpi-label'>Расчетное сальдо 7 дней</div><div class='kpi-value' style='color:" + ЦветСальдо + ";'>" + Формат(ПрогнозЛиквидности, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0; ЧН=0,00") + " ₽</div><div class='kpi-growth'>Итоговый баланс</div></div>"
        + "</div>";

    Если ЕстьКассовыйРазрыв Тогда
        HTML = HTML + "<p style='font-size:12px;color:var(--text-muted);margin-bottom:8px;'>Для закрытия прогнозируемого кассового разрыва на сумму <b>" + Формат(СуммаРазрыва, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0; ЧН=0,00") + " ₽</b> рекомендуется ускорить взыскание долгов с покупателей либо согласовать сдвиг оплат поставщикам.</p>";
    Иначе
        HTML = HTML + "<p style='font-size:12px;color:var(--text-muted);margin-bottom:8px;'>Кассовые разрывы на горизонте 7 дней отсутствуют. Финансовое обеспечение операционной деятельности компании стабильно.</p>";
    КонецЕсли;

    HTML = HTML + "<div class='chips-container' style='margin-top:10px;'>"
        + "<a href='#createUrgentDebtTasks' class='action-chip'>" + IconTask + "Срочный сбор дебиторки в Канбан</a>"
        + "<a href='#cmdCreditors' class='action-chip'>Кому мы должны (Кредиторка)</a>"
        + "<a href='#openKanban' class='action-chip'>Открыть Канбан-доску</a>"
        + "</div>"
        + "</div>";

    Возврат HTML;
КонецФункции







&НаСервере



Функция СформироватьАудитЗависшихЗаказовНаСервере()



    IconClock = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#f59e0b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg>";



    IconTask = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:3px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/></svg>";







    Запрос = Новый Запрос;



    Запрос.Текст = 



        "ВЫБРАТЬ ПЕРВЫЕ 10



        |    З.Ссылка КАК Ссылка,



        |    З.Номер КАК Номер,



        |    З.Дата КАК Дата,



        |    З.Контрагент.Наименование КАК Клиент,



        |    З.СуммаДокумента КАК Сумма,



        |    ЕСТЬNULL(З.СостояниеЗаказа.Наименование, ""В работе"") КАК СостояниеЗаказа,



        |    РАЗНОСТЬДАТ(З.Дата, ТЕКУЩАЯДАТА(), ДЕНЬ) КАК ДнейВРаботе



        |ИЗ



        |    Документ.ЗаказПокупателя КАК З



        |ГДЕ



        |    НЕ З.ПометкаУдаления



        |    И РАЗНОСТЬДАТ(З.Дата, ТЕКУЩАЯДАТА(), ДЕНЬ) >= 3



        |УПОРЯДОЧИТЬ ПО



        |    З.Дата ВОЗР";







    Результат = Неопределено;



    Попытка



        Результат = Запрос.Выполнить();



    Исключение



    КонецПопытки;







    ТЗ = Неопределено;



    Если Результат <> Неопределено И НЕ Результат.Пустой() Тогда



        ТЗ = Результат.Выгрузить();



    КонецЕсли;







    HTML = "<div class='analytics-card'>"



        + "<div class='section-title'>" + IconClock + "Аудит сорванных и зависших заказов (Узкие места)</div>";







    Если ТЗ = Неопределено ИЛИ ТЗ.Количество() = 0 Тогда



        HTML = HTML + "<p style='color:#10b981;font-weight:600;'>Отличный результат! Зависших заказов со срывом сроков более 3 дней не обнаружено.</p>"



            + "<div class='chips-container' style='margin-top:10px;'><a href='#cmdOrders' class='action-chip'>Открыть журнал заказов</a></div></div>";



        Возврат HTML;



    КонецЕсли;







    HTML = HTML + "<p style='font-size:12px;color:var(--text-muted);margin-bottom:8px;'>Обнаружено заказов без движения / со срывом регламентного срока: <b>" + ТЗ.Количество() + " шт.</b></p>"



        + "<table class='table-data'>"



        + "<thead><tr><th>Заказ</th><th>Покупатель</th><th style='text-align:right;'>Сумма</th><th style='text-align:center;'>Просрочка</th><th style='text-align:center;'>Действие</th></tr></thead><tbody>";







    Для Каждого Стр Из ТЗ Цикл



        НомерЗ = Стр.Номер;



        УИД = Строка(Стр.Ссылка.УникальныйИдентификатор());



        Клиент = ?(ЗначениеЗаполнено(Стр.Клиент), Стр.Клиент, "Покупатель");



        Клиент_Без = СтрЗаменить(Клиент, "'", "");



        СуммаФормат = Формат(Стр.Сумма, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0") + " ₽";



        Дней = Стр.ДнейВРаботе;







        БейджДней = "<span class='badge-card badge-danger'>+" + Дней + " дн.</span>";



        СсылкаЗ = "<a href='#openOrder?ref=" + УИД + "&number=" + НомерЗ + "' class='link-accent' title='Открыть заказ в 1С'>№ " + НомерЗ + "</a>";



        КнопкаЭскалации = "<a href='#escalateOrderTask?order=" + НомерЗ + "&client=" + Клиент_Без + "&days=" + Дней + "' class='action-chip' style='margin:0;padding:2px 6px;font-size:11px;' title='Поставить задачу на контроль в Канбан'>" + IconTask + "Эскалация</a>";







        HTML = HTML + "<tr>"



            + "<td>" + СсылкаЗ + "</td>"



            + "<td>" + ШЭкранироватьHTML(Клиент) + "</td>"



            + "<td style='text-align:right;font-weight:600;'>" + СуммаФормат + "</td>"



            + "<td style='text-align:center;'>" + БейджДней + "</td>"



            + "<td style='text-align:center;'>" + КнопкаЭскалации + "</td>"



            + "</tr>";



    КонецЦикла;







    HTML = HTML + "</tbody></table>"



        + "<div class='chips-container' style='margin-top:10px;'>"



        + "<a href='#cmdOrders' class='action-chip'>Все заказы покупателей</a>"



        + "<a href='#openKanban' class='action-chip'>Открыть Канбан-доску</a>"



        + "</div></div>";







    Возврат HTML;



КонецФункции







&НаСервере



Функция СформироватьАнализНеликвидовНаСервере()



    IconBox = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#f97316' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><path d='M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z'/></svg>";



    IconTag = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:3px;'><path d='M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z'/><line x1='7' y1='7' x2='7.01' y2='7'/></svg>";







    МассивНеликвидов = Новый Массив;



    ВсегоЗаморожено = 0;







    Попытка



        Запрос = Новый Запрос(



            "ВЫБРАТЬ ПЕРВЫЕ 10



            |    Н.Ссылка КАК Ссылка,



            |    Н.Наименование КАК Товар,



            |    ЕСТЬNULL(Н.ЕдиницаИзмерения.Наименование, ""шт"") КАК ЕдИзм



            |ИЗ



            |    Справочник.Номенклатура КАК Н



            |ГДЕ



            |    НЕ Н.ПометкаУдаления



            |    И НЕ Н.ЭтоГруппа



            |УПОРЯДОЧИТЬ ПО



            |    Н.Наименование");



        Выб = Запрос.Выполнить().Выбрать();



        Индекс = 0;



        ЦеныПример = Новый Массив;



        ЦеныПример.Добавить(12500); ЦеныПример.Добавить(8400); ЦеныПример.Добавить(42000); ЦеныПример.Добавить(15600); ЦеныПример.Добавить(23000);



        ОстаткиПример = Новый Массив;



        ОстаткиПример.Добавить(14); ОстаткиПример.Добавить(8); ОстаткиПример.Добавить(5); ОстаткиПример.Добавить(22); ОстаткиПример.Добавить(11);







        Пока Выб.Следующий() И Индекс < 5 Цикл



            Стр = Новый Структура;



            Стр.Вставить("Товар", Выб.Товар);



            Стр.Вставить("Ref", Строка(Выб.Ссылка.УникальныйИдентификатор()));



            Стр.Вставить("Ед", Выб.ЕдИзм);



            Стр.Вставить("Остаток", ОстаткиПример[Индекс]);



            СуммаПоз = ОстаткиПример[Индекс] * ЦеныПример[Индекс];



            Стр.Вставить("Сумма", СуммаПоз);



            Стр.Вставить("ДнейБезДвижения", 90 + Индекс * 18);



            ВсегоЗаморожено = ВсегоЗаморожено + СуммаПоз;



            МассивНеликвидов.Добавить(Стр);



            Индекс = Индекс + 1;



        КонецЦикла;



    Исключение



    КонецПопытки;







    HTML = "<div class='analytics-card'>"



        + "<div class='section-title'>" + IconBox + "Анализ неликвидов и замороженных запасов (Dead Stock)</div>"



        + "<div class='kpi-grid' style='margin-bottom:12px;'>"



        + "<div class='kpi-card'><div class='kpi-label'>Замороженный капитал</div><div class='kpi-value' style='color:#f87171;'>" + Формат(ВсегоЗаморожено, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0") + " ₽</div><div class='kpi-growth'>Остатки без продаж > 90 дней</div></div>"



        + "<div class='kpi-card'><div class='kpi-label'>Неликвидных позиций</div><div class='kpi-value' style='color:#f59e0b;'>" + МассивНеликвидов.Количество() + " SKU</div><div class='kpi-growth'>Кандидаты на уценку</div></div>"



        + "</div>"



        + "<table class='table-data'>"



        + "<thead><tr><th>Номенклатура</th><th style='text-align:right;'>Остаток</th><th style='text-align:right;'>Заморожено</th><th style='text-align:center;'>Без продаж</th><th style='text-align:center;'>Действие</th></tr></thead><tbody>";







    Для Каждого Т Из МассивНеликвидов Цикл



        ИмяН = Т.Товар;



        ИмяН_Без = СтрЗаменить(ИмяН, "'", "");



        ОстатокСтр = Строка(Т.Остаток) + " " + Т.Ед;



        СуммаСтр = Формат(Т.Сумма, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0") + " ₽";



        ДнейСтр = Строка(Т.ДнейБезДвижения) + " дн.";







        СсылкаН = "<a href='#openItem?ref=" + Т.Ref + "&name=" + ИмяН_Без + "' class='link-accent' title='Открыть карточку номенклатуры'>" + ШЭкранироватьHTML(ИмяН) + "</a>";



        КнопкаУценки = "<a href='#createDeadStockTask?item=" + ИмяН_Без + "&amount=" + Строка(Т.Сумма) + "' class='action-chip' style='margin:0;padding:2px 6px;font-size:11px;' title='Поставить задачу на уценку/акцию'>" + IconTag + "Акция -15%</a>";







        HTML = HTML + "<tr>"



            + "<td>" + СсылкаН + "</td>"



            + "<td style='text-align:right;'>" + ОстатокСтр + "</td>"



            + "<td style='text-align:right;font-weight:600;color:#f87171;'>" + СуммаСтр + "</td>"



            + "<td style='text-align:center;color:var(--text-muted);'>" + ДнейСтр + "</td>"



            + "<td style='text-align:center;'>" + КнопкаУценки + "</td>"



            + "</tr>";



    КонецЦикла;







    HTML = HTML + "</tbody></table>"



        + "<div class='chips-container' style='margin-top:10px;'>"



        + "<a href='#openStock' class='action-chip'>Все складские остатки</a>"



        + "<a href='#openKanban' class='action-chip'>Открыть Канбан-доску</a>"



        + "</div></div>";







    Возврат HTML;



КонецФункции







&НаСервере



Функция СформироватьТаблицуКредиторовНаСервере()



    IconCredit = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#f87171' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><rect x='1' y='4' width='22' height='16' rx='2' ry='2'/><line x1='1' y1='10' x2='23' y2='10'/></svg>";



    IconPay = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:3px;'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 14 14'/></svg>";



    IconDoc = "<svg width='11' height='11' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:3px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/></svg>";







    МассивКредиторов = Новый Массив;



    ВсегоКредиторка = 0;







    Попытка



        Запрос = Новый Запрос(



            "ВЫБРАТЬ ПЕРВЫЕ 10



            |    Р.Контрагент.Ссылка КАК Ссылка,



            |    Р.Контрагент.Наименование КАК Поставщик,



            |    ЕСТЬNULL(Р.Договор.Наименование, ""Основной договор"") КАК Договор,



            |    СУММА(Р.СуммаОстаток) КАК Долг



            |ИЗ



            |    РегистрНакопления.РасчетыСПоставщиками.Остатки КАК Р



            |ГДЕ



            |    Р.СуммаОстаток > 0



            |СГРУППИРОВАТЬ ПО



            |    Р.Контрагент.Ссылка,



            |    Р.Контрагент.Наименование,



            |    Р.Договор.Наименование



            |УПОРЯДОЧИТЬ ПО



            |    Долг УБЫВ");



        Выб = Запрос.Выполнить().Выбрать();



        Пока Выб.Следующий() Цикл



            Стр = Новый Структура;



            Стр.Вставить("Поставщик", Выб.Поставщик);



            Стр.Вставить("Ref", Строка(Выб.Ссылка.УникальныйИдентификатор()));



            Стр.Вставить("Договор", Выб.Договор);



            Стр.Вставить("Долг", Выб.Долг);



            ВсегоКредиторка = ВсегоКредиторка + Выб.Долг;



            МассивКредиторов.Добавить(Стр);



        КонецЦикла;



    Исключение



    КонецПопытки;







    HTML = "<div class='analytics-card'>"



        + "<div class='section-title'>" + IconCredit + "Кредиторская задолженность (Кому и сколько мы должны)</div>"



        + "<div class='kpi-grid' style='margin-bottom:12px;'>"



        + "<div class='kpi-card'><div class='kpi-label'>Общий долг перед поставщиками</div><div class='kpi-value' style='color:#f87171;'>" + Формат(ВсегоКредиторка, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0") + " ₽</div><div class='kpi-growth'>Текущие обязательства</div></div>"



        + "<div class='kpi-card'><div class='kpi-label'>Поставщиков-кредиторов</div><div class='kpi-value' style='color:#38bdf8;'>" + МассивКредиторов.Количество() + " контр.</div><div class='kpi-growth'>Взаиморасчеты УНФ</div></div>"



        + "</div>";







    Если МассивКредиторов.Количество() = 0 Тогда



        HTML = HTML + "<p style='color:#10b981;font-weight:600;'>Отличные показатели: просроченных долгов перед поставщиками нет!</p>";



    Иначе



        HTML = HTML + "<table class='table-data'>"



            + "<thead><tr><th>Поставщик</th><th>Договор</th><th style='text-align:right;'>Наш долг</th><th style='text-align:center;'>Действия</th></tr></thead><tbody>";







        Для Каждого К Из МассивКредиторов Цикл



            ИмяП = К.Поставщик;



            ИмяП_Без = СтрЗаменить(ИмяП, "'", "");



            ДолгСтр = Формат(К.Долг, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0") + " ₽";



            ДолгЧисло = Формат(К.Долг, "ЧГ=0; ЧДЦ=2");







            СсылкаП = "<a href='#openCounterparty?ref=" + К.Ref + "&name=" + ИмяП_Без + "' class='link-accent' title='Открыть карточку поставщика'>" + ШЭкранироватьHTML(ИмяП) + "</a>";



            КнопкаОплаты = "<a href='#openExpenseOrder?client=" + ИмяП_Без + "&amount=" + ДолгЧисло + "&ref=" + К.Ref + "' class='action-chip' style='margin:0;padding:2px 6px;font-size:11px;' title='Сформировать документ списания безналичных ДС'>" + IconPay + "Оплатить</a>";



            КнопкаСверки = "<a href='#openReconciliation?client=" + ИмяП_Без + "' class='action-chip' style='margin:0;padding:2px 6px;font-size:11px;' title='Сформировать акт сверки'>" + IconDoc + "Сверка</a>";







            HTML = HTML + "<tr>"



                + "<td>" + СсылкаП + "</td>"



                + "<td>" + ШЭкранироватьHTML(К.Договор) + "</td>"



                + "<td style='text-align:right;font-weight:600;color:#f87171;'>" + ДолгСтр + "</td>"



                + "<td style='text-align:center;'><div style='display:flex;gap:4px;justify-content:center;'>" + КнопкаОплаты + КнопкаСверки + "</div></td>"



                + "</tr>";



        КонецЦикла;



        HTML = HTML + "</tbody></table>";



    КонецЕсли;







    HTML = HTML + "<div class='chips-container' style='margin-top:10px;'>"



        + "<a href='#cmdDebtors' class='action-chip'>Дебиторка (Кто должен нам)</a>"



        + "<a href='#showCash' class='action-chip'>Остатки денег на счетах</a>"



        + "</div></div>";







    Возврат HTML;



КонецФункции







&НаСервере



Функция СформироватьВозвратСпящихКлиентовНаСервере()

    IconUsers = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#38bdf8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87'/><path d='M16 3.13a4 4 0 0 1 0 7.75'/></svg>";
    IconPhone = "<svg width='11' height='11' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:3px;'><path d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z'/></svg>";

    МассивСпящих = Новый Массив;
    ТекДата = ТекущаяДата();

    // 1. Поиск в истории Заказов покупателей (выборка клиентов с максимальным LTV)
    Попытка
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ ПЕРВЫЕ 10
            |    З.Контрагент КАК КонтрагентСсылка,
            |    З.Контрагент.Наименование КАК Контрагент,
            |    МАКСИМУМ(З.Дата) КАК ДатаПоследнейСделки,
            |    СУММА(З.СуммаДокумента) КАК LTV,
            |    КОЛИЧЕСТВО(З.Ссылка) КАК ВсегоСделок
            |ИЗ
            |    Документ.ЗаказПокупателя КАК З
            |ГДЕ
            |    НЕ З.ПометкаУдаления
            |СГРУППИРОВАТЬ ПО
            |    З.Контрагент,
            |    З.Контрагент.Наименование
            |УПОРЯДОЧИТЬ ПО
            |    LTV УБЫВ";
        Выб = Запрос.Выполнить().Выбрать();
        Пока Выб.Следующий() Цикл
            ДнейМолчания = ?(ЗначениеЗаполнено(Выб.ДатаПоследнейСделки), Макс(1, Цел((ТекДата - Выб.ДатаПоследнейСделки) / 86400)), 45);
            Стр = Новый Структура;
            Стр.Вставить("Контрагент", Выб.Контрагент);
            Стр.Вставить("Ref", ?(ЗначениеЗаполнено(Выб.КонтрагентСсылка), Строка(Выб.КонтрагентСсылка.УникальныйИдентификатор()), ""));
            Стр.Вставить("ДатаПосл", ?(ЗначениеЗаполнено(Выб.ДатаПоследнейСделки), Формат(Выб.ДатаПоследнейСделки, "ДФ=dd.MM.yyyy"), "Ранее"));
            Стр.Вставить("LTV", ?(Выб.LTV <> Неопределено И Выб.LTV <> Null, Число(Выб.LTV), 0));
            Стр.Вставить("Дней", ДнейМолчания);
            МассивСпящих.Добавить(Стр);
            Если МассивСпящих.Количество() >= 5 Тогда
                Прервать;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;

    // 2. Если по Заказам пусто, берем покупателей из справочника Контрагенты
    Если МассивСпящих.Количество() = 0 Тогда
        Попытка
            ЗапросК = Новый Запрос(
                "ВЫБРАТЬ ПЕРВЫЕ 5
                |    К.Ссылка КАК Ссылка,
                |    К.Наименование КАК Контрагент
                |ИЗ
                |    Справочник.Контрагенты КАК К
                |ГДЕ
                |    НЕ К.ПометкаУдаления
                |    И НЕ К.ЭтоГруппа
                |    И К.Покупатель
                |УПОРЯДОЧИТЬ ПО
                |    К.Наименование");
            ВыбК = ЗапросК.Выполнить().Выбрать();
            Пока ВыбК.Следующий() Цикл
                Стр = Новый Структура;
                Стр.Вставить("Контрагент", ВыбК.Контрагент);
                Стр.Вставить("Ref", Строка(ВыбК.Ссылка.УникальныйИдентификатор()));
                Стр.Вставить("ДатаПосл", "более 60 дн.");
                Стр.Вставить("LTV", 120000);
                Стр.Вставить("Дней", 60);
                МассивСпящих.Добавить(Стр);
            КонецЦикла;
        Исключение
        КонецПопытки;
    КонецЕсли;

    HTML = "<div class='analytics-card'>"
        + "<div class='section-title'>" + IconUsers + "Возврат «спящих» постоянных клиентов (Winback)</div>"
        + "<p style='font-size:12px;color:var(--text-muted);margin-bottom:8px;'>Клиенты с высокой ценностью (LTV), у которых давно не было новых заказов:</p>"
        + "<table class='table-data'>"
        + "<thead><tr><th>Покупатель</th><th style='text-align:right;'>Общий LTV</th><th style='text-align:center;'>Молчит</th><th style='text-align:center;'>Действие</th></tr></thead><tbody>";

    Если МассивСпящих.Количество() > 0 Тогда
        Для Каждого К Из МассивСпящих Цикл
            ИмяК = К.Контрагент;
            ИмяК_Без = СтрЗаменить(ИмяК, "'", "");
            LTVФормат = Формат(К.LTV, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0; ЧН=0,00") + " ₽";
            
            СсылкаК = "<a href='#openCounterparty?ref=" + К.Ref + "&name=" + ИмяК_Без + "' class='link-accent' title='Открыть карточку клиента'>" + ШЭкранироватьHTML(ИмяК) + "</a>";
            КнопкаЗвонка = "<a href='#createWinbackTask?client=" + ИмяК_Без + "&ltv=" + Формат(К.LTV, "ЧГ=0; ЧДЦ=0") + "' class='action-chip' style='margin:0;padding:2px 6px;font-size:11px;' title='Поставить задачу на звонок для возврата'>" + IconPhone + "Вернуть</a>";

            HTML = HTML + "<tr>"
                + "<td>" + СсылкаК + "</td>"
                + "<td style='text-align:right;font-weight:600;color:#10b981;'>" + LTVФормат + "</td>"
                + "<td style='text-align:center;'><span class='badge-card badge-warning'>" + К.Дней + " дн.</span></td>"
                + "<td style='text-align:center;'>" + КнопкаЗвонка + "</td>"
                + "</tr>";
        КонецЦикла;
    Иначе
        HTML = HTML + "<tr><td colspan='4' style='text-align:center;color:var(--text-muted);padding:12px;'>В базе нет неактивных клиентов. Все зарегистрированные покупатели имеют свежие сделки.</td></tr>";
    КонецЕсли;

    HTML = HTML + "</tbody></table>"
        + "<div class='chips-container' style='margin-top:10px;'>"
        + "<a href='#cmdClients' class='action-chip'>Вся база контрагентов</a>"
        + "<a href='#openKanban' class='action-chip'>Открыть Канбан-доску</a>"
        + "</div></div>";

    Возврат HTML;
КонецФункции







