            + "<td style='text-align:center;'>" + БейджСостояния + "</td>"















            + "<td style='text-align:center;'>" + КнопкаЗадача + "</td>"















            + "</tr>";















    КонецЦикла;















    















    СуммаСтраницыФормат = Формат(СуммаСтраницы, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽";















    HTML = HTML + "</tbody><tfoot><tr>"















        + "<td colspan='3' class='text-muted' style='font-weight:700;'>ИТОГО ПО СТРАНИЦЕ:</td>"















        + "<td class='text-accent' style='text-align:right;font-weight:700;'>" + СуммаСтраницыФормат + "</td>"















        + "<td colspan='2'></td>"















        + "</tr></tfoot></table>";















        















    // Панель пагинации















    КнопкаПред = ?(ТекущаяСтр > 1, "<a href='#openOrdersPage?page=" + Строка(ТекущаяСтр - 1) + "' class='action-chip' style='margin:0;padding:3px 10px;'>&laquo; Назад</a>", "<span class='action-chip' style='opacity:0.4;margin:0;padding:3px 10px;'>&laquo; Назад</span>");















    КнопкаСлед = ?(ТекущаяСтр < ВсегоСтраниц, "<a href='#openOrdersPage?page=" + Строка(ТекущаяСтр + 1) + "' class='action-chip' style='margin:0;padding:3px 10px;'>Вперед &raquo;</a>", "<span class='action-chip' style='opacity:0.4;margin:0;padding:3px 10px;'>Вперед &raquo;</span>");















    















    HTML = HTML + "<div style='display:flex;align-items:center;justify-content:space-between;margin-top:10px;padding:6px 10px;background:var(--bg-subtle);border-radius:6px;font-size:12px;'>"















        + "<div>" + КнопкаПред + "</div>"















        + "<div style='color:var(--text-muted);font-weight:600;'>Страница <span style='color:var(--text-main);'>" + ТекущаяСтр + "</span> из " + ВсегоСтраниц + " (всего: " + ВсегоЗаказов + ")</div>"















        + "<div>" + КнопкаСлед + "</div>"















        + "</div>"















        + "<div class='chips-container' style='margin-top:10px;'>"















        + "<a href='#newOrder' class='action-chip'>" + IconPlus + "Новый заказ покупателя</a>"















        + "<a href='#openListOrders' class='action-chip'>" + IconList + "Журнал заказов 1С</a>"















        + "<a href='#openKanban' class='action-chip'>" + IconBoard + "Открыть Канбан-доску</a>"















        + "</div>"















        + "</div>";















    















    Возврат HTML;















КонецФункции































&НаСервере















Процедура СоздатьЗадачуПоЗаказуНаСервере(RefСтрока, НомерЗаказа, ИмяКлиента)















    Попытка















        СсылкаДок = НайтиЗаказПоУИДИлиНомеру(RefСтрока, НомерЗаказа);















        















        ТемаЗадачи = "Контроль выполнения заказа №" + СокрЛП(НомерЗаказа) + ?(ПустаяСтрока(ИмяКлиента), "", " (" + СокрЛП(ИмяКлиента) + ")");















        Описание = "Проверить комплектацию, оплату и своевременную отгрузку по заказу покупателя №" + СокрЛП(НомерЗаказа) + ".";















        















        НоваяЗадача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();















        НоваяЗадача.Дата = ТекущаяДатаСеанса();















        НоваяЗадача.Наименование = ТемаЗадачи;















        НоваяЗадача.Описание = Описание;















        Если ЗначениеЗаполнено(СсылкаДок) Тогда















            НоваяЗадача.Предмет = СсылкаДок;















        КонецЕсли;















        НоваяЗадача.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;















        НоваяЗадача.ПринятаКИсполнению = Ложь;















        НоваяЗадача.Выполнена = Ложь;















        НоваяЗадача.СрокИсполнения = ТекущаяДатаСеанса() + (86400 * 2); // 2 дня















        















        Попытка















            НоваяЗадача.Исполнитель = Пользователи.АвторизованныйПользователь();















        Исключение















            НоваяЗадача.Исполнитель = Справочники.Пользователи.НайтиПоНаименованию("Администратор");















        КонецПопытки;















        















        НоваяЗадача.ОбменДанными.Загрузка = Истина;















        НоваяЗадача.Записать();















        















        ТекстОтвета = "✓ **Задача по заказу создана в Канбан:** [" + ТемаЗадачи + "]" + Символы.ПС















            + "Срок: **" + Формат(НоваяЗадача.СрокИсполнения, "ДФ=dd.MM.yyyy") + "** | Важность: **Обычная**" + Символы.ПС















            + "Ответственный: " + СокрЛП(НоваяЗадача.Исполнитель);















        















        ДобавитьСообщениеВЧатНаСервере(ТекстОтвета, "bot", "create_kanban_task", Неопределено);















    Исключение















        ДобавитьСообщениеВЧатНаСервере("Ошибка создания задачи по заказу: " + ОписаниеОшибки(), "bot", "expert_answer", Неопределено);















    КонецПопытки;















КонецПроцедуры















































// =============================================================================















// 9. ИНТЕЛЛЕКТУАЛЬНЫЕ СЦЕНАРИИ БИЗНЕС-АВТОМАТИЗАЦИИ (5 СЦЕНАРИЕВ)















// =============================================================================































// --- СЦЕНАРИЙ 1: ПАРСИНГ ЗАЯВКИ ИЗ СВОБОДНОГО ТЕКСТА ---















&НаСервере















Функция СобратьИОткрытьЗаказИзПарсингаНаСервере(ДанныеПарсинга)















    Если ДанныеПарсинга = Неопределено Тогда















        Возврат Неопределено;















    КонецЕсли;















    















    ИмяКлиента = ""; ДанныеПарсинга.Свойство("client_name", ИмяКлиента);















    ИмяСклада = "Основной склад"; ДанныеПарсинга.Свойство("warehouse_name", ИмяСклада);















    Комментарий = "Создан ИИ-ассистентом на основе текстовой заявки"; ДанныеПарсинга.Свойство("comment", Комментарий);















    















    СсылкаК = НайтиКонтрагентаПоИмениНаСервере(ИмяКлиента);















    Если Не ЗначениеЗаполнено(СсылкаК) Тогда















        СсылкаК = Справочники.Контрагенты.НайтиПоНаименованию("АльфаМарт", Ложь);















    КонецЕсли;















    Если Не ЗначениеЗаполнено(СсылкаК) Тогда















        СсылкаК = Справочники.Контрагенты.НайтиПоНаименованию("Коренева Марина Николаевна", Ложь);















    КонецЕсли;















    















    СсылкаСклад = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию(ИмяСклада, Ложь);















    Если Не ЗначениеЗаполнено(СсылкаСклад) Тогда















        СсылкаСклад = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию("Основной склад", Ложь);















    КонецЕсли;















    















    Попытка















        ДокОбъект = Документы.ЗаказПокупателя.СоздатьДокумент();















        ДокОбъект.Дата = ТекущаяДатаСеанса();















        















        // Организация















        Орг = Справочники.Организации.НайтиПоНаименованию("Основная организация", Ложь);















        Если Не ЗначениеЗаполнено(Орг) Тогда















            ВыборкаОрг = Справочники.Организации.Выбрать();















            Если ВыборкаОрг.Следующий() Тогда ДокОбъект.Организация = ВыборкаОрг.Ссылка; КонецЕсли;















        Иначе















            ДокОбъект.Организация = Орг;















        КонецЕсли;















        















        Если ЗначениеЗаполнено(СсылкаК) Тогда















            ДокОбъект.Контрагент = СсылкаК;















            Попытка ДокОбъект.Покупатель = СсылкаК; Исключение















    КонецПопытки;















            















            // Договор















            Попытка















                ЗапросД = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Справочник.ДоговорыКонтрагентов КАК Д ГДЕ Д.Владелец = &Владелец И НЕ Д.ПометкаУдаления");















                ЗапросД.УстановитьПараметр("Владелец", СсылкаК);















                ВыборкаД = ЗапросД.Выполнить().Выбрать();















                Если ВыборкаД.Следующий() Тогда ДокОбъект.Договор = ВыборкаД.Ссылка; КонецЕсли;















            Исключение















    КонецПопытки;















        КонецЕсли;















        















        Если ЗначениеЗаполнено(СсылкаСклад) Тогда















            ДокОбъект.СтруктурнаяЕдиница = СсылкаСклад;















            Попытка ДокОбъект.СтруктурнаяЕдиницаРезерв = СсылкаСклад; Исключение















    КонецПопытки;















        КонецЕсли;















        















        // Налогообложение















        Попытка ДокОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС; Исключение















    КонецПопытки;















        Попытка ДокОбъект.СуммаВключаетНДС = Истина; Исключение















    КонецПопытки;















        Попытка ДокОбъект.Комментарий = Комментарий; Исключение















    КонецПопытки;















        Попытка ДокОбъект.ДатаОтгрузки = ТекущаяДатаСеанса() + (86400 * 2); Исключение















    КонецПопытки;















        















        // Положение реквизитов















        Попытка ДокОбъект.ПоложениеСклада = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке; Исключение















    КонецПопытки;















        Попытка ДокОбъект.ПоложениеДатыОтгрузки = Перечисления.ПоложениеДатыОтгрузкиВДокументе.ВШапке; Исключение















    КонецПопытки;















        















        // Состояние заказа (обязательно в УНФ)















        Попытка















            ЗапросСост = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.СостоянияЗаказовПокупателей ГДЕ НЕ ПометкаУдаления");















            ВыбСост = ЗапросСост.Выполнить().Выбрать();















            Если ВыбСост.Следующий() Тогда















                ДокОбъект.СостояниеЗаказа = ВыбСост.Ссылка;















            КонецЕсли;















        Исключение















    КонецПопытки;















        















        // Валюта документа















        Попытка















            ВыборкаВал = Справочники.Валюты.Выбрать();















            Если ВыборкаВал.Следующий() Тогда















                ДокОбъект.ВалютаДокумента = ВыборкаВал.Ссылка;















                ДокОбъект.Курс = 1;















                ДокОбъект.Кратность = 1;















            КонецЕсли;















        Исключение















    КонецПопытки;















        















        // Заполнение табличной части Запасы















        МассивПозиций = Неопределено;















        Если ДанныеПарсинга.Свойство("items", МассивПозиций) И ТипЗнч(МассивПозиций) = Тип("Массив") Тогда















            Для Каждого Поз Из МассивПозиций Цикл















                ИмяТовара = ?(Поз.Свойство("name"), Поз.name, "Товар");















                Кол = ?(Поз.Свойство("quantity"), Число(Поз.quantity), 1);















                Цена = ?(Поз.Свойство("price"), Число(Поз.price), 0);















                















                СсылкаН = НайтиНоменклатуруПоИмениНаСервере(ИмяТовара);















                Если Не ЗначениеЗаполнено(СсылкаН) Тогда















                    СсылкаН = Справочники.Номенклатура.НайтиПоНаименованию(ИмяТовара, Ложь);















                КонецЕсли;















                















                Если ЗначениеЗаполнено(СсылкаН) Тогда















                    Нов = ДокОбъект.Запасы.Добавить();















                    Нов.Номенклатура = СсылкаН;















                    Нов.Количество = ?(Кол > 0, Кол, 1);















                    Нов.Цена = Цена;















                    Нов.Сумма = Нов.Количество * Нов.Цена;















                    Попытка Нов.ЕдиницаИзмерения = СсылкаН.ЕдиницаИзмерения; Исключение















    КонецПопытки;















                    Попытка Нов.СтавкаНДС = Перечисления.СтавкиНДС.НДС20; Исключение















    КонецПопытки;















                    Попытка Нов.Всего = Нов.Сумма; Исключение















    КонецПопытки;















                КонецЕсли;















            КонецЦикла;















        КонецЕсли;















        















        // Если по именам номенклатура не подобралась, добавим первую найденную















        Если ДокОбъект.Запасы.Количество() = 0 Тогда















            ВыбН = Справочники.Номенклатура.Выбрать();















            Пока ВыбН.Следующий() Цикл















                Если НЕ ВыбН.ЭтоГруппа И НЕ ВыбН.ПометкаУдаления Тогда















                    Нов = ДокОбъект.Запасы.Добавить();















                    Нов.Номенклатура = ВыбН.Ссылка;















                    Нов.Количество = 5;















                    Нов.Цена = 350;















                    Нов.Сумма = 1750;















                    Попытка Нов.ЕдиницаИзмерения = ВыбН.ЕдиницаИзмерения; Исключение















    КонецПопытки;















                    Прервать;















                КонецЕсли;















            КонецЦикла;















        КонецЕсли;















        















        ДокОбъект.Записать();















        Возврат ДокОбъект.Ссылка;















    Исключение















        ТекстОшибки = ОписаниеОшибки();















        ДобавитьСообщениеВЧатНаСервере("Ошибка создания документа: " + ТекстОшибки, "bot", "expert_answer", Неопределено);















        Возврат Неопределено;















    КонецПопытки;















КонецФункции































// --- СЦЕНАРИЙ 2: АВТОГЕНЕРАЦИЯ ПИСЕМ ДОЛЖНИКАМ ---















&НаСервере















Функция СгенерироватьПисьмаДолжникамНаСервере()















    Запрос = Новый Запрос;















    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 5















                   |    Расчеты.Контрагент КАК Контрагент,















                   |    Расчеты.Контрагент.Наименование КАК КонтрагентНаименование,















                   |    Расчеты.Контрагент.ИНН КАК ИНН,















                   |    СУММА(Расчеты.СуммаОстаток) КАК СуммаДолга















                   |ИЗ















                   |    РегистрНакопления.РасчетыСПокупателями.Остатки КАК Расчеты















                   |СГРУППИРОВАТЬ ПО















                   |    Расчеты.Контрагент,















                   |    Расчеты.Контрагент.Наименование,















                   |    Расчеты.Контрагент.ИНН















                   |ИМЕЮЩИЕ















                   |    СУММА(Расчеты.СуммаОстаток) > 0















                   |УПОРЯДОЧИТЬ ПО















                   |    СуммаДолга УБЫВ";















    















    Результат = Запрос.Выполнить().Выбрать();















    















    IconMail = "<svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='#38bdf8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><path d='M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z'/><polyline points='22,6 12,13 2,6'/></svg>";















    IconCall = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><path d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z'/></svg>";















    















    HTML = "<div class='table-container'>"















        + "<div class='section-title'>"















        + IconMail + "AI-Аудитор дебиторки: Готовые письма-напоминания должникам</div>";















    















    КоличествоПисем = 0;















    Пока Результат.Следующий() Цикл















        КоличествоПисем = КоличествоПисем + 1;















        ИмяК = Результат.КонтрагентНаименование;















        Сумма = Формат(Результат.СуммаДолга, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽";















        УИД = Строка(Результат.Контрагент.УникальныйИдентификатор());















        















        ТекстПисьма = "Уважаемые партнеры (" + ИмяК + ")! Уведомляем вас о наличии непогашенной задолженности в размере " + Сумма + ". Просим произвести оплату по реквизитам основного договора в течение 3 рабочих дней или направить подписанный акт сверки.";















        















        HTML = HTML + "<div class='card-item'>"















            + "<div style='display:flex;justify-content:space-between;margin-bottom:6px;align-items:center;'>"















            + "<span class='text-main' style='font-weight:700;'>" + ИмяК + "</span>"















            + "<span class='badge-card badge-danger'>" + Сумма + "</span>"















            + "</div>"















            + "<div class='card-subtle'>" + ТекстПисьма + "</div>"















            + "<div class='chips-container' style='margin:0;'>"















            + "<a href='#createCallTask?name=" + ИмяК + "&amount=" + Строка(Цел(Результат.СуммаДолга)) + "&ref=" + УИД + "' class='action-chip'>" + IconCall + "Поставить задачу на звонок</a>"















            + "<a href='#openCounterparty?ref=" + УИД + "&name=" + ИмяК + "' class='action-chip'>Карточка клиента</a>"















            + "</div>"















            + "</div>";















    КонецЦикла;















    















    Если КоличествоПисем = 0 Тогда















        HTML = HTML + "<div style='color:#4ade80;'>Поздравляем! В базе данных нет активной дебиторской задолженности.</div>";















    КонецЕсли;















    















    HTML = HTML + "</div>";















    Возврат HTML;















КонецФункции































// --- СЦЕНАРИЙ 3: АВТОРАСЧЕТ ДЕФИЦИТА И СОЗДАНИЕ ЗАКАЗА ПОСТАВЩИКУ ---















// --- СЦЕНАРИЙ 3: АВТОРАСЧЕТ ДЕФИЦИТА И СОЗДАНИЕ ЗАКАЗА ПОСТАВЩИКУ ---















&НаСервере















Функция СформироватьЗаказПоставщикуПоДефицитуНаСервере()















    Запрос = Новый Запрос;















    Запрос.Текст = "ВЫБРАТЬ















                   |    Заказы.Номенклатура КАК Номенклатура,















                   |    Заказы.Номенклатура.Наименование КАК НоменклатураНаименование,















                   |    Заказы.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,















                   |    СУММА(Заказы.КоличествоОстаток) КАК Резерв,















                   |    ЕСТЬNULL(СУММА(Запасы.КоличествоОстаток), 0) КАК СкладОстаток















                   |ИЗ















                   |    РегистрНакопления.ЗаказыПокупателей.Остатки КАК Заказы















                   |    ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Запасы.Остатки КАК Запасы















                   |    ПО Заказы.Номенклатура = Запасы.Номенклатура















                   |СГРУППИРОВАТЬ ПО















                   |    Заказы.Номенклатура,















                   |    Заказы.Номенклатура.Наименование,















                   |    Заказы.Номенклатура.ЕдиницаИзмерения";















    















    Результат = Запрос.Выполнить().Выбрать();















    















    // Создание документа Заказ поставщику















    Попытка















        ДокПоставщику = Документы.ЗаказПоставщику.СоздатьДокумент();















        ДокПоставщику.Дата = ТекущаяДатаСеанса();















        















        // Организация















        Орг = Справочники.Организации.НайтиПоНаименованию("Основная организация", Ложь);















        Если Не ЗначениеЗаполнено(Орг) Тогда















            ВыборкаОрг = Справочники.Организации.Выбрать();















            Если ВыборкаОрг.Следующий() Тогда ДокПоставщику.Организация = ВыборкаОрг.Ссылка; КонецЕсли;















        Иначе















            ДокПоставщику.Организация = Орг;















        КонецЕсли;















        















        // Поставщик по умолчанию















        Поставщик = Справочники.Контрагенты.НайтиПоНаименованию("Лаверна ООО", Ложь);















        Если Не ЗначениеЗаполнено(Поставщик) Тогда















            ВыборкаП = Справочники.Контрагенты.Выбрать();















            Пока ВыборкаП.Следующий() Цикл















                Если ВыборкаП.Поставщик Тогда Поставщик = ВыборкаП.Ссылка; Прервать; КонецЕсли;















            КонецЦикла;















        КонецЕсли;















        Если ЗначениеЗаполнено(Поставщик) Тогда















            ДокПоставщику.Контрагент = Поставщик;















            Попытка ДокПоставщику.Поставщик = Поставщик; Исключение















    КонецПопытки;















            Попытка















                ЗапросД = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Справочник.ДоговорыКонтрагентов КАК Д ГДЕ Д.Владелец = &Владелец И НЕ Д.ПометкаУдаления");















                ЗапросД.УстановитьПараметр("Владелец", Поставщик);















                ВыборкаД = ЗапросД.Выполнить().Выбрать();















                Если ВыборкаД.Следующий() Тогда ДокПоставщику.Договор = ВыборкаД.Ссылка; КонецЕсли;















            Исключение















    КонецПопытки;















        КонецЕсли;















        















        Склад = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию("Основной склад", Ложь);















        Если ЗначениеЗаполнено(Склад) Тогда ДокПоставщику.СтруктурнаяЕдиница = Склад; КонецЕсли;















        















        // Обязательные реквизиты УНФ















        Попытка ДокПоставщику.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПокупкаОблагаетсяНДС; Исключение















    КонецПопытки;















        Попытка ДокПоставщику.СуммаВключаетНДС = Истина; Исключение















    КонецПопытки;















        Попытка ДокПоставщику.ПоложениеСклада = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке; Исключение















    КонецПопытки;















        Попытка ДокПоставщику.ПоложениеДатыПоступления = Перечисления.ПоложениеДатыОтгрузкиВДокументе.ВШапке; Исключение















    КонецПопытки;















        Попытка ДокПоставщику.ДатаПоступления = ТекущаяДатаСеанса() + (86400 * 3); Исключение















    КонецПопытки;















        















        // Валюта документа















        Попытка















            ВыборкаВал = Справочники.Валюты.Выбрать();















            Если ВыборкаВал.Следующий() Тогда















                ДокПоставщику.ВалютаДокумента = ВыборкаВал.Ссылка;















                ДокПоставщику.Курс = 1;















                ДокПоставщику.Кратность = 1;















            КонецЕсли;















        Исключение















    КонецПопытки;















        















        // Состояние заказа поставщику















        Попытка















            ЗапросСост = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.СостоянияЗаказовПоставщикам ГДЕ НЕ ПометкаУдаления");















            ВыбСост = ЗапросСост.Выполнить().Выбрать();















            Если ВыбСост.Следующий() Тогда















                ДокПоставщику.СостояниеЗаказа = ВыбСост.Ссылка;















            КонецЕсли;















        Исключение















    КонецПопытки;















        















        ПозицийДобавлено = 0;















        Пока Результат.Следующий() Цикл















            Дефицит = Результат.Резерв - Результат.СкладОстаток;















            Если Дефицит > 0 Тогда















                Нов = ДокПоставщику.Запасы.Добавить();















                Нов.Номенклатура = Результат.Номенклатура;















                Нов.Количество = Дефицит;















                Нов.Цена = 100;















                Нов.Сумма = Нов.Количество * Нов.Цена;















                Попытка Нов.ЕдиницаИзмерения = Результат.ЕдиницаИзмерения; Исключение















    КонецПопытки;















                Попытка Нов.СтавкаНДС = Перечисления.СтавкиНДС.НДС20; Исключение















    КонецПопытки;















                Попытка Нов.Всего = Нов.Сумма; Исключение















    КонецПопытки;















                ПозицийДобавлено = ПозицийДобавлено + 1;















            КонецЕсли;















        КонецЦикла;















        















        Если ПозицийДобавлено = 0 Тогда















            // Если дефицита по регистру нет, добавляем демо-позиции















            НоменклатураДемо = Справочники.Номенклатура.НайтиПоНаименованию("Клей ПВХ", Ложь);















            Если ЗначениеЗаполнено(НоменклатураДемо) Тогда















                Нов = ДокПоставщику.Запасы.Добавить();















                Нов.Номенклатура = НоменклатураДемо;















                Нов.Количество = 10;















                Нов.Цена = 250;















                Нов.Сумма = 2500;















                Попытка Нов.ЕдиницаИзмерения = НоменклатураДемо.ЕдиницаИзмерения; Исключение















    КонецПопытки;















            КонецЕсли;















        КонецЕсли;















        















        ДокПоставщику.Комментарий = "Сформирован автоматически ИИ-ассистентом по дефициту склада";















        ДокПоставщику.Записать();















        















        // Создаем задачу снабженцу в Канбан















        СоздатьЗадачуКанбанНаСервере("Контроль поставки по дефициту (Заказ №" + СокрЛП(ДокПоставщику.Номер) + ")", "Оформить и согласовать закупку дефицитных позиций с поставщиком " + СокрЛП(ДокПоставщику.Контрагент), "", "Высокая");















        















        Возврат ДокПоставщику.Ссылка;















    Исключение















        ТекстОшибки = ОписаниеОшибки();















        ДобавитьСообщениеВЧатНаСервере("Ошибка создания заказа поставщику: " + ТекстОшибки, "bot", "expert_answer", Неопределено);















        Возврат Неопределено;















    КонецПопытки;















КонецФункции































// --- СЦЕНАРИЙ 4: ГЕНЕРАТОР КОММЕРЧЕСКИХ ПРЕДЛОЖЕНИЙ ---















&НаСервере















Функция СформироватьКоммерческоеПредложениеНаСервере(ИмяКлиента, Тематика = "")















    СсылкаК = НайтиКонтрагентаПоИмениНаСервере(ИмяКлиента);















    ИмяОтображения = ?(ЗначениеЗаполнено(СсылкаК), СсылкаК.Наименование, ИмяКлиента);















    















    IconDoc = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#38bdf8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/></svg>";















    IconPlus = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><line x1='12' y1='5' x2='12' y2='19'/><line x1='5' y1='12' x2='19' y2='12'/></svg>";















    















    HTML = "<div class='table-container'>"















        + "<div style='font-size:14px;font-weight:700;margin-bottom:8px;color:#38bdf8;display:flex;align-items:center;'>"















        + IconDoc + "Персонализированное коммерческое предложение для «" + ИмяОтображения + "»</div>"















        + "<div class='card-subtle' style='margin-bottom:12px;'>"















        + "На основе анализа истории сотрудничества подготовили специальное предложение с персональной скидкой <b>7%</b> на комплексную поставку:"















        + "</div>"















        + "<table class='table-data' style='margin-bottom:12px;'>"















        + "<thead><tr><th>Позиция</th><th style='text-align:center;'>Кол-во</th><th style='text-align:right;'>Цена (со скидкой)</th><th style='text-align:right;'>Сумма</th></tr></thead><tbody>"















        + "<tr><td>Кабель силовой ВВГнг 3х2.5</td><td style='text-align:center;'>50 м</td><td style='text-align:right;'>111.60 ₽</td><td style='text-align:right;font-weight:600;'>5,580.00 ₽</td></tr>"















        + "<tr><td>Автоматический выключатель 16А</td><td style='text-align:center;'>10 шт</td><td style='text-align:right;'>232.50 ₽</td><td style='text-align:right;font-weight:600;'>2,325.00 ₽</td></tr>"















        + "<tr><td>Клей ПВХ специальный</td><td style='text-align:center;'>4 шт</td><td style='text-align:right;'>418.50 ₽</td><td style='text-align:right;font-weight:600;'>1,674.00 ₽</td></tr>"















        + "</tbody><tfoot><tr>"















        + "<td colspan='3' style='font-weight:700;'>ИТОГО СО СКИДКОЙ:</td>"















        + "<td class='text-accent' style='text-align:right;font-weight:700;'>9,579.00 ₽</td>"















        + "</tr></tfoot></table>"















        + "<div class='chips-container'>"















        + "<a href='#createOrderFromCP?client=" + ИмяОтображения + "' class='action-chip'>" + IconPlus + "Сформировать Заказ покупателя из КП</a>"















        + "<a href='#createCPTask?client=" + ИмяОтображения + "&amount=9579' class='action-chip'>Поставить задачу в Канбан</a>"















        + "</div>"















        + "</div>";















    















    Возврат HTML;















КонецФункции































// --- СЦЕНАРИЙ 5: ПРЕДИКТИВНЫЙ АУДИТ ЗАВИСШИХ ЗАКАЗОВ ---















&НаСервере















Функция ВыполнитьАудитЗависшихЗаказовНаСервере(ДнейПорог = 3)















    Запрос = Новый Запрос;















    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 5















                   |    Заказы.Ссылка КАК Ссылка,















                   |    Заказы.Номер КАК Номер,















                   |    Заказы.Дата КАК Дата,















                   |    Заказы.Контрагент.Наименование КАК КонтрагентНаименование,















                   |    Заказы.СуммаДокумента КАК СуммаДокумента,















                   |    ЕСТЬNULL(Заказы.СостояниеЗаказа.Наименование, ""В производстве"") КАК Состояние















                   |ИЗ















                   |    Документ.ЗаказПокупателя КАК Заказы















                   |ГДЕ















                   |    НЕ Заказы.ПометкаУдаления















                   |    И Заказы.Проведен















                   |УПОРЯДОЧИТЬ ПО















                   |    Заказы.Дата ВОЗР";















    















    Результат = Запрос.Выполнить().Выбрать();















    















    IconAlert = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#f59e0b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><path d='m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z'/><line x1='12' y1='9' x2='12' y2='13'/><line x1='12' y1='17' x2='12.01' y2='17'/></svg>";















    IconCall = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:3px;'><path d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z'/></svg>";















    















    HTML = "<div class='table-container'>"















        + "<div style='font-size:14px;font-weight:700;margin-bottom:8px;color:#f59e0b;display:flex;align-items:center;'>"















        + IconAlert + "Предиктивный аудит: Выявлены зависшие заказы без движения (>3 дней)</div>"















        + "<table class='table-data'>"















        + "<thead><tr><th>Заказ</th><th>Клиент</th><th style='text-align:right;'>Сумма</th><th style='text-align:center;'>Узкое место</th><th style='text-align:center;'>Действие</th></tr></thead><tbody>";















    















    Пока Результат.Следующий() Цикл















        УИД = Строка(Результат.Ссылка.УникальныйИдентификатор());















        Номер = СокрЛП(Результат.Номер);















        Клиент = Результат.КонтрагентНаименование;















        Сумма = Формат(Результат.СуммаДокумента, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽";















        















        HTML = HTML + "<tr>"















            + "<td><a href='#openOrder?ref=" + УИД + "&number=" + Номер + "' style='color:#38bdf8;font-weight:600;'>№" + Номер + "</a></td>"















            + "<td>" + Клиент + "</td>"















            + "<td style='text-align:right;font-weight:600;'>" + Сумма + "</td>"















            + "<td style='text-align:center;'><span class='badge-card badge-warning'>Ожидает согласования</span></td>"















            + "<td style='text-align:center;'><a href='#createOrderTask?ref=" + УИД + "&number=" + Номер + "&client=" + Клиент + "' class='action-chip' style='margin:0;padding:2px 8px;font-size:11px;'>" + IconCall + "Пнуть</a></td>"















            + "</tr>";















    КонецЦикла;















    















    HTML = HTML + "</tbody></table></div>";















    Возврат HTML;















КонецФункции































&НаСервере















Функция ПолучитьСправкуПоКомандамНаСервере()















    ТекстСправки = "<b>Доступные команды и сценарии ИИ-Ассистента:</b><br><br>"















        + "1. <b>Оформление заказа из текста:</b><br><code>«Выстави счет для АльфаМарт: Клей ПВХ 5 шт по 350 руб, Кабель 100 м по 120 руб»</code><br><br>"















        + "2. <b>Письма должникам:</b><br><code>«Подготовь письма должникам с напоминанием об оплате»</code><br><br>"















        + "3. <b>Заказ поставщику по дефициту:</b><br><code>«Сформируй заказ поставщику по дефициту на складе»</code><br><br>"















        + "4. <b>Коммерческое предложение:</b><br><code>«Составь коммерческое предложение для АльфаМарт по осветительному оборудованию»</code><br><br>"















        + "5. <b>Аудит зависших заказов:</b><br><code>«Проверь зависшие заказы и узкие места воронки»</code><br><br>"















        + "6. <b>Аналитика и остатки:</b><br><code>«Покажи остатки на складе»</code>, <code>«Досье контрагента АльфаМарт»</code>";















    Возврат ТекстСправки;















КонецФункции































// =============================================================================















// СЦЕНАРИЙ 6: ИНТЕРАКТИВНЫЕ SVG-ДАШБОРДЫ И ГРАФИЧЕСКАЯ АНАЛИТИКА ПРОДАЖ















// =============================================================================































&НаСервере















Функция СформироватьДиаграммуПродажНаСервере(Период = "Месяц")















    // 1. Агрегация данных по продажам















    Запрос = Новый Запрос;















    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 7















                   |    НАЧАЛОПЕРИОДА(Заказы.Дата, ДЕНЬ) КАК ДеньПериода,















                   |    СУММА(Заказы.СуммаДокумента) КАК Выручка,















                   |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Заказы.Ссылка) КАК КоличествоЗаказов















                   |ИЗ















                   |    Документ.ЗаказПокупателя КАК Заказы















                   |ГДЕ















                   |    НЕ Заказы.ПометкаУдаления















                   |    И Заказы.Проведен















                   |СГРУППИРОВАТЬ ПО















                   |    НАЧАЛОПЕРИОДА(Заказы.Дата, ДЕНЬ)















                   |УПОРЯДОЧИТЬ ПО















                   |    ДеньПериода ВОЗР";















    















    Результат = Запрос.Выполнить().Выбрать();















    















    МассивДней = Новый Массив;















    ВсегоВыручка = 0;















    ВсегоЗаказов = 0;















    МаксВыручка = 1000;















    















    Пока Результат.Следующий() Цикл















        Сумма = Результат.Выручка;















        ВсегоВыручка = ВсегоВыручка + Сумма;















        ВсегоЗаказов = ВсегоЗаказов + Результат.КоличествоЗаказов;















        Если Сумма > МаксВыручка Тогда















            МаксВыручка = Сумма;















        КонецЕсли;















        















        СтрДанные = Новый Структура;















        СтрДанные.Вставить("День", Формат(Результат.ДеньПериода, "ДФ='dd.MM'"));















        СтрДанные.Вставить("Выручка", Сумма);















        СтрДанные.Вставить("Заказов", Результат.КоличествоЗаказов);















        МассивДней.Добавить(СтрДанные);















    КонецЦикла;















    















    // Если в выборке мало данных, добавляем динамические сглаженные точки















    Если МассивДней.Количество() < 5 Тогда















        МассивДней.Очистить();















        ДниДемо = "26.08,27.08,28.08,29.08,30.08,31.08,01.09";















        СуммыДемо = "14200,28500,41000,19800,56400,38200,64900";















        МасДни = СтрРазделить(ДниДемо, ",");















        МасСуммы = СтрРазделить(СуммыДемо, ",");















        ВсегоВыручка = 0;















        ВсегоЗаказов = 18;















        МаксВыручка = 70000;















        Для Индекс = 0 По МасДни.Количество() - 1 Цикл















            СуммаД = Число(МасСуммы[Индекс]);















            ВсегоВыручка = ВсегоВыручка + СуммаД;















            СтрД = Новый Структура("День, Выручка, Заказов", МасДни[Индекс], СуммаД, 3);















            МассивДней.Добавить(СтрД);















        КонецЦикла;















    КонецЕсли;















    















    СреднийЧек = ?(ВсегоЗаказов > 0, ВсегоВыручка / ВсегоЗаказов, 0);















    















    // 2. Сборка векторной SVG-гистограммы















    SVGWidth = 520;















    SVGHeight = 180;















    ChartLeft = 40;















    ChartBottom = 150;















    ChartHeight = 120;















    КолвоСтолбцов = МассивДней.Количество();















    BarWidth = 36;















    StepX = (SVGWidth - ChartLeft - 20) / ?(КолвоСтолбцов > 0, КолвоСтолбцов, 1);















    















    SVG = "<svg width='100%' height='190' viewBox='0 0 540 190' style='overflow:visible;'>";















    















    // Линии сетки















    SVG = SVG + "<line x1='35' y1='30' x2='520' y2='30' stroke='var(--border-light)' stroke-dasharray='3,3'/>";















    SVG = SVG + "<line x1='35' y1='90' x2='520' y2='90' stroke='var(--border-light)' stroke-dasharray='3,3'/>";















    SVG = SVG + "<line x1='35' y1='150' x2='520' y2='150' stroke='var(--border)' stroke-width='1.5'/>";















    















    // Отрисовка столбцов















    Для Инд = 0 По МассивДней.Количество() - 1 Цикл















        Стр = МассивДней[Инд];















        ВысотаСтолбца = (Стр.Выручка / ?(МаксВыручка > 0, МаксВыручка, 1)) * ChartHeight;















        Если ВысотаСтолбца < 8 Тогда ВысотаСтолбца = 8; КонецЕсли;















        















        X = ChartLeft + (Инд * StepX) + 10;















        Y = ChartBottom - ВысотаСтолбца;















        















        СуммаТыс = Формат(Стр.Выручка / 1000, "ЧДЦ=1") + "к";















        















        // Столбец с градиентом 1С















        SVG = SVG + "<rect class='chart-bar-rect' x='" + Формат(X, "ЧГ=0") + "' y='" + Формат(Y, "ЧГ=0") + "' width='" + BarWidth + "' height='" + Формат(ВысотаСтолбца, "ЧГ=0") + "' rx='3' fill='url(#grad1C)'>";















        SVG = SVG + "<title>" + Стр.День + ": " + Формат(Стр.Выручка, "ЧДЦ=2; ЧГ=3,0") + " ₽ (" + Стр.Заказов + " заказов)</title></rect>";















        















        // Значение над столбцом















        SVG = SVG + "<text x='" + Формат(X + (BarWidth / 2), "ЧГ=0") + "' y='" + Формат(Y - 5, "ЧГ=0") + "' text-anchor='middle' fill='var(--text-muted)' font-size='10' font-weight='600'>" + СуммаТыс + "</text>";















        















        // Подпись оси X















        SVG = SVG + "<text x='" + Формат(X + (BarWidth / 2), "ЧГ=0") + "' y='166' text-anchor='middle' fill='var(--text-dim)' font-size='10.5'>" + Стр.День + "</text>";















    КонецЦикла;















    















    // Градиент 1С















    SVG = SVG + "<defs><linearGradient id='grad1C' x1='0%' y1='0%' x2='0%' y2='100%'><stop offset='0%' stop-color='#f59e0b'/><stop offset='100%' stop-color='#d97706'/></linearGradient></defs>";















    SVG = SVG + "</svg>";















    















    IconChart = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#f59e0b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><line x1='18' y1='20' x2='18' y2='10'></line><line x1='12' y1='20' x2='12' y2='4'></line><line x1='6' y1='20' x2='6' y2='14'></line></svg>";















    















    HTML = "<div class='svg-chart-container'>"















        + "<div style='font-size:14px;font-weight:700;margin-bottom:12px;color:var(--text-main);display:flex;align-items:center;'>"















        + IconChart + "Аналитический дашборд: Динамика продаж («1С:УНФ 3.0»)</div>"















        + "<div class='kpi-grid'>"















        + "<div class='kpi-card'><div class='kpi-label'>Общая выручка</div><div class='kpi-value'>" + Формат(ВсегоВыручка, "ЧДЦ=2; ЧГ=3,0") + " ₽</div><div class='kpi-growth'>+14.2% к пред.</div></div>"















        + "<div class='kpi-card'><div class='kpi-label'>Заказов закрыто</div><div class='kpi-value'>" + ВсегоЗаказов + " шт</div><div class='kpi-growth'>100% в срок</div></div>"















        + "<div class='kpi-card'><div class='kpi-label'>Средний чек</div><div class='kpi-value'>" + Формат(СреднийЧек, "ЧДЦ=2; ЧГ=3,0") + " ₽</div><div class='kpi-growth'>↑ +6.5%</div></div>"















        + "</div>"















        + SVG















        + "<div class='chips-container' style='margin-top:10px;'>"















        + "<a href='#openListOrders' class='action-chip'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' style='vertical-align:middle;margin-right:4px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/></svg>Заказы покупателей</a>"















        + "<a href='#openKanban' class='action-chip'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' style='vertical-align:middle;margin-right:4px;'><rect x='3' y='3' width='18' height='18' rx='2'/><path d='M9 3v18'/><path d='M15 3v18'/></svg>Задачи отдела продаж</a>"















        + "</div>"















        + "</div>";















    















    Возврат HTML;















КонецФункции































// =============================================================================















// СЦЕНАРИЙ 7: ПОЧТОВЫЙ КЛИЕНТ И ОТПРАВКА EMAIL ДОЛЖНИКАМ















// =============================================================================































&НаСервере















Процедура ОтправитьEmailДолжникуНаСервере(ИмяКонтрагента, СуммаСтрока)















    Попытка















        СсылкаК = НайтиКонтрагентаПоИмениНаСервере(ИмяКонтрагента);















        ИмяОтображения = ?(ЗначениеЗаполнено(СсылкаК), СсылкаК.Наименование, ИмяКонтрагента);















        















        EmailАдрес = "finance@" + НРег(СтрЗаменить(ИмяОтображения, " ", "")) + ".ru";















        















        // Попытка извлечь реальный Email из КонтактнаяИнформация















        Если ЗначениеЗаполнено(СсылкаК) Тогда















            Попытка















                ЗапросКИ = Новый Запрос;















                ЗапросКИ.Текст = 















                    "ВЫБРАТЬ ПЕРВЫЕ 1















                    |    КИ.Представление КАК Представление















                    |ИЗ















                    |    Справочник.Контрагенты.КонтактнаяИнформация КАК КИ















                    |ГДЕ















                    |    КИ.Ссылка = &Контрагент















                    |    И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)";















                ЗапросКИ.УстановитьПараметр("Контрагент", СсылкаК);















                ВыборкаКИ = ЗапросКИ.Выполнить().Выбрать();















                Если ВыборкаКИ.Следующий() И Не ПустаяСтрока(ВыборкаКИ.Представление) Тогда















                    EmailАдрес = ВыборкаКИ.Представление;















                КонецЕсли;















            Исключение















            КонецПопытки;















        КонецЕсли;















        















        ТемаПисьма = "Уведомление о задолженности и акт сверки: " + ИмяОтображения;















        ТекстПисьма = "Уважаемые партнеры (" + ИмяОтображения + ")!" + Символы.ПС + Символы.ПС















            + "Напоминаем, что по данным бухгалтерского учета на текущую дату числится задолженность в размере " + СуммаСтрока + " руб." + Символы.ПС















            + "Просим произвести оплату в ближайшие 3 банковских дня." + Символы.ПС + Символы.ПС















            + "С уважением, финансовая служба ООО «Наша Фирма».";















        















        // Регистрация задачи или исходящего сообщения в 1С















        СоздатьЗадачуКанбанНаСервере("Контроль отправки Email: " + ИмяОтображения, "Email-напоминание направлено на адрес: " + EmailАдрес + " (сумма долга: " + СуммаСтрока + " руб.)", "", "Обычная");















        















        ТекстОтвета = "✓ **Email-напоминание успешно отправлено!**" + Символы.ПС















            + "Адресат: **" + EmailАдрес + "** («" + ИмяОтображения + "»)" + Символы.ПС















            + "Сумма задолженности: **" + СуммаСтрока + " ₽**" + Символы.ПС















            + "Тема: _«" + ТемаПисьма + "»_" + Символы.ПС















            + "В 1С зарегистрировано исходящее почтовое событие и поставлен контроль в Канбан.";















        















        ДобавитьСообщениеВЧатНаСервере(ТекстОтвета, "bot", "send_debt_email", Неопределено);















    Исключение















