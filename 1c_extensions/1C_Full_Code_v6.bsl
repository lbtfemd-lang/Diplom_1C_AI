    IconBox = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><path d='M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z'/></svg>";

    IconDoc = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/></svg>";

    IconUser = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/></svg>";

    IconTask = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/></svg>";

    IconAlert = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/></svg>";



    Кнопки = "<div class='chips-container' style='margin-top:8px;'>";



    Если Действие = "parse_order_text" ИЛИ Действие = "create_object" Тогда

        Кнопки = Кнопки + "<span class='badge-card badge-success'>" + IconCart + "Заказ создан в 1С</span>";

    ИначеЕсли Действие = "cash_gap_forecast" Тогда

        Кнопки = Кнопки + "<span class='badge-card badge-danger'>" + IconCash + "Прогноз ликвидности</span>";

    ИначеЕсли Действие = "audit_stalled_orders" Тогда

        Кнопки = Кнопки + "<span class='badge-card badge-warning'>" + IconClock + "Зависшие заказы</span>";

    ИначеЕсли Действие = "get_dead_stock" Тогда

        Кнопки = Кнопки + "<span class='badge-card badge-warning'>" + IconBox + "Неликвиды</span>";

    ИначеЕсли Действие = "get_creditors" Тогда

        Кнопки = Кнопки + "<span class='badge-card badge-danger'>" + IconAlert + "Долги поставщикам</span>";

    ИначеЕсли Действие = "dormant_clients_winback" Тогда

        Кнопки = Кнопки + "<span class='badge-card badge-info'>" + IconUser + "Спящие клиенты</span>";

    ИначеЕсли Действие = "supplier_price_comparison" Тогда

        Кнопки = Кнопки + "<span class='badge-card badge-info'>" + IconDoc + "Цены поставщиков</span>";

    ИначеЕсли Действие = "get_debtors" Тогда

        Кнопки = Кнопки + "<span class='badge-card badge-danger'>" + IconAlert + "Дебиторка</span>";

    ИначеЕсли Действие = "create_reconciliation_act" Тогда

        Кнопки = Кнопки + "<span class='badge-card badge-info'>" + IconDoc + "Акт сверки</span>";

    ИначеЕсли Действие = "get_stock" Тогда

        Кнопки = Кнопки + "<span class='badge-card badge-info'>" + IconBox + "Остатки склада</span>";

    ИначеЕсли Действие = "get_orders" Тогда

        Кнопки = Кнопки + "<span class='badge-card badge-info'>" + IconCart + "Заказы</span>";

    ИначеЕсли Действие = "get_dossier" Тогда

        Кнопки = Кнопки + "<span class='badge-card badge-info'>" + IconUser + "Досье контрагента</span>";

    ИначеЕсли Действие = "get_cash_balance" Тогда

