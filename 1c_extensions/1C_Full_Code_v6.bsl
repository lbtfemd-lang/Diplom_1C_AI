        ПоказатьОповещениеПользователя("Канбан-задача создана", , "Задача добавлена на доску!", БиблиотекаКартинок.Информация);



    // 13. Прогноз кассового разрыва (РЕАЛЬНЫЕ ДАННЫЕ 1С)

