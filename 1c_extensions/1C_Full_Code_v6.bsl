        ТЗ.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));















        П1 = ТЗ.Добавить(); П1.Номер = "ЗП-000041"; П1.Поставщик = "Ферроком"; П1.Сумма = 345000;















        П2 = ТЗ.Добавить(); П2.Номер = "ЗП-000040"; П2.Поставщик = "МРО ТЕХИНКОМ"; П2.Сумма = 112000;















        П3 = ТЗ.Добавить(); П3.Номер = "ЗП-000039"; П3.Поставщик = "ООО КабельСнаб"; П3.Сумма = 85000;















