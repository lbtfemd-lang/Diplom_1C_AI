        КонецЕсли;















        















        СсылкаЗаказ = "<a href='#openOrder?ref=" + УИДЗаказа + "&number=" + НомерЗаказа + "' class='link-accent' title='Открыть заказ в 1С'>№" + НомерЗаказа + "</a>";















