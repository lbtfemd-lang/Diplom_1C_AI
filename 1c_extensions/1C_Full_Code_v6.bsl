КонецФункции































&НаСервереБезКонтекста















Функция ПреобразоватьMarkdownВHTML(Знач ИсходныйТекст)















    Если ПустаяСтрока(ИсходныйТекст) Тогда















        Возврат "";















    КонецЕсли;















    















    IconCheckSVG = "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='#22c55e' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:-1px;margin-right:3px;'><polyline points='20 6 9 17 4 12'></polyline></svg>";















    IconBulbSVG  = "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='#f59e0b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:-1px;margin-right:3px;'><path d='M9 18h6m-4 4h2m1.09-8c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14'></path></svg>";















    IconWarnSVG  = "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='#f87171' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:-1px;margin-right:3px;'><path d='M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z'></path><line x1='12' y1='9' x2='12' y2='13'></line><line x1='12' y1='17' x2='12.01' y2='17'></line></svg>";















    















    // Если текст уже содержит HTML разметку (например таблицу, div, span или svg)















    Если СтрНайти(ИсходныйТекст, "<table") > 0 ИЛИ СтрНайти(ИсходныйТекст, "<div") > 0 ИЛИ СтрНайти(ИсходныйТекст, "<h3") > 0 ИЛИ СтрНайти(ИсходныйТекст, "<svg") > 0 Тогда















        // Текст уже сформирован в формате HTML — выполняем только точечные Markdown замены (жирный, код)















        Текст = ИсходныйТекст;















        















        Пока Истина Цикл















            Поз1 = СтрНайти(Текст, "**");















            Если Поз1 = 0 Тогда Прервать; КонецЕсли;















            Поз2 = СтрНайти(Текст, "**", , Поз1 + 2);















            Если Поз2 = 0 Тогда Прервать; КонецЕсли;















            















            ТекстЖирный = Сред(Текст, Поз1 + 2, Поз2 - Поз1 - 2);















            Текст = Лев(Текст, Поз1 - 1) + "<b>" + ТекстЖирный + "</b>" + Сред(Текст, Поз2 + 2);















        КонецЦикла;















        















        Текст = СтрЗаменить(Текст, "✓", IconCheckSVG);















        Текст = СтрЗаменить(Текст, "✅", IconCheckSVG);















        Текст = СтрЗаменить(Текст, "💡", IconBulbSVG);















        Текст = СтрЗаменить(Текст, "⚠️", IconWarnSVG);















        Текст = СтрЗаменить(Текст, "⚠", IconWarnSVG);















        















        Возврат Текст;















    КонецЕсли;















    















    // 1. Сначала безопасно экранируем сырой текст пользователя















    Текст = ШЭкранироватьHTML(ИсходныйТекст);















    















    // 2. И ТОЛЬКО ПОТОМ подставляем векторные SVG (чтобы они не были экранированы в &lt;svg)















    Текст = СтрЗаменить(Текст, "✓", IconCheckSVG);















    Текст = СтрЗаменить(Текст, "✅", IconCheckSVG);















    Текст = СтрЗаменить(Текст, "💡", IconBulbSVG);















    Текст = СтрЗаменить(Текст, "⚠️", IconWarnSVG);















    Текст = СтрЗаменить(Текст, "⚠", IconWarnSVG);















    















    // 1. Заголовки ### Заголовок -> <h3>Заголовок</h3>















    СтрокиМассив = СтрРазделить(Текст, Символы.ПС);















    Результат = "";















    ВнутриСписка = Ложь;















    















    Для Каждого Стр Из СтрокиМассив Цикл















        СтрТрим = СокрЛП(Стр);















        















        Если СтрНачинаетсяС(СтрТрим, "### ") Тогда















            Если ВнутриСписка Тогда















                Результат = Результат + "</ul>";















                ВнутриСписка = Ложь;















            КонецЕсли;















            Результат = Результат + "<h3 style=""margin-bottom:6px;margin-top:6px;"">" + Сред(СтрТрим, 5) + "</h3>";















        ИначеЕсли СтрНачинаетсяС(СтрТрим, "- ") ИЛИ СтрНачинаетсяС(СтрТрим, "* ") Тогда















            Если НЕ ВнутриСписка Тогда















                Результат = Результат + "<ul>";















                ВнутриСписка = Истина;















            КонецЕсли;















            Результат = Результат + "<li>" + Сред(СтрТрим, 3) + "</li>";















        Иначе















            Если ВнутриСписка Тогда















                Результат = Результат + "</ul>";















                ВнутриСписка = Ложь;















            КонецЕсли;















            Если Не ПустаяСтрока(СтрТрим) Тогда















                Результат = Результат + "<p>" + СтрТрим + "</p>";















            КонецЕсли;















        КонецЕсли;















    КонецЦикла;















    















    Если ВнутриСписка Тогда















        Результат = Результат + "</ul>";















    КонецЕсли;















    















    // 2. Жирный шрифт **текст** -> <b>текст</b>















    Пока Истина Цикл















        Поз1 = СтрНайти(Результат, "**");















        Если Поз1 = 0 Тогда Прервать; КонецЕсли;















        Поз2 = СтрНайти(Результат, "**", , Поз1 + 2);















        Если Поз2 = 0 Тогда Прервать; КонецЕсли;















        















        ТекстЖирный = Сред(Результат, Поз1 + 2, Поз2 - Поз1 - 2);















        Результат = Лев(Результат, Поз1 - 1) + "<b>" + ТекстЖирный + "</b>" + Сред(Результат, Поз2 + 2);















    КонецЦикла;















    















    // 3. Моноширинный код `код` -> <code>код</code>















    Пока Истина Цикл















        Поз1 = СтрНайти(Результат, "`");















        Если Поз1 = 0 Тогда Прервать; КонецЕсли;















        Поз2 = СтрНайти(Результат, "`", , Поз1 + 1);















        Если Поз2 = 0 Тогда Прервать; КонецЕсли;















        















        ТекстКод = Сред(Результат, Поз1 + 1, Поз2 - Поз1 - 1);















        Результат = Лев(Результат, Поз1 - 1) + "<code>" + ТекстКод + "</code>" + Сред(Результат, Поз2 + 1);















    КонецЦикла;















    















    Возврат Результат;















КонецФункции































// =============================================================================















// 2.2 ГЕНЕРАТОР ACTION CHIPS















// =============================================================================































&НаСервереБезКонтекста















Функция СформироватьActionChipsHTML(Действие, ДанныеJSON = Неопределено)

    Если ПустаяСтрока(Действие) ИЛИ Действие = "expert_answer" Тогда

        Возврат "";

    КонецЕсли;



    IconCart = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><circle cx='9' cy='21' r='1'/><circle cx='20' cy='21' r='1'/><path d='M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6'/></svg>";

    IconClock = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg>";

