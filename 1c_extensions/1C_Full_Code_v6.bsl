// =============================================================================
// 1С AI Ассистент v6 — HTML-чат + команды, совместимость с мобильным клиентом
// =============================================================================

Перем MiddlewareURL Экспорт;
Перем MiddlewareПорт Экспорт;
Перем MiddlewareТокен Экспорт;

// =============================================================================
// ИНИЦИАЛИЗАЦИЯ
// =============================================================================

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    MiddlewareURL = АдресСервера;
    MiddlewareПорт = 8000;
    MiddlewareТокен = "";
    
    Стр = ЧатИстория.Добавить();
    Стр.Автор = "1С Ассистент";
    Стр.Текст = "Привет! Я ИИ-ассистент 1С. Задайте вопрос или нажмите кнопку выше.";
    Стр.Время = Формат(ТекущаяДата(), "ДФ=HH:mm");
    Стр.ТипСообщения = "bot";
    
    ЧатHTML = СгенерироватьЧатHTML();
КонецПроцедуры

&НаСервере
Функция АдресСервера()
    Если ЗначениеЗаполнено(АдресMiddleware) Тогда
        Возврат АдресMiddleware;
    КонецЕсли;
    Возврат "127.0.0.1";
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ПолучитьТокенАвторизацииНаСервере();
КонецПроцедуры

// =============================================================================
// HTML-ЧАТ — генерация разметки
// =============================================================================

&НаСервере
Функция СгенерироватьЧатHTML()
    Шапка = "<!DOCTYPE html><html><head><meta charset=""UTF-8"">"
        + "<style>"
        + "* { margin: 0; padding: 0; box-sizing: border-box; }"
        + "html, body { height: 100%; overflow: hidden; }"
        + "body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;"
        + "  background: #1a1a2e; color: #e0e0e0; font-size: 13.5px; }"
        + ".chat { display: flex; flex-direction: column;"
        + "  padding: 14px 16px; overflow-y: auto; height: 100%; }"
        + ".msg { display: flex; margin-bottom: 10px; }"
        + ".msg.user { justify-content: flex-end; }"
        + ".msg.bot  { justify-content: flex-start; }"
        + ".avatar { width: 32px; height: 32px; border-radius: 50%;"
        + "  display: flex; align-items: center; justify-content: center;"
        + "  font-size: 12px; font-weight: 700; flex-shrink: 0;"
        + "  box-shadow: 0 2px 6px rgba(0,0,0,0.25); }"
        + ".msg.user .avatar { background: linear-gradient(135deg,#ff6b00,#ff8c42);"
        + "  color: #1a1a1a; margin-left: 10px; order: 2; }"
        + ".msg.bot  .avatar { background: linear-gradient(135deg,#3b82f6,#6366f1);"
        + "  color: #fff; margin-right: 10px; }"
        + ".wrap { display: flex; flex-direction: column; max-width: 70%; }"
        + ".bubble { padding: 10px 14px; border-radius: 16px;"
        + "  line-height: 1.55; word-wrap: break-word; white-space: pre-wrap;"
        + "  box-shadow: 0 2px 8px rgba(0,0,0,0.18); }"
        + ".msg.user .bubble { background: linear-gradient(135deg,#ff6b00,#ff8c42);"
        + "  color: #1a1a1a; border-bottom-right-radius: 4px; }"
        + ".msg.bot  .bubble { background: #2d2d48; color: #e8e8e8;"
        + "  border-bottom-left-radius: 4px; }"
        + ".time { font-size: 10px; color: #555; margin-top: 3px; }"
        + ".msg.user .time { text-align: right; }"
        + ".typing { display: flex; align-items: center; padding: 10px 14px;"
        + "  background: #2d2d48; border-radius: 16px; border-bottom-left-radius: 4px;"
        + "  box-shadow: 0 2px 8px rgba(0,0,0,0.18); }"
        + ".typing span { width: 7px; height: 7px; margin: 0 2px;"
        + "  border-radius: 50%; background: #888; display: inline-block;"
        + "  animation: bounce 1.4s infinite ease-in-out both; }"
        + ".typing span:nth-child(1) { animation-delay: -0.32s; }"
        + ".typing span:nth-child(2) { animation-delay: -0.16s; }"
        + "@keyframes bounce {"
        + "  0%, 80%, 100% { transform: scale(0); }"
        + "  40% { transform: scale(1); } }"
        + "</style></head>"
        + "<body><div class=""chat"">";
    
    СообщенияHTML = "";
    Для Каждого Стр Из ЧатИстория Цикл
        Класс = ?(Стр.ТипСообщения = "user", "user", "bot");
        Иконка = ?(Стр.ТипСообщения = "user", "В", "AI");
        ТекстЭкр = ЭкранироватьHTML(Стр.Текст);
        ВремяЭкр = ЭкранироватьHTML(Стр.Время);
        
        СообщенияHTML = СообщенияHTML
            + "<div class=""msg " + Класс + """>"
            + "<div class=""avatar"">" + Иконка + "</div>"
            + "<div class=""wrap"">"
            + "<div class=""bubble"">" + ТекстЭкр + "</div>"
            + "<div class=""time"">" + ВремяЭкр + "</div>"
            + "</div></div>";
    КонецЦикла;
    
    Подвал = "</div>"
        + "<script>"
        + "var c=document.querySelector('.chat');"
        + "if(c){c.scrollTop=c.scrollHeight;}"
        + "</script></body></html>";
    
    Возврат Шапка + СообщенияHTML + Подвал;
КонецФункции

&НаСервере
Функция СгенерироватьЧатHTMLЗагрузка()
    ОсновнойHTML = СгенерироватьЧатHTML();
    ИндексПоследнейСкобки = СтрНайти(ОсновнойHTML, "</div><script>", НаправлениеПоиска.СКонца);
    Если ИндексПоследнейСкобки = 0 Тогда
        Возврат ОсновнойHTML;
    КонецЕсли;
    
    Индикатор = "<div class=""msg bot"">"
        + "<div class=""avatar"">AI</div>"
        + "<div class=""wrap"">"
        + "<div class=""typing""><span></span><span></span><span></span></div>"
        + "</div></div>";
    
    Возврат Лев(ОсновнойHTML, ИндексПоследнейСкобки - 1) + Индикатор + "</div><script>"
        + "var c=document.querySelector('.chat');"
        + "if(c){c.scrollTop=c.scrollHeight;}"
        + "</script></body></html>";
КонецФункции

// =============================================================================
// АВТОРИЗАЦИЯ
// =============================================================================

&НаСервере
Процедура ПолучитьТокенАвторизацииНаСервере()
    Если Не ПустаяСтрока(MiddlewareТокен) Тогда Возврат; КонецЕсли;
    Попытка
        HTTP = Новый HTTPСоединение(MiddlewareURL, MiddlewareПорт);
        Заголовки = Новый Соответствие;
        Заголовки.Вставить("Content-Type", "application/json");
        Запрос = Новый HTTPЗапрос("/auth/login", Заголовки);
        Запрос.УстановитьТелоИзСтроки("{""username"":""1c_service"",""password"":""1c_service_2024""}", "UTF-8");
        Ответ = HTTP.ОтправитьДляОбработки(Запрос);
        Если Ответ.КодСостояния = 200 Тогда
            ЧтениеJSON = Новый ЧтениеJSON;
            ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
            Структура = ПрочитатьJSON(ЧтениеJSON);
            ЧтениеJSON.Закрыть();
            MiddlewareТокен = Структура.access_token;
        КонецЕсли;
    Исключение
        MiddlewareТокен = "";
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ЗаголовкиСАвторизацией()
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Content-Type", "application/json");
    Если Не ПустаяСтрока(MiddlewareТокен) Тогда
        Заголовки.Вставить("X-Auth-Token", MiddlewareТокен);
    КонецЕсли;
    Возврат Заголовки;
КонецФункции

// =============================================================================
// HTTP-ЗАПРОСЫ (с авторетраей при 401)
// =============================================================================

&НаСервере
Функция ВыполнитьHTTPЗапрос(Путь, ТелоЗапроса = "", Метод = "POST")
    Ответ = ОтправитьHTTP(Путь, ТелоЗапроса, Метод);
    Если Ответ <> Неопределено И Ответ.КодСостояния = 401 Тогда
        MiddlewareТокен = "";
        ПолучитьТокенАвторизацииНаСервере();
        Если Не ПустаяСтрока(MiddlewareТокен) Тогда
            Ответ = ОтправитьHTTP(Путь, ТелоЗапроса, Метод);
        КонецЕсли;
    КонецЕсли;
    Возврат Ответ;
КонецФункции

&НаСервере
Функция ОтправитьHTTP(Путь, ТелоЗапроса, Метод)
    Попытка
        HTTP = Новый HTTPСоединение(MiddlewareURL, MiddlewareПорт);
        Заголовки = ЗаголовкиСАвторизацией();
        Запрос = Новый HTTPЗапрос(Путь, Заголовки);
        Если Не ПустаяСтрока(ТелоЗапроса) Тогда
            Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8");
        КонецЕсли;
        Если Метод = "GET" Тогда
            Возврат HTTP.Получить(Запрос);
        Иначе
            Возврат HTTP.ОтправитьДляОбработки(Запрос);
        КонецЕсли;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

&НаСервере
Функция ВыполнитьHTTPЗапросНаСервере(Путь, ТелоЗапроса, Метод = "POST")
    Возврат ВыполнитьHTTPЗапрос(Путь, ТелоЗапроса, Метод);
КонецФункции

// =============================================================================
// ЧАТ — добавление сообщений
// =============================================================================

&НаСервере
Процедура ДобавитьСообщениеВЧатНаСервере(Текст, Роль)
    Стр = ЧатИстория.Добавить();
    Стр.Автор = ?(Роль = "user", "Вы", "1С Ассистент");
    Стр.Текст = Текст;
    Стр.Время = Формат(ТекущаяДата(), "ДФ=HH:mm");
    Стр.ТипСообщения = Роль;
    ЧатHTML = СгенерироватьЧатHTML();
КонецПроцедуры

// =============================================================================
// ОТПРАВКА СООБЩЕНИЙ
// =============================================================================

&НаКлиенте
Процедура ОтправитьСообщение(Команда)
    Если ПустаяСтрока(ТекстСообщения) Тогда Возврат; КонецЕсли;
    
    ЗапросТекст = ТекстСообщения;
    ТекстСообщения = "";
    
    ДобавитьСообщениеВЧатНаСервере(ЗапросТекст, "user");
    ФлагЗагрузки = Истина;
    ЧатHTML = СгенерироватьЧатHTMLЗагрузка();
    
    КонтекстФормы = "";
    Попытка
        КонтекстФормы = "Форма: " + ЭтаФорма.ИмяФормы;
    Исключение
    КонецПопытки;
    
    МассивСообщений = Новый Массив;
    КоличествоСтрок = ЧатИстория.Количество();
    НачИндекс = ?(КоличествоСтрок > 20, КоличествоСтрок - 20, 0);
    Для Инд = НачИндекс По КоличествоСтрок - 1 Цикл
        СтрЧата = ЧатИстория[Инд];
        РольСообщения = ?(СтрЧата.ТипСообщения = "user", "user", "assistant");
        МассивСообщений.Добавить(Новый Структура("role, text", РольСообщения, СтрЧата.Текст));
    КонецЦикла;
    МассивСообщений.Добавить(Новый Структура("role, text", "user", ЗапросТекст));
    
    СтруктураЗапроса = Новый Структура;
    СтруктураЗапроса.Вставить("messages", МассивСообщений);
    СтруктураЗапроса.Вставить("context", КонтекстФормы);
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    Попытка
        HTTPОтвет = ВыполнитьHTTPЗапросНаСервере("/chat", СтрокаJSON);
        ФлагЗагрузки = Ложь;
        
        Если HTTPОтвет = Неопределено Тогда
            ДобавитьСообщениеВЧатНаСервере("Сервер недоступен. Запустите: python main.py", "bot");
            Возврат;
        КонецЕсли;
        
        Если HTTPОтвет.КодСостояния = 200 Тогда
            Попытка
                ЧтениеJSON = Новый ЧтениеJSON;
                ЧтениеJSON.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку());
                СтруктураОтвета = ПрочитатьJSON(ЧтениеJSON);
                ЧтениеJSON.Закрыть();
            Исключение
                ДобавитьСообщениеВЧатНаСервере("Не удалось разобрать ответ сервера.", "bot");
                Возврат;
            КонецПопытки;
            
            ДобавитьСообщениеВЧатНаСервере(СтруктураОтвета.text, "bot");
            
            Действие = "";
            Если СтруктураОтвета.Свойство("action", Действие) И ЗначениеЗаполнено(Действие) Тогда
                Данные = Неопределено;
                СтруктураОтвета.Свойство("data", Данные);
                ВыполнитьКомандуАссистента(Действие, Данные);
            КонецЕсли;
        Иначе
            ДобавитьСообщениеВЧатНаСервере("Ошибка сервера: " + HTTPОтвет.КодСостояния, "bot");
        КонецЕсли;
    Исключение
        ФлагЗагрузки = Ложь;
        ДобавитьСообщениеВЧатНаСервере("Ошибка: " + ОписаниеОшибки(), "bot");
    КонецПопытки;
КонецПроцедуры

