// 9. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ И БЕЗОПАСНОЕ ОТКРЫТИЕ ФОРМ















// =============================================================================































&НаКлиенте















Функция ЭтоМобильныйКлиент()















    Попытка















        Инфо = Новый СистемнаяИнформация();















        Возврат Инфо.ТипПлатформы = ТипПлатформы.Android ИЛИ Инфо.ТипПлатформы = ТипПлатформы.iOS;















    Исключение















        Возврат Ложь;















    КонецПопытки;















КонецФункции































&НаКлиенте















Процедура БезопасноОткрытьФорму(ИмяФормы, Описание = "", Параметры = Неопределено)















    Попытка















        Если Параметры <> Неопределено Тогда















            ОткрытьФорму(ИмяФормы, Параметры);















        Иначе















            ОткрытьФорму(ИмяФормы);















        КонецЕсли;















    Исключение















        ТекстОшибки = ОписаниеОшибки();















        ТекстСообщения = ?(Не ПустаяСтрока(Описание), "Не удалось открыть «" + Описание + "». ", "")















            + "Форма недоступна в текущем интерфейсе: " + ИмяФормы;















        ДобавитьСообщениеВЧатНаСервере(ТекстСообщения, "bot", "expert_answer", Неопределено);















        ЧатHTML = СгенерироватьЧатHTML();















    КонецПопытки;















