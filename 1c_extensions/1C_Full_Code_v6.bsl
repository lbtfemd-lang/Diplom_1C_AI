    ИтогоДолг = 0;















    Для Каждого Стр Из ТЗ Цикл ИтогоДолг = ИтогоДолг + Стр.СуммаДолга; КонецЦикла;















    















    IconShield = "<svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='#f87171' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/></svg>";















    IconTask = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:3px;'><rect x='3' y='3' width='18' height='18' rx='2'/><path d='M9 3v18'/></svg>";















    















