            + "<td><b>" + ШЭкранироватьHTML(Стр.Номер) + "</b></td>"















            + "<td>" + ШЭкранироватьHTML(Стр.Поставщик) + "</td>"















            + "<td style='text-align:right;color:#38bdf8;font-weight:700;'>" + Формат(Стр.Сумма, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽</td>"















