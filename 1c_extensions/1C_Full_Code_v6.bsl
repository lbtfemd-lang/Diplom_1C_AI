        + "<th style='text-align:center;'>Состояние</th>"















        + "<th style='text-align:center;'>Действие</th>"















        + "</tr></thead><tbody>";















    















    СуммаСтраницы = 0;















    















    Для Индекс = ИндексНач По ИндексКон Цикл















        СтрТЗ = ТЗ[Индекс];















        Сумма = СтрТЗ.СуммаДокумента;















        СуммаСтраницы = СуммаСтраницы + Сумма;















        















        УИДЗаказа = Строка(СтрТЗ.Ссылка.УникальныйИдентификатор());















        УИДКлиента = ?(ЗначениеЗаполнено(СтрТЗ.Контрагент), Строка(СтрТЗ.Контрагент.УникальныйИдентификатор()), "");















        ИмяКлиента = ?(ЗначениеЗаполнено(СтрТЗ.КонтрагентНаименование), СтрТЗ.КонтрагентНаименование, "—");















        ИмяКлиента_Безопасное = СтрЗаменить(СтрЗаменить(ИмяКлиента, Символ(34), ""), "'", "");















        















        НомерЗаказа = СокрЛП(СтрТЗ.Номер);















