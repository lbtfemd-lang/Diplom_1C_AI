&НаКлиенте
Процедура ВыполнитьКомандуАссистента(Действие, Данные)
    Если Данные = Неопределено Тогда Данные = Новый Структура; КонецЕсли;
    Если ТипЗнч(Данные) <> Тип("Структура") Тогда
        Если Действие <> "expert_answer" И Действие <> "create_kanban_task" И Действие <> "show_kanban" Тогда
            Возврат;
        КонецЕсли;
        Данные = Новый Структура;
    КонецЕсли;
    
    ТипОбъекта = "";
    Если Данные <> Неопределено Тогда
        Данные.Свойство("type", ТипОбъекта);
    КонецЕсли;
    
    Если Действие = "create_kanban_task" Тогда
        ВыполнитьСозданиеКанбанЗадачи(Данные);
        
    ИначеЕсли Действие = "show_kanban" Тогда
        Попытка
            Если ЭтоМобильныйКлиент() Тогда
                ОткрытьФорму("Обработка.КанбанДоска.МобильнаяФорма");
            Иначе
                ОткрытьФорму("Обработка.КанбанДоска.Форма", , , , , , );
            КонецЕсли;
        Исключение
            ДобавитьСообщениеВЧатНаСервере("Ошибка открытия Канбан: " + ОписаниеОшибки(), "bot");
        КонецПопытки;
        
    ИначеЕсли Действие = "open_list" Тогда
        БезопасноОткрытьФорму(ТипОбъекта + ".ФормаСписка", "Список " + ТипОбъекта);
        
    ИначеЕсли Действие = "open_form" Тогда
        Попытка
            Части = СтрРазделить(ТипОбъекта, ".");
            Если Части.Количество() > 0 И (Части[0] = "Справочник" ИЛИ Части[0] = "Документ") Тогда
                БезопасноОткрытьФорму(ТипОбъекта + ".ФормаОбъекта", ТипОбъекта);
            Иначе
                БезопасноОткрытьФорму(ТипОбъекта + ".Форма", ТипОбъекта);
            КонецЕсли;
        Исключение
            БезопасноОткрытьФорму(ТипОбъекта + ".ФормаОбъекта", ТипОбъекта);
        КонецПопытки;
        
    ИначеЕсли Действие = "create_object" Тогда
        РезультатПодготовки = Неопределено;
        Поля = Неопределено;
        Если Данные.Свойство("fields", Поля) И ТипЗнч(Поля) = Тип("Структура") Тогда
            РезультатПодготовки = ПодготовитьДанныеЗаполненияНаСервере(ТипОбъекта, Поля);
        КонецЕсли;
        КонтекстСоздания = Новый Структура("ТипОбъекта, РезультатПодготовки", ТипОбъекта, РезультатПодготовки);
        Шаг1_ПроверкаКлиента(КонтекстСоздания);
        
    ИначеЕсли Действие = "find_object" Тогда
        Если Данные.Свойство("number") Тогда
            Номер = Данные.number;
            СсылкаНаОбъект = НайтиСсылкуНаОбъектНаСервере(ТипОбъекта, Номер);
            Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
                ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
                БезопасноОткрытьФорму(ТипОбъекта + ".ФормаОбъекта", ТипОбъекта, ПараметрыФормы);
            Иначе
                ПоказатьПредупреждение(, "Не нашел объект с номером " + Номер);
            КонецЕсли;
        КонецЕсли;
        
    ИначеЕсли Действие = "get_dossier" Тогда
        ОбъектИмя = "";
        Поля = Неопределено;
        Если Данные.Свойство("fields", Поля) И ТипЗнч(Поля) = Тип("Структура") Тогда
            Если Поля.Свойство("Client", ОбъектИмя) ИЛИ Поля.Свойство("Item", ОбъектИмя) Тогда
                ДобавитьСообщениеВЧатНаСервере("Собираю досье на '" + ОбъектИмя + "'...", "bot");
                Досье = СобратьДосьеНаСервере(ТипОбъекта, ОбъектИмя);
                ДобавитьСообщениеВЧатНаСервере("Досье:" + Символы.ПС + Досье, "bot");
            КонецЕсли;
        КонецЕсли;
        
    ИначеЕсли Действие = "run_analytics" Тогда
        Вопрос = "";
        Если Данные.Свойство("query", Вопрос) Тогда
            ДобавитьСообщениеВЧатНаСервере("Выполняю расчеты...", "bot");
            Результ = ВыполнитьАналитикуНаСервере(Вопрос);
            ДобавитьСообщениеВЧатНаСервере("Результат:" + Символы.ПС + Результ, "bot");
        КонецЕсли;
        
    ИначеЕсли Действие = "prepare_payment" Тогда
        ДобавитьСообщениеВЧатНаСервере("Готовлю платежный документ...", "bot");
        Поля = Неопределено;
        Если Данные.Свойство("fields", Поля) Тогда
            РезультатПодготовки = ПодготовитьДанныеЗаполненияНаСервере(ТипОбъекта, Поля);
            Контекст = Новый Структура("ТипОбъекта, РезультатПодготовки", ТипОбъекта, РезультатПодготовки);
            Шаг3_Финал(Контекст);
        КонецЕсли;
        
    ИначеЕсли Действие = "accrual_writeoff" Тогда
        ДобавитьСообщениеВЧатНаСервере("Оформляю операцию учета...", "bot");
        Поля = Неопределено;
        Если Данные.Свойство("fields", Поля) Тогда
            РезультатПодготовки = ПодготовитьДанныеЗаполненияНаСервере(ТипОбъекта, Поля);
            Контекст = Новый Структура("ТипОбъекта, РезультатПодготовки", ТипОбъекта, РезультатПодготовки);
            Шаг3_Финал(Контекст);
        КонецЕсли;
        
    ИначеЕсли Действие = "warehouse_move" Тогда
        ДобавитьСообщениеВЧатНаСервере("Готовлю перемещение на склад...", "bot");
        Поля = Неопределено;
        Если Данные.Свойство("fields", Поля) Тогда
            РезультатПодготовки = ПодготовитьДанныеЗаполненияНаСервере(ТипОбъекта, Поля);
            Контекст = Новый Структура("ТипОбъекта, РезультатПодготовки", ТипОбъекта, РезультатПодготовки);
            Шаг2_ПроверкаТовара(Контекст);
        КонецЕсли;
        
    ИначеЕсли Действие = "employee_info" Тогда
        СотрудникИмя = "";
        Поля = Неопределено;
        Если Данные.Свойство("fields", Поля) И ТипЗнч(Поля) = Тип("Структура") Тогда
            Если Поля.Свойство("Employee", СотрудникИмя) Тогда
                ДобавитьСообщениеВЧатНаСервере("Ищу данные по сотруднику " + СотрудникИмя + "...", "bot");
                Ссылка = НайтиСотрудникаНаСервере(СотрудникИмя);
                Если ЗначениеЗаполнено(Ссылка) Тогда
                    БезопасноОткрытьФорму("Справочник.Сотрудники.ФормаОбъекта", "Сотрудник", Новый Структура("Ключ", Ссылка));
                Иначе
                    ДобавитьСообщениеВЧатНаСервере("Сотрудник '" + СотрудникИмя + "' не найден.", "bot");
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        
    ИначеЕсли Действие = "get_status" Тогда
        Номер = "";
        Если Данные.Свойство("number", Номер) И ЗначениеЗаполнено(Номер) Тогда
            ДобавитьСообщениеВЧатНаСервере("Проверяю статус документа №" + Номер + "...", "bot");
            ТекстСтатуса = ПолучитьСтатусДокументаНаСервере(ТипОбъекта, Номер);
            ДобавитьСообщениеВЧатНаСервере(ТекстСтатуса, "bot");
        КонецЕсли;
        
    ИначеЕсли Действие = "get_stock" Тогда
        ТоварИмя = "";
        Поля = Неопределено;
        Если Данные.Свойство("fields", Поля) И ТипЗнч(Поля) = Тип("Структура") Тогда
            Поля.Свойство("Item", ТоварИмя);
        КонецЕсли;
        Если ЗначениеЗаполнено(ТоварИмя) Тогда
            ДобавитьСообщениеВЧатНаСервере("Запрашиваю остатки по '" + ТоварИмя + "'...", "bot");
            ТекстОстатков = ПолучитьОстаткиТовараНаСервере(ТоварИмя);
            ДобавитьСообщениеВЧатНаСервере(ТекстОстатков, "bot");
        Иначе
            ДобавитьСообщениеВЧатНаСервере("Укажите название товара для запроса остатков.", "bot");
        КонецЕсли;
        
    ИначеЕсли Действие = "get_debtors" Тогда
        ДобавитьСообщениеВЧатНаСервере("Формирую список должников...", "bot");
        ТекстДолжников = ПолучитьСписокДолжниковНаСервере();
        ДобавитьСообщениеВЧатНаСервере(ТекстДолжников, "bot");
        
    ИначеЕсли Действие = "update_metadata" Тогда
        ОбновитьМетаданные(Неопределено);
    КонецЕсли;
КонецПроцедуры

