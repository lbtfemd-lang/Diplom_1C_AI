        + "<div class='section-title'>" + IconTruck + "График ожидаемых поставок от поставщиков</div>"















        + "<table class='table-data'>"















        + "<thead><tr><th>Заказ</th><th>Поставщик</th><th style='text-align:right;'>Сумма поставки</th><th style='text-align:center;'>Срок</th></tr></thead><tbody>";















    















    Для Каждого Стр Из ТЗ Цикл















