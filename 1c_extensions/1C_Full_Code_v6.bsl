        + "<div class='section-title'>" + IconShield + "Кредиторская задолженность (Наши долги поставщикам: " + Формат(ИтогоДолг, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽)</div>"















        + "<table class='table-data'>"















        + "<thead><tr><th>Поставщик</th><th>Договор</th><th style='text-align:right;'>Сумма долга</th><th style='text-align:center;'>Действие</th></tr></thead><tbody>";















    















    Для Каждого Стр Из ТЗ Цикл















        УИД = Строка(Стр.Контрагент.УникальныйИдентификатор());















        ИмяК = Стр.ИмяКонтрагента;















        ИмяК_Безопасное = СтрЗаменить(СтрЗаменить(ИмяК, Символ(34), ""), "'", "");















        СуммаФормат = Формат(Стр.СуммаДолга, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽";















        















        СсылкаК = "<a href='#openCounterparty?ref=" + УИД + "&name=" + ИмяК_Безопасное + "' class='link-accent' title='Открыть карточку поставщика'>" + ШЭкранироватьHTML(ИмяК) + "</a>";















        КнопкаЗадача = "<a href='#createTaskForDebtor?client=" + ИмяК_Безопасное + "&sum=" + Строка(Стр.СуммаДолга) + "' class='action-chip' style='margin:0;padding:2px 8px;font-size:11px;' title='Поставить задачу на оплату'>" + IconTask + "Оплата</a>";















        















