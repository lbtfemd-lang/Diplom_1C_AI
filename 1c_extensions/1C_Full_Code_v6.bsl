// =============================================================================
// КАНАБАН — СОЗДАНИЕ ЗАДАЧИ ЧЕРЕЗ API
// =============================================================================

&НаСервере
Функция СоздатьКанбанЗадачуНаСервере(Заголовок, Описание = "", Колонка = "todo", Приоритет = "medium", Исполнитель = "", Дедлайн = "")
    СтруктураЗапроса = Новый Структура;
    СтруктураЗапроса.Вставить("title", Заголовок);
    Если Не ПустаяСтрока(Описание) Тогда СтруктураЗапроса.Вставить("description", Описание); КонецЕсли;
    СтруктураЗапроса.Вставить("column", Колонка);
    СтруктураЗапроса.Вставить("priority", Приоритет);
    СтруктураЗапроса.Вставить("source", "1c");
    Если Не ПустаяСтрока(Исполнитель) Тогда СтруктураЗапроса.Вставить("assignee", Исполнитель); КонецЕсли;
    Если Не ПустаяСтрока(Дедлайн) Тогда СтруктураЗапроса.Вставить("due_date", Дедлайн); КонецЕсли;
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    Ответ = ВыполнитьHTTPЗапрос("/kanban/tasks", СтрокаJSON);
    Если Ответ = Неопределено ИЛИ Ответ.КодСостояния <> 200 Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
        Результат = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
    Исключение
        Возврат Неопределено;
    КонецПопытки;
    Возврат Результат;
КонецФункции

// =============================================================================
// ЦЕПОЧКА СОЗДАНИЯ (CHAIN OF RESPONSIBILITY)
// =============================================================================

&НаКлиенте
Процедура Шаг1_ПроверкаКлиента(Контекст)
    Данные = Контекст.РезультатПодготовки;
    Если Данные <> Неопределено И Данные.Свойство("НеНайденКлиент") Тогда
        ИмяКлиента = Данные.НеНайденКлиент.Наименование;
        Оповещение = Новый ОписаниеОповещения("ПослеОтветаОКлиенте", ЭтотОбъект, Контекст);
        ПоказатьВопрос(Оповещение, "Клиент '" + ИмяКлиента + "' не найден. Создать?", РежимДиалогаВопрос.ДаНет);
    Иначе
        Шаг2_ПроверкаТовара(Контекст);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаОКлиенте(Результат, Контекст) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
        ДанныеСоздания = Контекст.РезультатПодготовки.НеНайденКлиент;
        ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ДанныеСоздания);
        Оповещение = Новый ОписаниеОповещения("ПослеСозданияКлиента", ЭтотОбъект, Контекст);
        ОткрытьФорму("Справочник.Контрагенты.ФормаОбъекта", ПараметрыФормы, , , , , Оповещение);
    Иначе
        Шаг2_ПроверкаТовара(Контекст);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияКлиента(РезультатЗакрытия, Контекст) Экспорт
    ОбновитьКлиентаВКонтексте(Контекст);
    Шаг2_ПроверкаТовара(Контекст);
КонецПроцедуры

&НаКлиенте
Процедура Шаг2_ПроверкаТовара(Контекст)
    Данные = Контекст.РезультатПодготовки;
    Если Данные <> Неопределено И Данные.Свойство("НеНайденТовар") Тогда
        ИмяТовара = Данные.НеНайденТовар.Наименование;
        Оповещение = Новый ОписаниеОповещения("ПослеОтветаОТоваре", ЭтотОбъект, Контекст);
        ПоказатьВопрос(Оповещение, "Товар '" + ИмяТовара + "' не найден. Создать?", РежимДиалогаВопрос.ДаНет);
    Иначе
        Шаг3_Финал(Контекст);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаОТоваре(Результат, Контекст) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
        ДанныеСоздания = Контекст.РезультатПодготовки.НеНайденТовар;
        ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ДанныеСоздания);
        Оповещение = Новый ОписаниеОповещения("ПослеСозданияТовара", ЭтотОбъект, Контекст);
        ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта", ПараметрыФормы, , , , , Оповещение);
    Иначе
        Шаг3_Финал(Контекст);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияТовара(РезультатЗакрытия, Контекст) Экспорт
    Имя = Контекст.РезультатПодготовки.НеНайденТовар.Наименование;
    НовыеЗначения = ПолучитьТоварИзНоменклатурыНаСервере(Имя, Контекст.РезультатПодготовки.ЗначенияЗаполнения);
    Контекст.РезультатПодготовки.ЗначенияЗаполнения = НовыеЗначения;
    Шаг3_Финал(Контекст);
КонецПроцедуры

&НаКлиенте
Процедура Шаг3_Финал(Контекст)
    ПараметрыЗаполнения = Новый Структура;
    Если Контекст.РезультатПодготовки <> Неопределено И Контекст.РезультатПодготовки.Свойство("ЗначенияЗаполнения") Тогда
        ПараметрыЗаполнения = Контекст.РезультатПодготовки.ЗначенияЗаполнения;
    КонецЕсли;
    ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ПараметрыЗаполнения);
    ОткрытьФорму(Контекст.ТипОбъекта + ".ФормаОбъекта", ПараметрыФормы);
КонецПроцедуры

&НаСервере
Процедура ОбновитьКлиентаВКонтексте(Контекст)
    Имя = Контекст.РезультатПодготовки.НеНайденКлиент.Наименование;
    Ссылка = Справочники.Контрагенты.НайтиПоНаименованию(Имя, Истина);
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Контекст.РезультатПодготовки.ЗначенияЗаполнения.Вставить("Контрагент", Ссылка);
        Контекст.РезультатПодготовки.ЗначенияЗаполнения.Вставить("Покупатель", Ссылка);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьТоварИзНоменклатурыНаСервере(Имя, ТекущиеЗначения)
    НовыеЗначения = Новый Структура;
    Для Каждого Узел Из ТекущиеЗначения Цикл
        НовыеЗначения.Вставить(Узел.Ключ, Узел.Значение);
    КонецЦикла;
    Ссылка = Справочники.Номенклатура.НайтиПоНаименованию(Имя, Истина);
    Если ЗначениеЗаполнено(Ссылка) Тогда
        СтрокаТЧ = Новый Структура("Номенклатура, Количество", Ссылка, 1);
        МассивСтрок = Новый Массив;
        МассивСтрок.Добавить(СтрокаТЧ);
        НовыеЗначения.Вставить("Товары", МассивСтрок);
        НовыеЗначения.Вставить("Запасы", МассивСтрок);
        НовыеЗначения.Вставить("Услуги", МассивСтрок);
        НовыеЗначения.Вставить("Номенклатура", Ссылка);
    КонецЕсли;
    Возврат НовыеЗначения;
КонецФункции

