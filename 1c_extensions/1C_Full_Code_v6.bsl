КонецФункции































































&НаСервере















Функция СобратьДосьеНаСервере(ТипОбъекта, ИмяОбъекта, НомерСтраницы = 1)















    ИмяОчищ = НРег(СокрЛП(ИмяОбъекта));















    Если ПустаяСтрока(ИмяОбъекта) ИЛИ ИмяОчищ = "all" ИЛИ ИмяОчищ = "все" ИЛИ ИмяОчищ = "список" ИЛИ ИмяОчищ = "клиенты" ИЛИ ИмяОчищ = "поставщики" Тогда















        // Список всех контрагентов с пагинацией















        Запрос = Новый Запрос("ВЫБРАТЬ К.Ссылка КАК Ссылка, К.Наименование КАК Наименование, К.ИНН КАК ИНН, К.Покупатель КАК Покупатель, К.Поставщик КАК Поставщик ИЗ Справочник.Контрагенты КАК К ГДЕ НЕ К.ЭтоГруппа И НЕ К.ПометкаУдаления УПОРЯДОЧИТЬ ПО К.Наименование");















        Результат = Неопределено;















        Попытка















            Результат = Запрос.Выполнить();















        Исключение















            Возврат "Ошибка чтения справочника контрагентов: " + ОписаниеОшибки();















        КонецПопытки;















        















        ТЗ = Результат.Выгрузить();















        ВсегоКонтрагентов = ТЗ.Количество();















        РазмерСтр = 8;















        ВсегоСтраниц = ?(ВсегоКонтрагентов = 0, 1, Цел((ВсегоКонтрагентов + РазмерСтр - 1) / РазмерСтр));















        ТекущаяСтр = Макс(1, Мин(Число(НомерСтраницы), ВсегоСтраниц));















        















        ИндексНач = (ТекущаяСтр - 1) * РазмерСтр;















        ИндексКон = Мин(ИндексНач + РазмерСтр - 1, ВсегоКонтрагентов - 1);















        















        IconUsers = "<svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='#38bdf8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87'/><path d='M16 3.13a4 4 0 0 1 0 7.75'/></svg>";















        IconDoc = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:3px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/></svg>";















        















        HTML = "<div class='table-container'>"















            + "<div class='section-title'>"















            + IconUsers + "Клиентская база компании (Контрагенты)</div>"















            + "<table class='table-data'>"















            + "<thead><tr><th>Контрагент</th><th>ИНН</th><th style='text-align:center;'>Тип</th><th style='text-align:center;'>Действие</th></tr></thead><tbody>";















        















        Для Индекс = ИндексНач По ИндексКон Цикл















            СтрТЗ = ТЗ[Индекс];















            УИД = Строка(СтрТЗ.Ссылка.УникальныйИдентификатор());















            ИмяК = СтрТЗ.Наименование;















            ИмяК_Безопасное = СтрЗаменить(СтрЗаменить(ИмяК, Символ(34), ""), "'", "");















            ИНН = ?(ЗначениеЗаполнено(СтрТЗ.ИНН), СтрТЗ.ИНН, "—");















            















            ТипК = "";















            Если СтрТЗ.Покупатель И СтрТЗ.Поставщик Тогда















                ТипК = "<span class='badge-card badge-info'>Покупатель/Поставщик</span>";















            ИначеЕсли СтрТЗ.Поставщик Тогда















                ТипК = "<span class='badge-card badge-warning'>Поставщик</span>";















            Иначе















                ТипК = "<span class='badge-card badge-info'>Покупатель</span>";















            КонецЕсли;















            















            СсылкаК = "<a href='#openCounterparty?ref=" + УИД + "&name=" + ИмяК_Безопасное + "' class='link-accent' title='Открыть карточку в 1С'>" + ШЭкранироватьHTML(ИмяК) + "</a>";















            КнопкаДосье = "<a href='#openDossier?name=" + ИмяК_Безопасное + "' class='action-chip' style='margin:0;padding:2px 8px;font-size:11px;' title='Посмотреть досье'>" + IconDoc + "Досье</a>";















            















            HTML = HTML + "<tr><td>" + СсылкаК + "</td><td class='text-muted' style='font-size:11px;'>" + ИНН + "</td><td style='text-align:center;'>" + ТипК + "</td><td style='text-align:center;'>" + КнопкаДосье + "</td></tr>";















        КонецЦикла;















        















        HTML = HTML + "</tbody></table>";















        















        // Панель пагинации















        КнопкаПред = ?(ТекущаяСтр > 1, "<a href='#openClientsPage?page=" + Строка(ТекущаяСтр - 1) + "' class='action-chip' style='margin:0;padding:3px 10px;'>&laquo; Назад</a>", "<span class='action-chip' style='opacity:0.4;margin:0;padding:3px 10px;'>&laquo; Назад</span>");















        КнопкаСлед = ?(ТекущаяСтр < ВсегоСтраниц, "<a href='#openClientsPage?page=" + Строка(ТекущаяСтр + 1) + "' class='action-chip' style='margin:0;padding:3px 10px;'>Вперед &raquo;</a>", "<span class='action-chip' style='opacity:0.4;margin:0;padding:3px 10px;'>Вперед &raquo;</span>");















        















        HTML = HTML + "<div style='display:flex;align-items:center;justify-content:space-between;margin-top:10px;padding:6px 10px;background:var(--bg-subtle);border-radius:6px;font-size:12px;'>"















            + "<div>" + КнопкаПред + "</div>"















            + "<div style='color:var(--text-muted);font-weight:600;'>Страница <span style='color:var(--text-main);'>" + ТекущаяСтр + "</span> из " + ВсегоСтраниц + " (всего: " + ВсегоКонтрагентов + ")</div>"















            + "<div>" + КнопкаСлед + "</div>"















            + "</div>"















            + "</div>";















            















        Возврат HTML;















    КонецЕсли;















    















    // Ищем конкретного контрагента (покупателя или поставщика)















    СсылкаК = НайтиКонтрагентаПоИмениНаСервере(ИмяОбъекта);















    Если Не ЗначениеЗаполнено(СсылкаК) Тогда















        // Нечеткий поиск















        ЗапросПоиск = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка КАК Ссылка ИЗ Справочник.Контрагенты КАК К ГДЕ (К.Наименование ПОДОБНО &Шаблон ИЛИ К.ИНН = &ИНН) И НЕ К.ПометкаУдаления");















        ЗапросПоиск.УстановитьПараметр("Шаблон", "%" + ИмяОбъекта + "%");















        ЗапросПоиск.УстановитьПараметр("ИНН", ИмяОбъекта);















        ВыбПоиск = ЗапросПоиск.Выполнить().Выбрать();















        Если ВыбПоиск.Следующий() Тогда















            СсылкаК = ВыбПоиск.Ссылка;















        КонецЕсли;















    КонецЕсли;















    















    Если Не ЗначениеЗаполнено(СсылкаК) Тогда















        Возврат "Контрагент «" + ИмяОбъекта + "» не найден в информационной базе 1С:УНФ.";















    КонецЕсли;















    















    // Сбор досье конкретного контрагента















    УИД = Строка(СсылкаК.УникальныйИдентификатор());















    ИмяК_Безопасное = СтрЗаменить(СтрЗаменить(СсылкаК.Наименование, Символ(34), ""), "'", "");















    ИНН = ?(ЗначениеЗаполнено(СсылкаК.ИНН), СсылкаК.ИНН, "не указан");















    КПП = ?(ЗначениеЗаполнено(СсылкаК.КПП), СсылкаК.КПП, "не указан");















    















    Договор = "Основной договор";















    Попытка















        ЗапросД = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Наименование КАК Наименование ИЗ Справочник.ДоговорыКонтрагентов КАК Д ГДЕ Д.Владелец = &Владелец И НЕ Д.ПометкаУдаления");















        ЗапросД.УстановитьПараметр("Владелец", СсылкаК);















        ВыборкаД = ЗапросД.Выполнить().Выбрать();















        Если ВыборкаД.Следующий() Тогда















            Договор = ВыборкаД.Наименование;















        КонецЕсли;















    Исключение















    КонецПопытки;















    















    ЯвляетсяПоставщиком = СсылкаК.Поставщик;















    ЯвляетсяПокупателем = СсылкаК.Покупатель;















    















    // Задолженность и Обороты















    Долг = 0; Оборот = 0; КолДокументов = 0;















    















    Если ЯвляетсяПоставщиком И НЕ ЯвляетсяПокупателем Тогда















        // Досье поставщика















        Попытка















            ЗапросДолг = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаОстаток), 0) КАК Долг ИЗ РегистрНакопления.РасчетыСПоставщиками.Остатки(, Контрагент = &Контрагент) КАК Р");















            ЗапросДолг.УстановитьПараметр("Контрагент", СсылкаК);















            Выб = ЗапросДолг.Выполнить().Выбрать();















            Если Выб.Следующий() Тогда Долг = Число(Выб.Долг); КонецЕсли;















        Исключение















    КонецПопытки;















        















        Попытка















            ЗапросЗакупок = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(З.СуммаДокумента), 0) КАК Оборот, КОЛИЧЕСТВО(З.Ссылка) КАК КолЗаказов ИЗ Документ.ЗаказПоставщику КАК З ГДЕ З.Контрагент = &Контрагент И З.Проведен");















            ЗапросЗакупок.УстановитьПараметр("Контрагент", СсылкаК);















            ВыбЗ = ЗапросЗакупок.Выполнить().Выбрать();















            Если ВыбЗ.Следующий() Тогда Оборот = Число(ВыбЗ.Оборот); КолДокументов = ВыбЗ.КолЗаказов; КонецЕсли;















        Исключение















    КонецПопытки;















        















        ТипТекст = "Поставщик материалов и услуг";















        БейджДолга = ?(Долг > 0, "<span class='badge-card badge-danger'>Наш долг: " + Формат(Долг, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽</span>", ?(Долг < 0, "<span class='badge-card badge-success'>Наш аванс: " + Формат(-Долг, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽</span>", "<span class='badge-card badge-success'>Взаиморасчеты закрыты (0 ₽)</span>"));















        МеткаОборота = "Объем поставок/закупок:";















        МеткаДокументов = "Заказов поставщику:";















    Иначе















        // Досье покупателя















        Попытка















            ЗапросДолг = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаОстаток), 0) КАК Долг ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки(, Контрагент = &Контрагент) КАК Р");















            ЗапросДолг.УстановитьПараметр("Контрагент", СсылкаК);















            Выб = ЗапросДолг.Выполнить().Выбрать();















            Если Выб.Следующий() Тогда Долг = Число(Выб.Долг); КонецЕсли;















        Исключение















    КонецПопытки;















        















        Попытка















            ЗапросПродаж = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(З.СуммаДокумента), 0) КАК Оборот, КОЛИЧЕСТВО(З.Ссылка) КАК КолЗаказов ИЗ Документ.ЗаказПокупателя КАК З ГДЕ З.Контрагент = &Контрагент И З.Проведен");















            ЗапросПродаж.УстановитьПараметр("Контрагент", СсылкаК);















            ВыбЗ = ЗапросПродаж.Выполнить().Выбрать();















            Если ВыбЗ.Следующий() Тогда Оборот = Число(ВыбЗ.Оборот); КолДокументов = ВыбЗ.КолЗаказов; КонецЕсли;















        Исключение















    КонецПопытки;















        















        ТипТекст = ?(ЯвляетсяПоставщиком, "Покупатель и Поставщик", "Покупатель продукции");















        БейджДолга = ?(Долг > 0, "<span class='badge-card badge-danger'>Долг покупателя: " + Формат(Долг, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽</span>", "<span class='badge-card badge-success'>Задолженности нет</span>");















        МеткаОборота = "Объем продаж:";















        МеткаДокументов = "Всего заказов:";















    КонецЕсли;















    















    IconCard = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#38bdf8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><rect x='2' y='4' width='20' height='16' rx='2'/><path d='M7 15h0M2 10h20'/></svg>";















    IconPlus = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><line x1='12' y1='5' x2='12' y2='19'/><line x1='5' y1='12' x2='19' y2='12'/></svg>";















    IconTask = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/></svg>";















    















    HTML = "<div class='table-container'>"















        + "<div style='font-size:14px;font-weight:700;margin-bottom:10px;color:#38bdf8;display:flex;align-items:center;'>"















        + IconCard + "Досье контрагента: " + СсылкаК.Наименование + " (" + ТипТекст + ")</div>"















        + "<div style='display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:12px;margin-bottom:12px;'>"















        + "<div><span class='text-muted'>ИНН / КПП:</span> " + ИНН + " / " + КПП + "</div>"















        + "<div><span class='text-muted'>Основной договор:</span> " + Договор + "</div>"















        + "<div><span class='text-muted'>" + МеткаДокументов + "</span> <b>" + Строка(КолДокументов) + " шт.</b></div>"















        + "<div><span class='text-muted'>" + МеткаОборота + "</span> <b>" + Формат(Оборот, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽</b></div>"















        + "<div style='grid-column:1/-1;'><span class='text-muted'>Текущее сальдо:</span> " + БейджДолга + "</div>"















        + "</div>"















        + "<div class='chips-container'>"















        + "<a href='#openCounterparty?ref=" + УИД + "&name=" + ИмяК_Безопасное + "' class='action-chip'>Открыть карточку 1С</a>"















        + ?(ЯвляетсяПокупателем, "<a href='#newOrderForClient?name=" + ИмяК_Безопасное + "' class='action-chip'>" + IconPlus + "Оформить заказ</a>", "<a href='#createProcureTask?name=Закупка&ref=" + УИД + "' class='action-chip'>" + IconPlus + "Заказ поставщику</a>")















        + ?(Долг > 0, "<a href='#createDebtTask?name=" + ИмяК_Безопасное + "&amount=" + Формат(Долг, "ЧГ=0; ЧДЦ=2") + "&ref=" + УИД + "' class='action-chip'>" + IconTask + "Поставить задачу в Канбан</a>", "")















        + "</div>"















        + "</div>";















    















    Возврат HTML;















КонецФункции































&НаСервере















Функция ВыполнитьАналитикуНаСервере(Вопрос)















    ТекущаяДата = ТекущаяДатаСеанса();















    НачалоПериода = НачалоДня(ТекущаяДата);















    КонецПериода = КонецДня(ТекущаяДата);















    















    // Все заказы за сегодня или оперативные















    Запрос = Новый Запрос;















    Запрос.Текст = "ВЫБРАТЬ















                   |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Заказы.Ссылка) КАК КоличествоЗаказов,















                   |    ЕСТЬNULL(СУММА(Заказы.СуммаДокумента), 0) КАК Выручка















                   |ИЗ















                   |    Документ.ЗаказПокупателя КАК Заказы















                   |ГДЕ















                   |    Заказы.Дата МЕЖДУ &НачалоПериода И &КонецПериода";















    Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);















    Запрос.УстановитьПараметр("КонецПериода", КонецПериода);















    















    Результат = Запрос.Выполнить().Выбрать();















    КолЗаказов = 0; Выручка = 0;















    Если Результат.Следующий() Тогда















        КолЗаказов = Результат.КоличествоЗаказов;















        Выручка = Результат.Выручка;















    КонецЕсли;















    















    // Если за сегодня заказов нет, берем общую сумму оперативных открытых заказов















    Если КолЗаказов = 0 Тогда















        ЗапросОпер = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(З.Ссылка) КАК Кол, ЕСТЬNULL(СУММА(З.СуммаДокумента), 0) КАК Выручка ИЗ Документ.ЗаказПокупателя КАК З ГДЕ НЕ З.ПометкаУдаления");















        ВыбОпер = ЗапросОпер.Выполнить().Выбрать();















        Если ВыбОпер.Следующий() Тогда















            КолЗаказов = ВыбОпер.Кол;















            Выручка = ВыбОпер.Выручка;















        КонецЕсли;















    КонецЕсли;















    















    // Задолженность общая















    ЗапросДолг = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаОстаток), 0) КАК ОбщийДолг ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки КАК Р ГДЕ Р.СуммаОстаток > 0");















    ВыборкаДолг = ЗапросДолг.Выполнить().Выбрать();















    ОбщийДолг = 0;















    Если ВыборкаДолг.Следующий() Тогда ОбщийДолг = ВыборкаДолг.ОбщийДолг; КонецЕсли;















    















    // Задачи Канбан















    ЗапросЗадачи = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ КОЛИЧЕСТВО(З.Ссылка) КАК КолЗадач ИЗ Задача.ЗадачаИсполнителя КАК З ГДЕ НЕ З.Выполнена");















    ВыборкаЗадачи = ЗапросЗадачи.Выполнить().Выбрать();















    КолЗадач = 0;















    Если ВыборкаЗадачи.Следующий() Тогда КолЗадач = ВыборкаЗадачи.КолЗадач; КонецЕсли;















    















    IconChart = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#38bdf8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><line x1='18' y1='20' x2='18' y2='10'/><line x1='12' y1='20' x2='12' y2='4'/><line x1='6' y1='20' x2='6' y2='14'/></svg>";















    IconBoard = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><rect x='3' y='3' width='18' height='18' rx='2'/><path d='M9 3v18'/><path d='M15 3v18'/></svg>";















    IconCart = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><circle cx='9' cy='21' r='1'/><circle cx='20' cy='21' r='1'/><path d='M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6'/></svg>";















    















    HTML = "<div class='table-container' style='padding:14px;border:1px solid #0284c7;'>"















        + "<div style='font-size:14px;font-weight:700;margin-bottom:12px;color:#38bdf8;display:flex;align-items:center;'>"















        + IconChart + "Сводка ключевых показателей компании за сегодня (" + Формат(ТекущаяДата, "ДФ=dd.MM.yyyy") + ")</div>"















        + "<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:12px;margin-bottom:12px;'>"















        + "<div style='background:#1e293b;padding:8px 12px;border-radius:6px;border:1px solid #334155;'><div style='color:#94a3b8;'>Выручка за день:</div><div style='font-size:16px;font-weight:700;color:#38bdf8;'>" + Формат(Выручка, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽</div></div>"















        + "<div style='background:#1e293b;padding:8px 12px;border-radius:6px;border:1px solid #334155;'><div style='color:#94a3b8;'>Заказов оформлено:</div><div style='font-size:16px;font-weight:700;color:#f8fafc;'>" + Строка(КолЗаказов) + " шт.</div></div>"















        + "<div style='background:#1e293b;padding:8px 12px;border-radius:6px;border:1px solid #334155;'><div style='color:#94a3b8;'>Дебиторский долг:</div><div style='font-size:16px;font-weight:700;color:#f87171;'>" + Формат(ОбщийДолг, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽</div></div>"















        + "<div style='background:#1e293b;padding:8px 12px;border-radius:6px;border:1px solid #334155;'><div style='color:#94a3b8;'>Задач в работе (Канбан):</div><div style='font-size:16px;font-weight:700;color:#fbbf24;'>" + Строка(КолЗадач) + " шт.</div></div>"















        + "</div>"















        + "<div class='chips-container'>"















        + "<a href='#openOrdersList' class='action-chip'>" + IconCart + "Заказы за сегодня</a>"















        + "<a href='#openKanban' class='action-chip'>" + IconBoard + "Перейти в Канбан</a>"















        + "</div>"















        + "</div>";















    















    Возврат HTML;















КонецФункции































&НаСервере















Функция ПолучитьСтатусДокументаНаСервере(ТипОбъекта, Номер)















    Ссылка = НайтиСсылкуНаОбъектНаСервере(ТипОбъекта, Номер);















    Если НЕ ЗначениеЗаполнено(Ссылка) Тогда















        Возврат "Документ с номером «" + Номер + "» не найден в базе данных.";















    КонецЕсли;















    















    Попытка















        Объект = Ссылка.ПолучитьОбъект();















        Статус = ?(Объект.Проведен, "**ПРОВЕДЕН**", "**НЕ ПРОВЕДЕН (Черновик)**");















        Сумма = ?(Объект.Метаданные().Реквизиты.Найти("СуммаДокумента") <> Неопределено, Объект.СуммаДокумента, 0);















        















        Текст = "**" + Строка(Ссылка) + "**" + Символы.ПС















            + "- Статус: " + Статус + Символы.ПС















            + "- Дата: " + Формат(Объект.Дата, "ДЛФ=D") + Символы.ПС;















        Если Сумма > 0 Тогда















            Текст = Текст + "- Сумма: **" + Формат(Сумма, "ЧЦ=15; ЧДЦ=2") + " руб.**" + Символы.ПС;















        КонецЕсли;















        Возврат Текст;















    Исключение















        Возврат "Ошибка чтения статуса: " + ОписаниеОшибки();















    КонецПопытки;















КонецФункции































&НаСервере















Функция НайтиСсылкуНаОбъектНаСервере(ПолноеИмя, НомерСтрокой)















    Части = СтрРазделить(ПолноеИмя, ".");















    Если Части.Количество() < 2 Тогда















        Возврат Неопределено;















    КонецЕсли;















    















    Вид = Части[0];















    Имя = Части[1];















    















    Попытка















        Если Вид = "Документ" Тогда















            Ссылка = Документы[Имя].НайтиПоНомеру(НомерСтрокой);















            Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;















            















            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ." + Имя + " ГДЕ Номер ПОДОБНО &Номер");















            Запрос.УстановитьПараметр("Номер", "%" + НомерСтрокой);















            Выборка = Запрос.Выполнить().Выбрать();















            Если Выборка.Следующий() Тогда Возврат Выборка.Ссылка; КонецЕсли;















        ИначеЕсли Вид = "Справочник" Тогда















            Возврат Справочники[Имя].НайтиПоКоду(НомерСтрокой);















        КонецЕсли;















    Исключение















        Возврат Неопределено;















    КонецПопытки;















    Возврат Неопределено;















КонецФункции































&НаСервере















Функция НайтиСотрудникаНаСервере(Имя)















    Возврат Справочники.Сотрудники.НайтиПоНаименованию(Имя, Истина);















КонецФункции































