&НаСервере
Функция НайтиСотрудникаНаСервере(Имя)
    Возврат Справочники.Сотрудники.НайтиПоНаименованию(Имя, Истина);
КонецФункции

&НаСервере
Функция СобратьДосьеНаСервере(ТипОбъекта, ИмяОбъекта)
    Если СтрНайти(ТипОбъекта, "Контрагенты") > 0 Тогда
        ЗапрПоиск = Новый Запрос;
        ЗапрПоиск.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Контрагенты ГДЕ Наименование ПОДОБНО &П И НЕ ПометкаУдаления";
        ЗапрПоиск.УстановитьПараметр("П", "%" + ИмяОбъекта + "%");
        Попытка
            ВыбПоиск = ЗапрПоиск.Выполнить().Выбрать();
            Если НЕ ВыбПоиск.Следующий() Тогда Возврат "Контрагент '" + ИмяОбъекта + "' не найден."; КонецЕсли;
            Ссылка = ВыбПоиск.Ссылка;
        Исключение
            Ссылка = Справочники.Контрагенты.НайтиПоНаименованию(ИмяОбъекта, Ложь);
            Если НЕ ЗначениеЗаполнено(Ссылка) Тогда Возврат "Контрагент '" + ИмяОбъекта + "' не найден."; КонецЕсли;
        КонецПопытки;
        
        Текст = "=== " + Ссылка.Наименование + " ===" + Символы.ПС;
        
        ДолгНайден = Ложь;
        Для Каждого МетаРег Из Метаданные.РегистрыНакопления Цикл
            Если МетаРег.ВидРегистра <> Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда Продолжить; КонецЕсли;
            ИмяВерх = ВРег(МетаРег.Имя);
            Если НЕ (СтрНайти(ИмяВерх, "ВЗАИМО") > 0 ИЛИ СтрНайти(ИмяВерх, "РАСЧЕТ") > 0) Тогда Продолжить; КонецЕсли;
            ИзмКонтрагент = Неопределено;
            Для Каждого Изм Из МетаРег.Измерения Цикл
                Если ВРег(Изм.Имя) = "КОНТРАГЕНТ" ИЛИ ВРег(Изм.Имя) = "ПАРТНЕР" Тогда ИзмКонтрагент = Изм.Имя; Прервать; КонецЕсли;
            КонецЦикла;
            Если ИзмКонтрагент = Неопределено Тогда Продолжить; КонецЕсли;
            ПоляОстатка = Новый Массив;
            Для Каждого Рес Из МетаРег.Ресурсы Цикл ПоляОстатка.Добавить(Рес.Имя + "Остаток"); КонецЦикла;
            Если ПоляОстатка.Количество() = 0 Тогда ПоляОстатка.Добавить("СуммаОстаток"); КонецЕсли;
            ПоляОстатка.Добавить("Остаток");
            Для Каждого ПолеОст Из ПоляОстатка Цикл
                Запрос = Новый Запрос;
                Запрос.Текст = "ВЫБРАТЬ СУММА(" + ПолеОст + ") КАК Долг ИЗ РегистрНакопления." + МетаРег.Имя + ".Остатки(, " + ИзмКонтрагент + " = &К)";
                Запрос.УстановитьПараметр("К", Ссылка);
                Попытка
                    Выборка = Запрос.Выполнить().Выбрать();
                    Если Выборка.Следующий() И Выборка.Долг <> Неопределено И Выборка.Долг <> 0 Тогда
                        Множитель = 1;
                        Если СтрНайти(ВРег(МетаРег.Имя), "ПОСТАВ") = 0 Тогда
                            Множитель = -1;
                        КонецЕсли;
                        ДолгЗнак = Выборка.Долг * Множитель;
                        Если ДолгЗнак < 0 Тогда
                            Текст = Текст + "Текущий долг: " + Формат(-ДолгЗнак, "ЧЦ=15; ЧДЦ=2") + " руб. (должны нам)" + Символы.ПС;
                        Иначе
                            Текст = Текст + "Наша задолженность: " + Формат(ДолгЗнак, "ЧЦ=15; ЧДЦ=2") + " руб. (мы должны)" + Символы.ПС;
                        КонецЕсли;
                        ДолгНайден = Истина; Прервать;
                    КонецЕсли;
                Исключение КонецПопытки;
            КонецЦикла;
            Если ДолгНайден Тогда Прервать; КонецЕсли;
        КонецЦикла;
        Если НЕ ДолгНайден Тогда Текст = Текст + "Долг: 0 руб. (нет задолженности)" + Символы.ПС; КонецЕсли;

        Запрос2 = Новый Запрос;
        Запрос2.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, Дата ИЗ Документ.ЗаказПокупателя ГДЕ Контрагент = &К УПОРЯДОЧИТЬ ПО Дата УБЫВ";
        Запрос2.УстановитьПараметр("К", Ссылка);
        Попытка
            Выборка2 = Запрос2.Выполнить().Выбрать();
            Если Выборка2.Следующий() Тогда
                Текст = Текст + "Последний заказ: №" + Выборка2.Ссылка.Номер + " от " + Формат(Выборка2.Дата, "ДЛФ=D") + Символы.ПС;
            КонецЕсли;
        Исключение
            Сообщить("СобратьДосьеНаСервере: ошибка запроса последнего заказа: " + ОписаниеОшибки(), СтатусСообщения.Внимание);
        КонецПопытки;
        Возврат Текст;
        
    ИначеЕсли СтрНайти(ТипОбъекта, "Номенклатура") > 0 ИЛИ СтрНайти(ТипОбъекта, "Товар") > 0 Тогда
        ЗапрПоиск = Новый Запрос;
        ЗапрПоиск.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, Наименование ИЗ Справочник.Номенклатура ГДЕ Наименование ПОДОБНО &П И НЕ ПометкаУдаления";
        ЗапрПоиск.УстановитьПараметр("П", "%" + ИмяОбъекта + "%");
        Попытка
            ВыбПоиск = ЗапрПоиск.Выполнить().Выбрать();
            Если НЕ ВыбПоиск.Следующий() Тогда Возврат "Товар '" + ИмяОбъекта + "' не найден."; КонецЕсли;
            Ссылка = ВыбПоиск.Ссылка;
        Исключение
            Возврат "Ошибка поиска товара.";
        КонецПопытки;
        Текст = "=== " + Ссылка.Наименование + " ===" + Символы.ПС;
        Текст = Текст + ПолучитьОстаткиТовараНаСервере(Ссылка.Наименование) + Символы.ПС;
        Возврат Текст;
    КонецЕсли;
    Возврат "Сбор досье для типа '" + ТипОбъекта + "' пока не поддерживается.";
КонецФункции

&НаСервере
Функция ВыполнитьАналитикуНаСервере(Вопрос)
    Результат = "Не удалось выполнить расчет.";
    ВопросНижн = НРег(Вопрос);
    Дбазовое = ТекущаяДата(); Д1 = НачалоДня(Дбазовое); Д2 = КонецДня(Дбазовое); МеткаПериода = "за сегодня";
    Если СтрНайти(ВопросНижн, "недел") > 0 Тогда Д1 = НачалоНедели(Дбазовое); Д2 = КонецНедели(Дбазовое); МеткаПериода = "за эту неделю";
    ИначеЕсли СтрНайти(ВопросНижн, "месяц") > 0 Тогда Д1 = НачалоМесяца(Дбазовое); Д2 = КонецМесяца(Дбазовое); МеткаПериода = "за этот месяц";
    ИначеЕсли СтрНайти(ВопросНижн, "год") > 0 Тогда Д1 = НачалоГода(Дбазовое); Д2 = КонецГода(Дбазовое); МеткаПериода = "за этот год";
    КонецЕсли;

    Если СтрНайти(ВопросНижн, "прода") > 0 ИЛИ СтрНайти(ВопросНижн, "выручк") > 0 Тогда
        СуммаИтог = 0; КолДокИтог = 0; Нашли = Ложь;
        ИменаДокПродаж = Новый Массив;
        ИменаДокПродаж.Добавить("РасходнаяНакладная");
        ИменаДокПродаж.Добавить("РеализацияТоваровУслуг");
        ИменаДокПродаж.Добавить("ОтгрузкаТоваров");
        ИменаДокПродаж.Добавить("Продажа");
        Для Каждого МетаДок Из Метаданные.Документы Цикл
            ИмяВерх = ВРег(МетаДок.Имя);
            Если (СтрНайти(ИмяВерх, "РЕАЛИЗАЦИ") > 0 ИЛИ СтрНайти(ИмяВерх, "РАСХОД") > 0 ИЛИ СтрНайти(ИмяВерх, "ОТГРУЗК") > 0 ИЛИ СтрНайти(ИмяВерх, "ПРОДАЖ") > 0)
                И МетаДок.Реквизиты.Найти("СуммаДокумента") <> Неопределено Тогда
                Если ИменаДокПродаж.Найти(МетаДок.Имя) = Неопределено Тогда ИменаДокПродаж.Добавить(МетаДок.Имя); КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Для Каждого ИмяДок Из ИменаДокПродаж Цикл
            Запрос = Новый Запрос; Запрос.УстановитьПараметр("Д1", Д1); Запрос.УстановитьПараметр("Д2", Д2);
            Запрос.Текст = "ВЫБРАТЬ СУММА(СуммаДокумента) КАК Сумма, КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Ссылка) КАК КолДок ИЗ Документ." + ИмяДок + " ГДЕ Дата МЕЖДУ &Д1 И &Д2 И Проведен";
            Попытка
                Выборка = Запрос.Выполнить().Выбрать();
                Если Выборка.Следующий() Тогда
                    Сумм = ?(Выборка.Сумма=Неопределено,0,Выборка.Сумма); КолДок = ?(Выборка.КолДок=Неопределено,0,Выборка.КолДок);
                    СуммаИтог = СуммаИтог + Сумм; КолДокИтог = КолДокИтог + КолДок; Нашли = Истина;
                КонецЕсли;
            Исключение КонецПопытки;
        КонецЦикла;
        Если Нашли Тогда
            Результат = "Продажи " + МеткаПериода + ":" + Символы.ПС + "  Сумма: " + Формат(СуммаИтог,"ЧЦ=15;ЧДЦ=2") + " руб." + Символы.ПС + "  Документов: " + Строка(КолДокИтог);
        КонецЕсли;
    ИначеЕсли СтрНайти(ВопросНижн, "закуп") > 0 ИЛИ СтрНайти(ВопросНижн, "приход") > 0 Тогда
        СуммаИтог = 0; Нашли = Ложь;
        ИменаДокЗакуп = Новый Массив;
        ИменаДокЗакуп.Добавить("ПриходнаяНакладная");
        ИменаДокЗакуп.Добавить("ПоступлениеТоваровУслуг");
        ИменаДокЗакуп.Добавить("ПоступлениеТоваров");
        Для Каждого МетаДок Из Метаданные.Документы Цикл
            ИмяВерх = ВРег(МетаДок.Имя);
            Если (СтрНайти(ИмяВерх, "ПОСТУПЛ") > 0 ИЛИ СтрНайти(ИмяВерх, "ПРИХОД") > 0)
                И МетаДок.Реквизиты.Найти("СуммаДокумента") <> Неопределено Тогда
                Если ИменаДокЗакуп.Найти(МетаДок.Имя) = Неопределено Тогда ИменаДокЗакуп.Добавить(МетаДок.Имя); КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Для Каждого ИмяДок Из ИменаДокЗакуп Цикл
            Запрос = Новый Запрос; Запрос.УстановитьПараметр("Д1", Д1); Запрос.УстановитьПараметр("Д2", Д2);
            Запрос.Текст = "ВЫБРАТЬ СУММА(СуммаДокумента) КАК Сумма ИЗ Документ." + ИмяДок + " ГДЕ Дата МЕЖДУ &Д1 И &Д2 И Проведен";
            Попытка
                Выборка = Запрос.Выполнить().Выбрать();
                Если Выборка.Следующий() Тогда
                    СуммаИтог = СуммаИтог + ?(Выборка.Сумма=Неопределено,0,Выборка.Сумма); Нашли = Истина;
                КонецЕсли;
            Исключение КонецПопытки;
        КонецЦикла;
        Если Нашли Тогда
            Результат = "Закупки " + МеткаПериода + ": " + Формат(СуммаИтог,"ЧЦ=15;ЧДЦ=2") + " руб.";
        КонецЕсли;
    КонецЕсли;
    Возврат Результат;
КонецФункции

&НаСервере
Функция ПолучитьСтатусДокументаНаСервере(ТипОбъекта, Номер)
    Ссылка = НайтиСсылкуНаОбъектНаСервере(ТипОбъекта, Номер);
    Если Ссылка = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Ссылка) Тогда Возврат "Документ №" + Номер + " не найден."; КонецЕсли;
    Попытка
        ДокОбъект = Ссылка.ПолучитьОбъект();
        Текст = ?(ДокОбъект.Проведен, "✅ ", "⚠️ ") + Строка(Ссылка) + ?(ДокОбъект.Проведен, " — ПРОВЕДЁН", " — Не проведён") + Символы.ПС;
        Текст = Текст + "Дата: " + Формат(ДокОбъект.Дата, "ДЛФ=D");
        Если ДокОбъект.Метаданные().Реквизиты.Найти("СуммаДокумента") <> Неопределено Тогда
            Текст = Текст + Символы.ПС + "Сумма: " + Формат(ДокОбъект.СуммаДокумента,"ЧЦ=15;ЧДЦ=2") + " руб.";
        КонецЕсли;
        Возврат Текст;
    Исключение
        Возврат "Не удалось получить данные: " + ОписаниеОшибки();
    КонецПопытки;
КонецФункции

&НаСервере
Функция ПолучитьОстаткиТовараНаСервере(ТоварИмя)
    ЗапрПоиск = Новый Запрос;
    ЗапрПоиск.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, Наименование ИЗ Справочник.Номенклатура ГДЕ Наименование ПОДОБНО &Паттерн И НЕ ПометкаУдаления И НЕ ЭтоГруппа";
    ЗапрПоиск.УстановитьПараметр("Паттерн", "%" + ТоварИмя + "%");
    Попытка
        ВыбПоиск = ЗапрПоиск.Выполнить().Выбрать();
        Если НЕ ВыбПоиск.Следующий() Тогда Возврат "Товар '" + ТоварИмя + "' не найден."; КонецЕсли;
        Ссылка = ВыбПоиск.Ссылка;
    Исключение
        Возврат "Ошибка поиска: " + ОписаниеОшибки();
    КонецПопытки;

    ИзмНоменклатура = "Номенклатура";
    Для Каждого МетаРег Из Метаданные.РегистрыНакопления Цикл
        Если МетаРег.ВидРегистра <> Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда Продолжить; КонецЕсли;
        ИмяВерх = ВРег(МетаРег.Имя);
        ЭтоЗапасы = СтрНайти(ИмяВерх, "ЗАПАС") > 0 ИЛИ СтрНайти(ИмяВерх, "ОСТАТ") > 0 ИЛИ СтрНайти(ИмяВерх, "СКЛАД") > 0;
        Если НЕ ЭтоЗапасы Тогда Продолжить; КонецЕсли;
        ИзмНом = Неопределено;
        Для Каждого Изм Из МетаРег.Измерения Цикл
            Если ВРег(Изм.Имя) = "НОМЕНКЛАТУРА" ИЛИ ВРег(Изм.Имя) = "ТОВАР" ИЛИ ВРег(Изм.Имя) = "НOMЕНКЛАТУРА" Тогда
                ИзмНом = Изм.Имя; Прервать;
            КонецЕсли;
        КонецЦикла;
        Если ИзмНом = Неопределено Тогда Продолжить; КонецЕсли;

        ПоляКолОст = Новый Массив;
        Для Каждого Рес Из МетаРег.Ресурсы Цикл
            Если ВРег(Рес.Имя) = "КОЛИЧЕСТВО" ИЛИ СтрНайти(ВРег(Рес.Имя), "КОЛ") > 0 Тогда
                ПоляКолОст.Добавить(Рес.Имя + "Остаток");
            КонецЕсли;
        КонецЦикла;
        Если ПоляКолОст.Количество() = 0 Тогда ПоляКолОст.Добавить("КоличествоОстаток"); КонецЕсли;

        Для Каждого ПолеКол Из ПоляКолОст Цикл
            Запрос = Новый Запрос; Запрос.УстановитьПараметр("Н", Ссылка);
            Запрос.Текст = "ВЫБРАТЬ СУММА(" + ПолеКол + ") КАК КолОст ИЗ РегистрНакопления." + МетаРег.Имя + ".Остатки(, " + ИзмНом + " = &Н)";
            Попытка
                Выборка = Запрос.Выполнить().Выбрать();
                Если Выборка.Следующий() Тогда
                    Кол = ?(Выборка.КолОст=Неопределено,0,Выборка.КолОст);
                    Возврат "'" + Ссылка.Наименование + "' — остаток: " + Формат(Кол,"ЧДЦ=3") + " ед.";
                КонецЕсли;
            Исключение КонецПопытки;
        КонецЦикла;
    КонецЦикла;
    Возврат "Не удалось найти регистр остатков для '" + ТоварИмя + "'.";
КонецФункции

&НаСервере
Функция ПолучитьСписокДолжниковНаСервере()
    ТаблицаИтог = Новый ТаблицаЗначений;
    ТаблицаИтог.Колонки.Добавить("Контрагент");
    ТаблицаИтог.Колонки.Добавить("ДолгНам");
    ТаблицаИтог.Колонки.Добавить("НашДолг");

    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	Расчеты.Контрагент КАК Контрагент,
        |	СУММА(Расчеты.ДолгНам) КАК ДолгНам,
        |	СУММА(Расчеты.НашДолг) КАК НашДолг
        |ИЗ
        |	(ВЫБРАТЬ
        |		РасчетыСПокупателямиОстатки.Контрагент КАК Контрагент,
        |		ВЫБОР
        |			КОГДА РасчетыСПокупателямиОстатки.СуммаОстаток > 0
        |				ТОГДА РасчетыСПокупателямиОстатки.СуммаОстаток
        |			ИНАЧЕ 0
        |		КОНЕЦ КАК ДолгНам,
        |		ВЫБОР
        |			КОГДА РасчетыСПокупателямиОстатки.СуммаОстаток < 0
        |				ТОГДА -РасчетыСПокупателямиОстатки.СуммаОстаток
        |			ИНАЧЕ 0
        |		КОНЕЦ КАК НашДолг
        |	ИЗ
        |		РегистрНакопления.РасчетыСПокупателями.Остатки КАК РасчетыСПокупателямиОстатки
        |	
        |	ОБЪЕДИНИТЬ ВСЕ
        |	
        |	ВЫБРАТЬ
        |		РасчетыСПоставщикамиОстатки.Контрагент,
        |		ВЫБОР
        |			КОГДА РасчетыСПоставщикамиОстатки.СуммаОстаток < 0
        |				ТОГДА -РасчетыСПоставщикамиОстатки.СуммаОстаток
        |			ИНАЧЕ 0
        |		КОНЕЦ,
        |		ВЫБОР
        |			КОГДА РасчетыСПоставщикамиОстатки.СуммаОстаток > 0
        |				ТОГДА РасчетыСПоставщикамиОстатки.СуммаОстаток
        |			ИНАЧЕ 0
        |		КОНЕЦ
        |	ИЗ
        |		РегистрНакопления.РасчетыСПоставщиками.Остатки КАК РасчетыСПоставщикамиОстатки
        |	
        |	ОБЪЕДИНИТЬ ВСЕ
        |	
        |	ВЫБРАТЬ
        |		РасчетыСПрочимиКонтрагентамиОстатки.Контрагент,
        |		ВЫБОР
        |			КОГДА РасчетыСПрочимиКонтрагентамиОстатки.СуммаОстаток > 0
        |				ТОГДА РасчетыСПрочимиКонтрагентамиОстатки.СуммаОстаток
        |			ИНАЧЕ 0
        |		КОНЕЦ,
        |		ВЫБОР
        |			КОГДА РасчетыСПрочимиКонтрагентамиОстатки.СуммаОстаток < 0
        |				ТОГДА -РасчетыСПрочимиКонтрагентамиОстатки.СуммаОстаток
        |			ИНАЧЕ 0
        |		КОНЕЦ
        |	ИЗ
        |		РегистрНакопления.РасчетыСПрочимиКонтрагентами.Остатки КАК РасчетыСПрочимиКонтрагентамиОстатки) КАК Расчеты
        |ГДЕ
        |	Расчеты.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
        |
        |СГРУППИРОВАТЬ ПО
        |	Расчеты.Контрагент";

    Попытка
        РезультатЗапроса = Запрос.Выполнить();
        Если НЕ РезультатЗапроса.Пустой() Тогда
            Выборка = РезультатЗапроса.Выбрать();
            Пока Выборка.Следующий() Цикл
                Если Выборка.ДолгНам = 0 И Выборка.НашДолг = 0 Тогда
                    Продолжить;
                КонецЕсли;
                Если Окр(Выборка.ДолгНам, 2) = 0 И Окр(Выборка.НашДолг, 2) = 0 Тогда
                    Продолжить;
                КонецЕсли;
                
                НовСтр = ТаблицаИтог.Добавить();
                НовСтр.Контрагент = Строка(Выборка.Контрагент);
                НовСтр.ДолгНам = Выборка.ДолгНам;
                НовСтр.НашДолг = Выборка.НашДолг;
            КонецЦикла;
        КонецЕсли;
    Исключение
        Сообщить("Ошибка получения списка должников: " + ОписаниеОшибки(), СтатусСообщения.Внимание);
    КонецПопытки;

    Если ТаблицаИтог.Количество() = 0 Тогда
        Возврат "Должников не обнаружено — все расчёты в норме.";
    КонецЕсли;

    ИтогоДолгНам = 0; ИтогоНашДолг = 0;
    Для Каждого Стр Из ТаблицаИтог Цикл
        ИтогоДолгНам = ИтогоДолгНам + Стр.ДолгНам;
        ИтогоНашДолг = ИтогоНашДолг + Стр.НашДолг;
    КонецЦикла;

    Текст = "";
    Если ИтогоДолгНам > 0 Тогда
        ТаблицаСортД = Новый ТаблицаЗначений;
        ТаблицаСортД.Колонки.Добавить("Контрагент");
        ТаблицаСортД.Колонки.Добавить("Сумма");
        Для Каждого Стр Из ТаблицаИтог Цикл
            Если Стр.ДолгНам > 0 Тогда
                НС = ТаблицаСортД.Добавить();
                НС.Контрагент = Стр.Контрагент;
                НС.Сумма = Стр.ДолгНам;
            КонецЕсли;
        КонецЦикла;
        ТаблицаСортД.Сортировать("Сумма Убыв");
        Текст = "Должники (должны нам):" + Символы.ПС; Ном = 1;
        Для Каждого Стр Из ТаблицаСортД Цикл
            Если Ном > 10 Тогда Прервать; КонецЕсли;
            Текст = Текст + "  " + Ном + ". " + Стр.Контрагент + " — " + Формат(Стр.Сумма,"ЧЦ=15;ЧДЦ=2") + " руб." + Символы.ПС; Ном = Ном + 1;
        КонецЦикла;
        Текст = Текст + "  ──────────" + Символы.ПС + "  ИТОГО: " + Формат(ИтогоДолгНам,"ЧЦ=15;ЧДЦ=2") + " руб." + Символы.ПС;
    КонецЕсли;

    Если ИтогоНашДолг > 0 Тогда
        ТаблицаСортК = Новый ТаблицаЗначений;
        ТаблицаСортК.Колонки.Добавить("Контрагент");
        ТаблицаСортК.Колонки.Добавить("Сумма");
        Для Каждого Стр Из ТаблицаИтог Цикл
            Если Стр.НашДолг > 0 Тогда
                НС = ТаблицаСортК.Добавить();
                НС.Контрагент = Стр.Контрагент;
                НС.Сумма = Стр.НашДолг;
            КонецЕсли;
        КонецЦикла;
        ТаблицаСортК.Сортировать("Сумма Убыв");
        Текст = Текст + "Наша задолженность (мы должны):" + Символы.ПС; Ном = 1;
        Для Каждого Стр Из ТаблицаСортК Цикл
            Если Ном > 10 Тогда Прервать; КонецЕсли;
            Текст = Текст + "  " + Ном + ". " + Стр.Контрагент + " — " + Формат(Стр.Сумма,"ЧЦ=15;ЧДЦ=2") + " руб." + Символы.ПС; Ном = Ном + 1;
        КонецЦикла;
        Текст = Текст + "  ──────────" + Символы.ПС + "  ИТОГО: " + Формат(ИтогоНашДолг,"ЧЦ=15;ЧДЦ=2") + " руб." + Символы.ПС;
    КонецЕсли;

    Текст = Текст + "Сальдо: " + Формат(ИтогоДолгНам - ИтогоНашДолг,"ЧЦ=15;ЧДЦ=2") + " руб.";

    Если ИтогоДолгНам = 0 И ИтогоНашДолг = 0 Тогда
        Возврат "Должников не обнаружено — все расчёты в норме.";
    КонецЕсли;
    Возврат Текст;
КонецФункции

&НаСервере
Функция НайтиСсылкуНаОбъектНаСервере(ПолноеИмя, НомерСтрокой)
    ЧастиИмени = СтрРазделить(ПолноеИмя, ".");
    Если ЧастиИмени.Количество() < 2 Тогда Возврат Неопределено; КонецЕсли;
    Вид = ЧастиИмени[0]; Имя = ЧастиИмени[1];
    Попытка
        Если Вид = "Документ" Тогда
            НайденнаяСсылка = Документы[Имя].НайтиПоНомеру(НомерСтрокой);
            Если ЗначениеЗаполнено(НайденнаяСсылка) Тогда Возврат НайденнаяСсылка; КонецЕсли;
            Запрос = Новый Запрос;
            Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ." + Имя + " ГДЕ Номер ПОДОБНО &НомерСпец";
            Запрос.УстановитьПараметр("НомерСпец", "%" + НомерСтрокой);
            Выборка = Запрос.Выполнить().Выбрать();
            Если Выборка.Следующий() Тогда Возврат Выборка.Ссылка; КонецЕсли;
        ИначеЕсли Вид = "Справочник" Тогда
            Возврат Справочники[Имя].НайтиПоКоду(НомерСтрокой);
        КонецЕсли;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
    Возврат Неопределено;
КонецФункции

&НаСервере
Функция ПодготовитьДанныеЗаполненияНаСервере(ТипОбъекта, ПоляJSON)
    Результат = Новый Структура("ЗначенияЗаполнения", Новый Структура);
    Значения = Результат.ЗначенияЗаполнения;
    ИмяКлиента = "";
    Если ПоляJSON.Свойство("Client", ИмяКлиента) И ЗначениеЗаполнено(ИмяКлиента) Тогда
        Ссылка = Справочники.Контрагенты.НайтиПоНаименованию(ИмяКлиента, Истина);
        Если ЗначениеЗаполнено(Ссылка) Тогда
            Значения.Вставить("Контрагент", Ссылка); Значения.Вставить("Покупатель", Ссылка);
        Иначе
            Результат.Вставить("НеНайденКлиент", Новый Структура("Наименование, НаименованиеПолное", ИмяКлиента, ИмяКлиента));
            Возврат Результат;
        КонецЕсли;
    КонецЕсли;
    Коммент = "";
    Если ПоляJSON.Свойство("Comment", Коммент) Тогда Значения.Вставить("Комментарий", Коммент); КонецЕсли;
    Товар = ""; Количество = 0;
    ПоляJSON.Свойство("Item", Товар); ПоляJSON.Свойство("Quantity", Количество);
    Если Количество > 0 Тогда Значения.Вставить("_КоличествоЗаказа", Количество); КонецЕсли;
    Если ЗначениеЗаполнено(Товар) Тогда
        ТекстТовара = "Бот: " + Товар + " (" + Количество + " шт.)";
        Если Значения.Свойство("Комментарий") Тогда Значения.Комментарий = Значения.Комментарий + Символы.ПС + ТекстТовара;
        Иначе Значения.Вставить("Комментарий", ТекстТовара); КонецЕсли;
        СсылкаТовар = Справочники.Номенклатура.НайтиПоНаименованию(Товар, Истина);
        ЕдИзм = ""; СсылкаЕд = Неопределено;
        Если ПоляJSON.Свойство("Unit", ЕдИзм) И ЗначениеЗаполнено(ЕдИзм) Тогда
            СсылкаЕд = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(ЕдИзм, Истина);
        КонецЕсли;
        Если ЗначениеЗаполнено(СсылкаТовар) Тогда
            СтрокаТЧ = Новый Структура; СтрокаТЧ.Вставить("Номенклатура", СсылкаТовар);
            СтрокаТЧ.Вставить("Количество", ?(Количество=0, 1, Количество));
            Если ЗначениеЗаполнено(СсылкаЕд) Тогда СтрокаТЧ.Вставить("ЕдиницаИзмерения", СсылкаЕд); КонецЕсли;
            МассивСтрок = Новый Массив; МассивСтрок.Добавить(СтрокаТЧ);
            Значения.Вставить("Товары", МассивСтрок); Значения.Вставить("Запасы", МассивСтрок);
            Значения.Вставить("Услуги", МассивСтрок); Значения.Вставить("Номенклатура", СсылкаТовар);
        Иначе
            ДанныеНового = Новый Структура("Наименование", Товар);
            Если ЗначениеЗаполнено(СсылкаЕд) Тогда ДанныеНового.Вставить("ЕдиницаИзмерения", СсылкаЕд); КонецЕсли;
            Результат.Вставить("НеНайденТовар", ДанныеНового);
        КонецЕсли;
    КонецЕсли;
    Сумма = 0;
    Если ПоляJSON.Свойство("Amount", Сумма) Тогда
        Если ТипОбъекта = "Документ.ПлатежноеПоручение" Тогда Значения.Вставить("СуммаДокумента", Сумма);
        Иначе Значения.Вставить("Сумма", Сумма); КонецЕсли;
    КонецЕсли;
    БанкСчет = "";
    Если ПоляJSON.Свойство("BankAccount", БанкСчет) Тогда
        СсылкаСчет = Справочники.БанковскиеСчета.НайтиПоНаименованию(БанкСчет, Истина);
        Если ЗначениеЗаполнено(СсылкаСчет) Тогда Значения.Вставить("БанковскийСчет", СсылкаСчет); КонецЕсли;
    КонецЕсли;
    СкладИмя = "";
    Если ПоляJSON.Свойство("Warehouse", СкладИмя) Тогда
        СсылкаСклад = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию(СкладИмя, Истина);
        Если ЗначениеЗаполнено(СсылкаСклад) Тогда 
            Значения.Вставить("Склад", СсылкаСклад); 
            Значения.Вставить("СкладПолучатель", СсылкаСклад);
            Значения.Вставить("СтруктурнаяЕдиница", СсылкаСклад);
            Значения.Вставить("СтруктурнаяЕдиницаПолучатель", СсылкаСклад);
            Значения.Вставить("СтруктурнаяЕдиницаПродажи", СсылкаСклад);
            Значения.Вставить("СтруктурнаяЕдиницаРезерв", СсылкаСклад);
        КонецЕсли;
    КонецЕсли;
    Возврат Результат;
КонецФункции

&НаСервере
Функция ЭкранироватьHTML(Текст)
    Возврат ШЭкранироватьHTML(Текст);
КонецФункции

