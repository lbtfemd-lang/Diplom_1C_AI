        |   Н.Наименование КАК Наименование,















        |   Н.Артикул КАК Артикул,















        |   Н.ЕдиницаИзмерения.Наименование КАК ЕдИзм,















        |   ЕСТЬNULL(СУММА(З.КоличествоОстаток), 0) КАК Остаток,















        |   ЕСТЬNULL(Ц.Цена, 0) КАК Цена















        |ИЗ















        |   Справочник.Номенклатура КАК Н















        |   ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Запасы.Остатки(, ) КАК З















        |       ПО З.Номенклатура = Н.Ссылка















        |   ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ) КАК Ц















        |       ПО Ц.Номенклатура = Н.Ссылка















        |ГДЕ















        |   (Н.Наименование ПОДОБНО &Паттерн ИЛИ Н.Артикул ПОДОБНО &Паттерн)















        |   И НЕ Н.ПометкаУдаления И НЕ Н.ЭтоГруппа















        |СГРУППИРОВАТЬ ПО















        |   Н.Ссылка, Н.Наименование, Н.Артикул, Н.ЕдиницаИзмерения.Наименование, Ц.Цена";















    Запрос.УстановитьПараметр("Паттерн", "%" + ИмяТовара + "%");















    















    Выборка = Неопределено;















    Попытка















        Выборка = Запрос.Выполнить().Выбрать();















    Исключение















        Попытка















            Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Н.Ссылка КАК Номенклатура, Н.Наименование КАК Наименование, Н.Артикул КАК Артикул, Н.ЕдиницаИзмерения.Наименование КАК ЕдИзм, 0 КАК Остаток, 0 КАК Цена ИЗ Справочник.Номенклатура КАК Н ГДЕ (Н.Наименование ПОДОБНО &Паттерн) И НЕ Н.ПометкаУдаления И НЕ Н.ЭтоГруппа";















