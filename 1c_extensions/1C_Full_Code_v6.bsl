            КнопкаСверка = "<a href=""#openReconciliation?client=" + ИмяК_Безопасное + """ class=""action-chip"" style=""margin:0;padding:2px 6px;font-size:11px;"" title=""Сформировать акт сверки"">" + IconDoc + "Сверка</a>";















            КнопкаДосье = "<a href=""#openDossier?name=" + ИмяК_Безопасное + """ class=""action-chip"" style=""margin:0;padding:2px 6px;font-size:11px;"" title=""Посмотреть досье контрагента"">" + IconUser + "Досье</a>";















            















