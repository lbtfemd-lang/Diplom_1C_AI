    КнопкаПред = ?(ТекущаяСтр > 1, "<a href='#openStockPage?page=" + Строка(ТекущаяСтр - 1) + "&query=" + ТоварИмя + "' class='action-chip' style='margin:0;padding:3px 10px;'>◀ Пред.</a>", "<span class='action-chip' style='opacity:0.4;margin:0;padding:3px 10px;'>◀ Пред.</span>");















    КнопкаСлед = ?(ТекущаяСтр < ВсегоСтраниц, "<a href='#openStockPage?page=" + Строка(ТекущаяСтр + 1) + "&query=" + ТоварИмя + "' class='action-chip' style='margin:0;padding:3px 10px;'>След. ▶</a>", "<span class='action-chip' style='opacity:0.4;margin:0;padding:3px 10px;'>След. ▶</span>");















    















    ПанельПагинации = "<div style='display:flex;align-items:center;justify-content:space-between;margin-top:10px;padding:6px 10px;background:var(--bg-subtle);border-radius:6px;font-size:12px;'>"















        + "<div>" + КнопкаПред + "</div>"















        + "<div style='color:var(--text-muted);font-weight:600;'>Страница <span style='color:var(--text-main);'>" + ТекущаяСтр + "</span> из " + ВсегоСтраниц + " (всего: " + ВсегоТоваров + ")</div>"















        + "<div>" + КнопкаСлед + "</div>"















        + "</div>";















    















    Итог = "<h3 style=""margin-bottom:8px;display:flex;align-items:center;"">" + IconBox + " " + ЗаголовокОтчета + "</h3>"















        + ТаблицаHTML















        + ПанельПагинации;















        















    Если КоличествоДефицита > 0 Тогда















        Итог = Итог + "<p style=""margin-top:8px;color:#f87171;"">[!] Обнаружено позиций с дефицитом / нулевым остатком: <b>" + Строка(КоличествоДефицита) + " шт.</b></p>";















    КонецЕсли;















    















    Итог = Итог + "<div class=""chips-container"" style=""margin-top:10px;"">"















        + "<a href=""#createAllProcureTasks"" class=""action-chip"">" + IconTask + "Создать задачи в Канбан по дефициту</a>"















        + "<a href=""#openKanban"" class=""action-chip"">" + IconBoard + "Открыть Канбан-доску</a>"















        + "</div>";















    















    Возврат Итог;















КонецФункции















































&НаСервере















Функция ПолучитьСписокДолжниковНаСервере()















    // 1. Долги покупателей















    ЗапросПокупатели = Новый Запрос;















    ЗапросПокупатели.Текст = 















        "ВЫБРАТЬ















        |	Расчеты.Контрагент КАК КонтрагентСсылка,















        |	Расчеты.Контрагент.Наименование КАК Контрагент,















        |	Расчеты.Договор КАК ДоговорСсылка,















        |	ПРЕДСТАВЛЕНИЕ(Расчеты.Договор) КАК Договор,















        |	СУММА(Расчеты.СуммаОстаток) КАК Сумма















        |ИЗ















        |	РегистрНакопления.РасчетыСПокупателями.Остатки КАК Расчеты















        |СГРУППИРОВАТЬ ПО















        |	Расчеты.Контрагент,















        |	Расчеты.Контрагент.Наименование,















        |	Расчеты.Договор















        |ИМЕЮЩИЕ















        |	СУММА(Расчеты.СуммаОстаток) > 0















        |УПОРЯДОЧИТЬ ПО















        |	Сумма УБЫВ";















    















    РезультатПокупатели = Неопределено;















    Попытка















        РезультатПокупатели = ЗапросПокупатели.Выполнить();















    Исключение















    КонецПопытки;















    















    // 2. Авансы поставщикам (дебиторка по поставщикам)















    АвансыПоставщикамВсего = 0;















    Попытка















        ЗапросПоставщики = Новый Запрос;















        ЗапросПоставщики.Текст = "ВЫБРАТЬ ЕСТЬNULL(-СУММА(Р.СуммаОстаток), 0) КАК Авансы ИЗ РегистрНакопления.РасчетыСПоставщиками.Остатки КАК Р ГДЕ Р.СуммаОстаток < 0";















        ВыбПост = ЗапросПоставщики.Выполнить().Выбрать();















        Если ВыбПост.Следующий() И ВыбПост.Авансы <> Неопределено И ВыбПост.Авансы <> Null Тогда















            АвансыПоставщикамВсего = Число(ВыбПост.Авансы);















        КонецЕсли;















    Исключение















    КонецПопытки;















    















    МассивДолжников = Новый Массив;















    ДолгПокупателейВсего = 0;















    















    Если РезультатПокупатели <> Неопределено И НЕ РезультатПокупатели.Пустой() Тогда















        Выборка = РезультатПокупатели.Выбрать();















        Пока Выборка.Следующий() Цикл















            Сумма = ?(Выборка.Сумма <> Неопределено И Выборка.Сумма <> Null, Число(Выборка.Сумма), 0);















            ДолгПокупателейВсего = ДолгПокупателейВсего + Сумма;















            















            Стр = Новый Структура;















            Стр.Вставить("Контрагент", СокрЛП(Выборка.Контрагент));















            Стр.Вставить("Ref", ?(ЗначениеЗаполнено(Выборка.КонтрагентСсылка), Строка(Выборка.КонтрагентСсылка.УникальныйИдентификатор()), ""));















            Стр.Вставить("Договор", ?(ЗначениеЗаполнено(Выборка.Договор), СокрЛП(Выборка.Договор), "Основной договор"));















            Стр.Вставить("Сумма", Сумма);















            МассивДолжников.Добавить(Стр);















        КонецЦикла;















    КонецЕсли;















    















    СтруктураИтог = Новый Структура;















    СтруктураИтог.Вставить("Список", МассивДолжников);















    СтруктураИтог.Вставить("ДолгПокупателей", Число(ДолгПокупателейВсего));















    СтруктураИтог.Вставить("АвансыПоставщикам", Число(АвансыПоставщикамВсего));















    СтруктураИтог.Вставить("ОбщийДолгНам", Число(ДолгПокупателейВсего) + Число(АвансыПоставщикамВсего));















    















    Возврат СтруктураИтог;















КонецФункции































&НаСервере















Функция СформироватьАктСверкиHTML(ИмяКонтрагента)















    IconDoc = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#38bdf8' stroke-width='2' style='vertical-align:middle;margin-right:6px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'></path><polyline points='14 2 14 8 20 8'></polyline><line x1='16' y1='13' x2='8' y2='13'></line><line x1='16' y1='17' x2='8' y2='17'></line></svg>";















    IconUser = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' style='vertical-align:middle;margin-right:4px;'><path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/></svg>";















    IconTask = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' style='vertical-align:middle;margin-right:4px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'></path><polyline points='14 2 14 8 20 8'></polyline></svg>";















    















    ИмяОчищ = СокрЛП(ИмяКонтрагента);















    СсылкаКонтрагент = Справочники.Контрагенты.НайтиПоНаименованию(ИмяОчищ, Ложь);















    Если НЕ ЗначениеЗаполнено(СсылкаКонтрагент) Тогда















        СсылкаКонтрагент = Справочники.Контрагенты.НайтиПоНаименованию(ИмяОчищ, Истина);















    КонецЕсли;















    















    Долг = 0;















    Договор = "Основной договор";















    RefК = "";















    















    Если ЗначениеЗаполнено(СсылкаКонтрагент) Тогда















        RefК = Строка(СсылкаКонтрагент.УникальныйИдентификатор());















        ИмяОчищ = СсылкаКонтрагент.Наименование;















        Попытка















            Запрос = Новый Запрос(















                "ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаОстаток), 0) КАК Долг















                |ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки(, Контрагент = &Контрагент) КАК Р"















            );















            Запрос.УстановитьПараметр("Контрагент", СсылкаКонтрагент);















            Выб = Запрос.Выполнить().Выбрать();















            Если Выб.Следующий() Тогда Долг = Выб.Долг; КонецЕсли;















        Исключение















        КонецПопытки;















    КонецЕсли;















    















    ИмяК_Безопасное = СтрЗаменить(СтрЗаменить(ИмяОчищ, Символ(34), ""), "'", "");















    ДолгФормат = Формат(Долг, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽";















    















    HTML = "<div class='table-container'>"















        + "<div class='section-title'>" + IconDoc + "Акт сверки расчетов: " + ШЭкранироватьHTML(ИмяОчищ) + "</div>"















        + "<div class='kpi-grid' style='margin-bottom:12px;'>"















        + "<div class='kpi-card'><div class='kpi-label'>Сальдо в пользу компании</div><div class='kpi-value' style='color:" + ?(Долг > 0, "#f87171", "#10b981") + ";'>" + ДолгФормат + "</div><div class='kpi-growth'>На текущий момент</div></div>"















        + "<div class='kpi-card'><div class='kpi-label'>Договор</div><div class='kpi-value' style='font-size:13px;'>" + ШЭкранироватьHTML(Договор) + "</div><div class='kpi-growth'>Взаиморасчеты</div></div>"















        + "</div>"















        + "<p style='font-size:13px;line-height:1.5;margin-bottom:12px;'>По данным бухгалтерского и управленческого учета 1С:УНФ, задолженность контрагента <b>«" + ШЭкранироватьHTML(ИмяОчищ) + "»</b> составляет <b>" + ДолгФормат + "</b>. Расхождения не выявлены.</p>"















        + "<div class='chips-container'>"















        + ?(ЗначениеЗаполнено(RefК), "<a href='#openCounterparty?ref=" + RefК + "&name=" + ИмяК_Безопасное + "' class='action-chip'>" + IconUser + "Открыть карточку контрагента</a>", "")















        + "<a href='#createCallTask?name=" + ИмяК_Безопасное + "&amount=" + Формат(Долг, "ЧГ=0; ЧДЦ=2") + "' class='action-chip'>" + IconTask + "Создать задачу на подписание акта</a>"















        + "<a href='#openKanban' class='action-chip'>Открыть Канбан-доску</a>"















        + "</div>"















        + "</div>";















        















    Возврат HTML;















КонецФункции















































&НаСервере















Функция СобратьАналитикуДолжниковНаСервере(НомерСтраницы = 1)















    СтруктураДанных = ПолучитьСписокДолжниковНаСервере();















    Возврат СформироватьТаблицуДолжниковHTML(СтруктураДанных, НомерСтраницы);















КонецФункции































&НаСервере















Функция СформироватьТаблицуДолжниковHTML(СтруктураДанных, НомерСтраницы = 1)















    МассивДолжников = СтруктураДанных.Список;















    ДолгПокупателей = СтруктураДанных.ДолгПокупателей;















    АвансыПоставщикам = СтруктураДанных.АвансыПоставщикам;















    ОбщийДолгНам = СтруктураДанных.ОбщийДолгНам;















    















    ВсегоДолжников = МассивДолжников.Количество();















    РазмерСтр = 5;















    ВсегоСтраниц = ?(ВсегоДолжников = 0, 1, Цел((ВсегоДолжников + РазмерСтр - 1) / РазмерСтр));















    ТекущаяСтр = Макс(1, Мин(Число(НомерСтраницы), ВсегоСтраниц));















    















    ИндексНач = (ТекущаяСтр - 1) * РазмерСтр;















    ИндексКон = Мин(ИндексНач + РазмерСтр - 1, ВсегоДолжников - 1);















    















    IconChart = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#38bdf8' stroke-width='2' style='vertical-align:middle;margin-right:6px;'><line x1='18' y1='20' x2='18' y2='10'></line><line x1='12' y1='20' x2='12' y2='4'></line><line x1='6' y1='20' x2='6' y2='14'></line></svg>";















    IconTask = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' style='vertical-align:middle;margin-right:4px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'></path><polyline points='14 2 14 8 20 8'></polyline><line x1='16' y1='13' x2='8' y2='13'></line><line x1='16' y1='17' x2='8' y2='17'></line></svg>";















    IconBoard = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' style='vertical-align:middle;margin-right:4px;'><rect x='3' y='3' width='18' height='18' rx='2' ry='2'></rect><line x1='9' y1='3' x2='9' y2='21'></line><line x1='15' y1='3' x2='15' y2='21'></line></svg>";















    IconPhone = "<svg width='11' height='11' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:3px;'><path d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z'/></svg>";















    IconDoc = "<svg width='11' height='11' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:3px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/></svg>";















    IconUser = "<svg width='11' height='11' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:3px;'><path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/></svg>";































    // Получаем также кредиторку (наши долги поставщикам)















    ДолгиНаши = 0;















    Попытка















        ЗапросКред = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(Р.СуммаОстаток), 0) КАК Кредиторка ИЗ РегистрНакопления.РасчетыСПоставщиками.Остатки КАК Р ГДЕ Р.СуммаОстаток > 0");















        ВыбК = ЗапросКред.Выполнить().Выбрать();















        Если ВыбК.Следующий() Тогда ДолгиНаши = Число(ВыбК.Кредиторка); КонецЕсли;















    Исключение















    КонецПопытки;































    СальдоВзаиморасчетов = ДолгПокупателей - ДолгиНаши;















    КлассСальдо = ?(СальдоВзаиморасчетов >= 0, "color:#10b981;", "color:#f87171;");































    KPI_Block = "<div class='kpi-grid' style='margin-bottom:12px;'>"















        + "<div class='kpi-card'><div class='kpi-label'>Дебиторка (Долги нам)</div><div class='kpi-value' style='color:#38bdf8;'>" + Формат(ДолгПокупателей, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽</div><div class='kpi-growth' style='color:#38bdf8;'>" + ВсегоДолжников + " покупателей</div></div>"















        + "<div class='kpi-card'><div class='kpi-label'>Кредиторка (Долги наши)</div><div class='kpi-value' style='color:#f87171;'>" + Формат(ДолгиНаши, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽</div><div class='kpi-growth' style='color:#f87171;'>Поставщики УНФ</div></div>"















