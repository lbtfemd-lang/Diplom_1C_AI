// =============================================================================
// Канбан-доска — отдельное расширение 1С
// Взаимодействует с тем же middleware
// =============================================================================
// Имя расширения: КанбанДоска, Префикс: КД_
// Имя обработки: КанбанДоска
//
// Форма «Форма» (десктоп):
//   КанбанHTML (Строка, неограниченная) — HTML-поле
//   ПолеФильтр (Строка, 100) — поле ввода фильтра
//   ФильтрПоДепартаменту (Булево) — флажок
//
// Форма «МобильнаяФорма» (мобильный клиент):
//   ЗадачиТаблица (ТаблицаЗначений) — колонки:
//     ИдЗадачи (Число), Заголовок (Строка 200), Статус (Строка 50),
//     Приоритет (Строка 50), Исполнитель (Строка 100), Дедлайн (Строка 20),
//     Просрочено (Булево)
// =============================================================================

Перем MiddlewareURL Экспорт;
Перем MiddlewareПорт Экспорт;
Перем MiddlewareТокен Экспорт;

// =============================================================================
// ИНИЦИАЛИЗАЦИЯ
// =============================================================================

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    MiddlewareURL = АдресСервера;
    MiddlewareПорт = 8000;
    MiddlewareТокен = "";
КонецПроцедуры

&НаСервере
Функция АдресСервера()
    Попытка
        Если ЗначениеЗаполнено(АдресMiddleware) Тогда
            Возврат АдресMiddleware;
        КонецЕсли;
    Исключение
    КонецПопытки;
    Возврат "127.0.0.1";
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ПолучитьТокенАвторизацииНаСервере();
    ОбновитьДоску();
КонецПроцедуры

&НаСервере
Процедура ПолучитьТокенАвторизацииНаСервере()
    СтруктураЗапроса = Новый Структура("username, password", "admin", "admin");
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    Ответ = ВыполнитьHTTPЗапрос("/auth/login", СтрокаJSON);
    Если Ответ <> Неопределено И Ответ.КодСостояния = 200 Тогда
        Попытка
            ЧтениеJSON = Новый ЧтениеJSON;
            ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
            Результат = ПрочитатьJSON(ЧтениеJSON);
            ЧтениеJSON.Закрыть();
            Если Результат.Свойство("access_token", MiddlewareТокен) Тогда
                // Токен получен
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЕсли;
КонецПроцедуры

// =============================================================================
// HTTP-ЗАПРОСЫ
// =============================================================================

&НаСервере
Функция ВыполнитьHTTPЗапрос(Путь, ТелоЗапроса = "", Метод = "POST")
    Попытка
        Соединение = Новый HTTPСоединение(MiddlewareURL, MiddlewareПорт, , , , 30, Новый ЗащищенноеСоединениеOpenSSL());
        
        Заголовки = Новый Соответствие;
        Заголовки.Вставить("Content-Type", "application/json");
        Если Не ПустаяСтрока(MiddlewareТокен) Тогда
            Заголовки.Вставить("X-Auth-Token", MiddlewareТокен);
        КонецЕсли;
        
        Если Метод = "GET" Тогда
            Запрос = Новый HTTPЗапрос(Путь, Заголовки);
            Ответ = Соединение.Получить(Запрос);
        Иначе
            Запрос = Новый HTTPЗапрос(Путь, Заголовки);
            Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
            Ответ = Соединение.Записать(Запрос);
        КонецЕсли;
        
        Возврат Ответ;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

// =============================================================================
// КАНАБАН: ОТРИСОВКА ДОСКИ
// =============================================================================

&НаКлиенте
Процедура ОбновитьДоску()
    ТекстДоски = ПолучитьДоскуНаСервереВызов();
    ПоказатьКанбанHTML(ТекстДоски);
КонецПроцедуры

&НаСервере
Функция ПолучитьДоскуНаСервере()
    Ответ = ВыполнитьHTTPЗапрос("/kanban/tasks", "", "GET");
    Если Ответ = Неопределено ИЛИ Ответ.КодСостояния <> 200 Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
        Результат = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        Возврат Результат;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

&НаСервере
Функция ПолучитьДоскуНаСервереВызов()
    Возврат ПолучитьДоскуНаСервере();
КонецФункции

&НаСервере
Процедура ПоказатьКанбанHTML(ДанныеДоски)
    Если ДанныеДоски = Неопределено Тогда
        КанбанHTML = "<html><head><meta charset='utf-8'><style>"
            + "body{font-family:'Segoe UI',Arial,sans-serif;background:#f5f5f5;padding:20px;text-align:center}"
            + "</style></head><body>"
            + "<h3>Не удалось загрузить канбан-доску</h3>"
            + "<p>Проверьте что middleware запущен</p>"
            + "</body></html>";
        Возврат;
    КонецЕсли;
    
    МассивЗадач = ДанныеДоски;
    
    Колонки = Новый Массив;
    Колонки.Добавить(Новый Структура("id, name, color", "todo", "К выполнению", "#3b82f6"));
    Колонки.Добавить(Новый Структура("id, name, color", "in_progress", "В работе", "#f59e0b"));
    Колонки.Добавить(Новый Структура("id, name, color", "review", "На проверке", "#8b5cf6"));
    Колонки.Добавить(Новый Структура("id, name, color", "done", "Готово", "#10b981"));
    
    Приоритеты = Новый Соответствие;
    Приоритеты.Вставить("low", "🟢");
    Приоритеты.Вставить("medium", "🔵");
    Приоритеты.Вставить("high", "🟡");
    Приоритеты.Вставить("urgent", "🔴");
    
    СтолбцыHTML = "";
    Для Каждого Колонка Из Колонки Цикл
        ЗадачиКолонки = "";
        Счётчик = 0;
        Если ТипЗнч(МассивЗадач) = Тип("Массив") Тогда
            Для Каждого З Из МассивЗадач Цикл
                КолЗ = ""; З.Свойство("column", КолЗ);
                Если КолЗ <> Колонка.id Тогда Продолжить; КонецЕсли;
                
                Счётчик = Счётчик + 1;
                ЗаголовокЗ = ""; З.Свойство("title", ЗаголовокЗ);
                БезЗаголовок = ЭкранироватьHTML(ЗаголовокЗ);
                НомерЗ = 0; З.Свойство("id", НомерЗ);
                ОписаниеЗ = ""; З.Свойство("description", ОписаниеЗ);
                ПриорКлюч = ""; З.Свойство("priority", ПриорКлюч);
                ИсполнительЗ = ""; З.Свойство("assignee", ИсполнительЗ);
                ПросроченоЗ = Ложь; З.Свойство("is_overdue", ПросроченоЗ);
                
                ПриорЗнак = ?(Приоритеты.Получить(ПриорКлюч) <> Неопределено, Приоритеты.Получить(ПриорКлюч), "⚪");
                КлассПросрочено = ?(ПросроченоЗ И Колонка.id <> "done", " overdue", "");
                
                ЗадачиКолонки = ЗадачиКолонки
                    + "<div class='task" + КлассПросрочено + "' onclick=""parent.clickTask(" + НомерЗ + ")"">"
                    + "<div class='task-header'>" + ПриорЗнак + " #" + НомерЗ + "</div>"
                    + "<div class='task-title'>" + БезЗаголовок + "</div>";
                Если ЗначениеЗаполнено(ИсполнительЗ) Тогда
                    ЗадачиКолонки = ЗадачиКолонки + "<div class='task-assignee'>" + ЭкранироватьHTML(ИсполнительЗ) + "</div>";
                КонецЕсли;
                Если ПросроченоЗ И Колонка.id <> "done" Тогда
                    ЗадачиКолонки = ЗадачиКолонки + "<div class='task-overdue'>Просрочено!</div>";
                КонецЕсли;
                ЗадачиКолонки = ЗадачиКолонки + "</div>";
            КонецЦикла;
        КонецЕсли;
        
        СтолбцыHTML = СтолбцыHTML
            + "<div class='column'>"
            + "<div class='column-header' style='border-top:3px solid " + Колонка.color + "'>"
            + "<span class='col-name'>" + Колонка.name + "</span>"
            + "<span class='col-count'>" + Счётчик + "</span>"
            + "</div>"
            + "<div class='column-body'>" + ЗадачиКолонки + "</div>"
            + "</div>";
    КонецЦикла;
    
    КанбанHTML = "<html><head><meta charset='utf-8'><style>"
        + "*{box-sizing:border-box;margin:0;padding:0}"
        + "body{font-family:'Segoe UI',Arial,sans-serif;background:#1e1e2e;color:#cdd6f4;padding:16px}"
        + "h1{color:#cba6f7;font-size:18px;margin-bottom:12px}"
        + ".board{display:flex;gap:12px;overflow-x:auto}"
        + ".column{min-width:220px;max-width:280px;flex:1;background:#313244;border-radius:8px;padding:0}"
        + ".column-header{padding:10px 12px;display:flex;justify-content:space-between;align-items:center;border-radius:8px 8px 0 0;background:#45475a}"
        + ".col-name{font-weight:600;font-size:13px}"
        + ".col-count{background:#585b70;padding:2px 8px;border-radius:10px;font-size:11px;color:#a6adc8}"
        + ".column-body{padding:8px;min-height:60px}"
        + ".task{background:#45475a;padding:8px 10px;border-radius:6px;margin-bottom:6px;cursor:pointer;border-left:3px solid #89b4fa;transition:background 0.2s}"
        + ".task:hover{background:#585b70}"
        + ".task.overdue{border-left-color:#f38ba8}"
        + ".task-header{font-size:11px;color:#a6adc8;margin-bottom:2px}"
        + ".task-title{font-size:13px;font-weight:500}"
        + ".task-assignee{font-size:11px;color:#94e2d5;margin-top:4px}"
        + ".task-overdue{font-size:10px;color:#f38ba8;margin-top:2px}"
        + ".toolbar{margin-bottom:12px;display:flex;gap:8px;align-items:center}"
        + ".btn{background:#89b4fa;color:#1e1e2e;border:none;padding:6px 14px;border-radius:6px;cursor:pointer;font-size:12px;font-weight:600}"
        + ".btn:hover{background:#74c7ec}"
        + ".btn-danger{background:#f38ba8}"
        + "input{background:#45475a;color:#cdd6f4;border:1px solid #585b70;padding:6px 10px;border-radius:6px;font-size:12px;width:200px}"
        + "</style></head><body>"
        + "<h1>📌 Канбан-доска</h1>"
        + "<div class='toolbar'>"
        + "<input placeholder='Фильтр по задаче...' oninput=""parent.filterTasks(this.value)"">"
        + "<button class='btn' onclick=""parent.refreshBoard()"">Обновить</button>"
        + "</div>"
        + "<div class='board'>" + СтолбцыHTML + "</div>"
        + "<script>"
        + "function filterTasks(q){var tasks=document.querySelectorAll('.task');for(var i=0;i<tasks.length;i++){var t=tasks[i].textContent.toLowerCase();tasks[i].style.display=t.indexOf(q.toLowerCase())>=0?'':'none'}}"
        + "</script>"
        + "</body></html>";
КонецПроцедуры

// =============================================================================
// ОБРАБОТЧИК КЛИКОВ ИЗ HTML
// =============================================================================

&НаКлиенте
Процедура КанбанHTMLНажатиеНаСсылку(Элемент, Адрес, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    
    Если Лев(Адрес, 10) = "clickTask:" Тогда
        ИдЗадачи = Число(Сред(Адрес, 11));
        ПоказатьДействияЗадачи(ИдЗадачи);
    ИначеЕсли Адрес = "refreshBoard" Тогда
        ОбновитьДоску();
    ИначеЕсли Адрес = "filterTasks" Тогда
        // Фильтр обрабатывается в JS, сюда не попадает
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДействияЗадачи(ИдЗадачи)
    МассивДействий = Новый Массив;
    МассивДействий.Добавить("Переместить в «К выполнению»");
    МассивДействий.Добавить("Переместить в «В работе»");
    МассивДействий.Добавить("Переместить в «На проверке»");
    МассивДействий.Добавить("Переместить в «Готово»");
    МассивДействий.Добавить("Удалить задачу");
    
    Оповещение = Новый ОписаниеОповещения("ПослеВыбораДействия", ЭтотОбъект, ИдЗадачи);
    ПоказатьВыборИзСписка(Оповещение, "Действие с задачей #" + ИдЗадачи, МассивДействий);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораДействия(Результат, ИдЗадачи) Экспорт
    Если Результат = Неопределено Тогда Возврат; КонецЕсли;
    
    ТекстДействия = Результат.Значение;
    Если ТекстДействия = "Переместить в «К выполнению»" Тогда
        ПереместитьЗадачуНаСервереВызов(ИдЗадачи, "todo");
    ИначеЕсли ТекстДействия = "Переместить в «В работе»" Тогда
        ПереместитьЗадачуНаСервереВызов(ИдЗадачи, "in_progress");
    ИначеЕсли ТекстДействия = "Переместить в «На проверке»" Тогда
        ПереместитьЗадачуНаСервереВызов(ИдЗадачи, "review");
    ИначеЕсли ТекстДействия = "Переместить в «Готово»" Тогда
        ПереместитьЗадачуНаСервереВызов(ИдЗадачи, "done");
    ИначеЕсли ТекстДействия = "Удалить задачу" Тогда
        УдалитьЗадачуНаСервереВызов(ИдЗадачи);
    КонецЕсли;
    
    ОбновитьДоску();
КонецПроцедуры

// =============================================================================
// КАНАБАН: CRUD
// =============================================================================

&НаСервере
Функция СоздатьЗадачуНаСервере(Заголовок, Описание = "", Колонка = "todo", Приоритет = "medium", Исполнитель = "", Дедлайн = "")
    СтруктураЗапроса = Новый Структура;
    СтруктураЗапроса.Вставить("title", Заголовок);
    Если Не ПустаяСтрока(Описание) Тогда СтруктураЗапроса.Вставить("description", Описание); КонецЕсли;
    СтруктураЗапроса.Вставить("column", Колонка);
    СтруктураЗапроса.Вставить("priority", Приоритет);
    СтруктураЗапроса.Вставить("source", "1c_kanban");
    Если Не ПустаяСтрока(Исполнитель) Тогда СтруктураЗапроса.Вставить("assignee", Исполнитель); КонецЕсли;
    Если Не ПустаяСтрока(Дедлайн) Тогда СтруктураЗапроса.Вставить("due_date", Дедлайн); КонецЕсли;
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    
    Ответ = ВыполнитьHTTPЗапрос("/kanban/tasks", СтрокаJSON);
    Если Ответ = Неопределено ИЛИ Ответ.КодСостояния <> 200 Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
        Результат = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        Возврат Результат;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

&НаСервере
Функция СоздатьЗадачуНаСервереВызов(Заголовок, Описание = "", Колонка = "todo", Приоритет = "medium", Исполнитель = "", Дедлайн = "")
    Возврат СоздатьЗадачуНаСервере(Заголовок, Описание, Колонка, Приоритет, Исполнитель, Дедлайн);
КонецФункции

&НаСервере
Функция ПереместитьЗадачуНаСервере(ИдЗадачи, НоваяКолонка)
    СтруктураЗапроса = Новый Структура("task_id, column", ИдЗадачи, НоваяКолонка);
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    Ответ = ВыполнитьHTTPЗапрос("/kanban/tasks/move", СтрокаJSON);
    Возврат Ответ <> Неопределено И Ответ.КодСостояния = 200;
КонецФункции

&НаСервере
Функция ПереместитьЗадачуНаСервереВызов(ИдЗадачи, НоваяКолонка)
    Возврат ПереместитьЗадачуНаСервере(ИдЗадачи, НоваяКолонка);
КонецФункции

&НаСервере
Функция УдалитьЗадачуНаСервере(ИдЗадачи)
    Ответ = ВыполнитьHTTPЗапрос("/kanban/tasks/" + ИдЗадачи, "", "DELETE");
    Возврат Ответ <> Неопределено И Ответ.КодСостояния = 200;
КонецФункции

&НаСервере
Функция УдалитьЗадачуНаСервереВызов(ИдЗадачи)
    Возврат УдалитьЗадачуНаСервере(ИдЗадачи);
КонецФункции

// =============================================================================
// КНОПКИ ФОРМЫ
// =============================================================================

&НаКлиенте
Процедура ОбновитьНажатие(Элемент)
    ОбновитьДоску();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗадачуНажатие(Элемент)
    Оповещение = Новый ОписаниеОповещения("ПослеВводаЗаголовка", ЭтотОбъект);
    ПоказатьВводСтроки(Оповещение, "Заголовок новой задачи", "", , , , 200);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗаголовка(Результат, Параметры) Экспорт
    Если Результат = Неопределено Тогда Возврат; КонецЕсли;
    Заголовок = СокрЛП(Результат);
    Если ПустаяСтрока(Заголовок) Тогда Возврат; КонецЕсли;
    
    РезультатСоздания = СоздатьЗадачуНаСервереВызов(Заголовок);
    Если РезультатСоздания <> Неопределено Тогда
        ОбновитьДоску();
    Иначе
        ПоказатьПредупреждение(, "Не удалось создать задачу");
    КонецЕсли;
КонецПроцедуры

// =============================================================================
// УТИЛИТЫ
// =============================================================================

&НаСервере
Функция ЭкранироватьHTML(Текст)
    Если Текст = Неопределено Тогда Возврат ""; КонецЕсли;
    Текст = СтрЗаменить(Текст, "&", "&amp;");
    Текст = СтрЗаменить(Текст, "<", "&lt;");
    Текст = СтрЗаменить(Текст, ">", "&gt;");
    Текст = СтрЗаменить(Текст, """", "&quot;");
    Текст = СтрЗаменить(Текст, "'", "&#39;");
    Текст = СтрЗаменить(Текст, Символы.ПС, "<br>");
    Возврат Текст;
КонецФункции
