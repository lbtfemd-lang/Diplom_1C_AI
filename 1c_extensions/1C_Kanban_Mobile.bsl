// =============================================================================
// Канбан-доска — Мобильная форма (нативные элементы)
// Код для модуля формы «МобильнаяФорма» обработки КанбанДоска
// =============================================================================
// Реквизиты формы:
//   ЗадачиТаблица (ТаблицаЗначений):
//     ИдЗадачи (Число, 10, 0), Заголовок (Строка, 200),
//     Статус (Строка, 50), Приоритет (Строка, 50),
//     Исполнитель (Строка, 100), Дедлайн (Строка, 20),
//     Просрочено (Булево)
//   АдресMiddleware (Строка, 100) — адрес сервера
//   ЛогинMiddleware (Строка, 100) — логин сервисного аккаунта
//   ПарольMiddleware (Строка, 100) — пароль сервисного аккаунта
//   ИспользоватьHTTPS (Булево) — флаг HTTPS
//   MiddlewareТокен (Строка, 500) — JWT-токен авторизации (реквизит формы!)
//
// Общие шаблонные функции (префикс «Ш») — см. 1C_Shared_HTTP.bsl
//
// Элементы формы:
//   Таблица «ЗадачиТаблица» — список задач
//   Кнопка «ОбновитьНажатие» — Обновить
//   Кнопка «СоздатьЗадачуНажатие» — + Задача
//   Кнопка «ПереместитьНажатие» — Переместить
//   Кнопка «УдалитьЗадачуНажатие» — Удалить
// =============================================================================

// =============================================================================
// ИНИЦИАЛИЗАЦИЯ
// =============================================================================

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    MiddlewareТокен = "";
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    ПолучитьТокенАвторизацииНаСервере();
    ПодключитьОбработчикОжидания("ЗагрузитьЗадачиЗадержка", 0.5, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗадачиЗадержка()
    ОтключитьОбработчикОжидания("ЗагрузитьЗадачиЗадержка");
    ЗагрузитьЗадачи();
КонецПроцедуры

&НаСервере
Процедура ПолучитьТокенАвторизацииНаСервере()
    ШПолучитьТокенАвторизации();
КонецПроцедуры

// =============================================================================
// HTTP-ЗАПРОСЫ
// =============================================================================

&НаСервере
Функция ВыполнитьHTTPЗапрос(Путь, ТелоЗапроса = "", Метод = "POST")
    Возврат ШВыполнитьHTTPЗапрос(Путь, ТелоЗапроса, Метод);
КонецФункции

// =============================================================================
// ЗАГРУЗКА ЗАДАЧ В ТАБЛИЦУ
// =============================================================================

&НаКлиенте
Процедура ЗагрузитьЗадачи()
    ЗагрузитьЗадачиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЗадачиНаСервере()
    ЗадачиТаблица.Очистить();
    
    Ответ = ВыполнитьHTTPЗапрос("/kanban/tasks", "", "GET");
    Если Ответ = Неопределено ИЛИ Ответ.КодСостояния <> 200 Тогда
        Возврат;
    КонецЕсли;
    
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
        МассивЗадач = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
    Исключение
        Возврат;
    КонецПопытки;
    
    ИменаСтатусов = Новый Соответствие;
    ИменаСтатусов.Вставить("todo", "К выполнению");
    ИменаСтатусов.Вставить("in_progress", "В работе");
    ИменаСтатусов.Вставить("review", "На проверке");
    ИменаСтатусов.Вставить("done", "Готово");
    
    ИменаПриоритетов = Новый Соответствие;
    ИменаПриоритетов.Вставить("low", "Низкий");
    ИменаПриоритетов.Вставить("medium", "Средний");
    ИменаПриоритетов.Вставить("high", "Высокий");
    ИменаПриоритетов.Вставить("urgent", "Срочный");
    
    Если ТипЗнч(МассивЗадач) = Тип("Массив") Тогда
        Для Каждого З Из МассивЗадач Цикл
            Стр = ЗадачиТаблица.Добавить();
            Кол = ""; З.Свойство("column", Кол);
            Стр.Статус = ?(ИменаСтатусов.Получить(Кол) <> Неопределено, ИменаСтатусов.Получить(Кол), Кол);
            ПриорКлюч = ""; З.Свойство("priority", ПриорКлюч);
            Стр.Приоритет = ?(ИменаПриоритетов.Получить(ПриорКлюч) <> Неопределено, ИменаПриоритетов.Получить(ПриорКлюч), ПриорКлюч);
            З.Свойство("id", Стр.ИдЗадачи);
            З.Свойство("title", Стр.Заголовок);
            З.Свойство("assignee", Стр.Исполнитель);
            ДД = ""; З.Свойство("due_date", ДД);
            Стр.Дедлайн = ДД;
            Проср = Ложь; З.Свойство("is_overdue", Проср);
            Стр.Просрочено = Проср;
        КонецЦикла;
    КонецЕсли;
КонецПроцедуры

// =============================================================================
// КНОПКИ ФОРМЫ
// =============================================================================

&НаКлиенте
Процедура ОбновитьНажатие(Элемент)
    ЗагрузитьЗадачи();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗадачуНажатие(Элемент)
    Оповещение = Новый ОписаниеОповещения("ПослеВводаЗаголовка", ЭтотОбъект);
    ПоказатьВводСтроки(Оповещение, "Заголовок новой задачи", "", , , , 200);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗаголовка(Результат, Параметры) Экспорт
    Если Результат = Неопределено Тогда Возврат; КонецЕсли;
    Заголовок = СокрЛП(Результат);
    Если ПустаяСтрока(Заголовок) Тогда Возврат; КонецЕсли;
    РезультатСоздания = СоздатьЗадачуНаСервереВызов(Заголовок);
    Если РезультатСоздания <> Неопределено Тогда
        ЗагрузитьЗадачи();
    Иначе
        ПоказатьПредупреждение(, "Не удалось создать задачу");
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьНажатие(Элемент)
    Если ЗадачиТаблица.Количество() = 0 Тогда Возврат; КонецЕсли;
    ТекСтр = Элементы.ЗадачиТаблицаТекущаяСтрока;
    Если ТекСтр = Неопределено Тогда
        ПоказатьПредупреждение(, "Выберите задачу");
        Возврат;
    КонецЕсли;
    
    ИдЗадачи = ЗадачиТаблица[ТекСтр].ИдЗадачи;
    
    МассивВариантов = Новый Массив;
    МассивВариантов.Добавить("К выполнению");
    МассивВариантов.Добавить("В работе");
    МассивВариантов.Добавить("На проверке");
    МассивВариантов.Добавить("Готово");
    
    Оповещение = Новый ОписаниеОповещения("ПослеВыбораКолонки", ЭтотОбъект, ИдЗадачи);
    ПоказатьВыборИзСписка(Оповещение, "Переместить задачу #" + ИдЗадачи, МассивВариантов);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораКолонки(Результат, ИдЗадачи) Экспорт
    Если Результат = Неопределено Тогда Возврат; КонецЕсли;
    ТекстВыбора = Результат.Значение;
    Колонка = "todo";
    Если ТекстВыбора = "В работе" Тогда Колонка = "in_progress";
    ИначеЕсли ТекстВыбора = "На проверке" Тогда Колонка = "review";
    ИначеЕсли ТекстВыбора = "Готово" Тогда Колонка = "done";
    КонецЕсли;
    
    ПереместитьЗадачуНаСервереВызов(ИдЗадачи, Колонка);
    ЗагрузитьЗадачи();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗадачуНажатие(Элемент)
    Если ЗадачиТаблица.Количество() = 0 Тогда Возврат; КонецЕсли;
    ТекСтр = Элементы.ЗадачиТаблицаТекущаяСтрока;
    Если ТекСтр = Неопределено Тогда
        ПоказатьПредупреждение(, "Выберите задачу");
        Возврат;
    КонецЕсли;
    ИдЗадачи = ЗадачиТаблица[ТекСтр].ИдЗадачи;
    Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияУдаления", ЭтотОбъект, ИдЗадачи);
    ПоказатьВопрос(Оповещение, "Удалить задачу #" + ИдЗадачи + "?", РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияУдаления(Результат, ИдЗадачи) Экспорт
    Если Результат <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
    УдалитьЗадачуНаСервереВызов(ИдЗадачи);
    ЗагрузитьЗадачи();
КонецПроцедуры

// =============================================================================
// СЕРВЕРНЫЕ CRUD
// =============================================================================

&НаСервере
Функция СоздатьЗадачуНаСервере(Заголовок, Описание = "", Колонка = "todo", Приоритет = "medium", Исполнитель = "", Дедлайн = "")
    СтруктураЗапроса = Новый Структура;
    СтруктураЗапроса.Вставить("title", Заголовок);
    Если Не ПустаяСтрока(Описание) Тогда СтруктураЗапроса.Вставить("description", Описание); КонецЕсли;
    СтруктураЗапроса.Вставить("column", Колонка);
    СтруктураЗапроса.Вставить("priority", Приоритет);
    СтруктураЗапроса.Вставить("source", "1c_mobile");
    Если Не ПустаяСтрока(Исполнитель) Тогда СтруктураЗапроса.Вставить("assignee", Исполнитель); КонецЕсли;
    Если Не ПустаяСтрока(Дедлайн) Тогда СтруктураЗапроса.Вставить("due_date", Дедлайн); КонецЕсли;
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    Ответ = ВыполнитьHTTPЗапрос("/kanban/tasks", СтрокаJSON);
    Если Ответ = Неопределено ИЛИ Ответ.КодСостояния <> 200 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
        Результат = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        Возврат Результат;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

&НаСервере
Функция СоздатьЗадачуНаСервереВызов(Заголовок, Описание = "", Колонка = "todo", Приоритет = "medium", Исполнитель = "", Дедлайн = "")
    Возврат СоздатьЗадачуНаСервере(Заголовок, Описание, Колонка, Приоритет, Исполнитель, Дедлайн);
КонецФункции

&НаСервере
Функция ПереместитьЗадачуНаСервере(ИдЗадачи, НоваяКолонка)
    СтруктураЗапроса = Новый Структура("task_id, column", ИдЗадачи, НоваяКолонка);
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
    СтрокаJSON = ЗаписьJSON.Закрыть();
    Ответ = ВыполнитьHTTPЗапрос("/kanban/tasks/move", СтрокаJSON);
    Возврат Ответ <> Неопределено И Ответ.КодСостояния = 200;
КонецФункции

&НаСервере
Функция ПереместитьЗадачуНаСервереВызов(ИдЗадачи, НоваяКолонка)
    Возврат ПереместитьЗадачуНаСервере(ИдЗадачи, НоваяКолонка);
КонецФункции

&НаСервере
Функция УдалитьЗадачуНаСервере(ИдЗадачи)
    Ответ = ВыполнитьHTTPЗапрос("/kanban/tasks/" + ИдЗадачи, "", "DELETE");
    Возврат Ответ <> Неопределено И Ответ.КодСостояния = 200;
КонецФункции

&НаСервере
Функция УдалитьЗадачуНаСервереВызов(ИдЗадачи)
    Возврат УдалитьЗадачуНаСервере(ИдЗадачи);
КонецФункции

// =============================================================================
// ОБЩИЕ ШАБЛОННЫЕ ФУНКЦИИ (префикс «Ш»)
// Источник: 1C_Shared_HTTP.bsl  — SHARED_HTTP_START..SHARED_HTTP_END
// =============================================================================

// === SHARED_HTTP_START =======================================================

&НаСервере
Функция ШАдресСервера()
    Если ЗначениеЗаполнено(АдресMiddleware) Тогда
        Возврат АдресMiddleware;
    КонецЕсли;
    Возврат "127.0.0.1";
КонецФункции

&НаСервере
Функция ШЛогинСервисногоАккаунта()
    Если ЗначениеЗаполнено(ЛогинMiddleware) Тогда
        Возврат ЛогинMiddleware;
    КонецЕсли;
    Возврат "1c_service";
КонецФункции

&НаСервере
Функция ШПарольСервисногоАккаунта()
    Если ЗначениеЗаполнено(ПарольMiddleware) Тогда
        Возврат ПарольMiddleware;
    КонецЕсли;
    Возврат "1c_service_2024";
КонецФункции

&НаСервере
Процедура ШПолучитьТокенАвторизации()
    Если Не ПустаяСтрока(MiddlewareТокен) Тогда Возврат; КонецЕсли;
    Попытка
        HTTP = ШСоздатьСоединение();
        Заголовки = Новый Соответствие;
        Заголовки.Вставить("Content-Type", "application/json");
        Запрос = Новый HTTPЗапрос("/auth/login", Заголовки);
        ТелоЗапроса = ШСериализоватьВJSON(
            Новый Структура("username, password",
                ШЛогинСервисногоАккаунта(),
                ШПарольСервисногоАккаунта()));
        Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        Ответ = HTTP.ОтправитьДляОбработки(Запрос);
        Если Ответ.КодСостояния = 200 Тогда
            Структура = ШДесериализоватьИзJSON(Ответ.ПолучитьТелоКакСтроку());
            Если Структура <> Неопределено И Структура.Свойство("access_token") Тогда
                MiddlewareТокен = Структура.access_token;
            КонецЕсли;
        Иначе
            Сообщить("ШАвторизация: код " + Ответ.КодСостояния, СтатусСообщения.Внимание);
        КонецЕсли;
    Исключение
        MiddlewareТокен = "";
        Сообщить("ШАвторизация: " + ОписаниеОшибки(), СтатусСообщения.Внимание);
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ШЗаголовкиСАвторизацией()
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Content-Type", "application/json");
    Если Не ПустаяСтрока(MiddlewareТокен) Тогда
        Заголовки.Вставить("X-Auth-Token", MiddlewareТокен);
    КонецЕсли;
    Заголовки.Вставить("X-Request-ID", Строка(Новый УникальныйИдентификатор()));
    Возврат Заголовки;
КонецФункции

&НаСервере
Функция ШСоздатьСоединение()
    Адрес = СокрЛП(ШАдресСервера());
    
    // Убираем схему протокола http:// или https://
    ИндСхемы = СтрНайти(Адрес, "://");
    Если ИндСхемы > 0 Тогда
        Адрес = Сред(Адрес, ИндСхемы + 3);
    КонецЕсли;
    
    // Выделяем порт, если он указан через двоеточие
    Порт = 8000; // По умолчанию
    ИндПорта = СтрНайти(Адрес, ":");
    Если ИндПорта > 0 Тогда
        ПортСтрока = Сред(Адрес, ИндПорта + 1);
        Адрес = Лев(Адрес, ИндПорта - 1);
        Попытка
            Порт = Число(ПортСтрока);
        Исключение
            Порт = 8000;
        КонецПопытки;
    ИначеЕсли ИспользоватьHTTPS Тогда
        Порт = 443;
    КонецЕсли;
    
    // Убираем возможный слэш в конце хоста
    ИндСлэша = СтрНайти(Адрес, "/");
    Если ИндСлэша > 0 Тогда
        Адрес = Лев(Адрес, ИндСлэша - 1);
    КонецЕсли;
    
    Если ИспользоватьHTTPS Тогда
        Возврат Новый HTTPСоединение(Адрес, Порт, , , , 30,
            Новый ЗащищенноеСоединениеOpenSSL());
    Иначе
        Возврат Новый HTTPСоединение(Адрес, Порт, , , , 30);
    КонецЕсли;
КонецФункции

&НаСервере
Функция ШОтправитьHTTP(Путь, ТелоЗапроса, Метод)
    Попытка
        HTTP = ШСоздатьСоединение();
        Заголовки = ШЗаголовкиСАвторизацией();
        Запрос = Новый HTTPЗапрос(Путь, Заголовки);
        Если Не ПустаяСтрока(ТелоЗапроса) Тогда
            Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        КонецЕсли;
        Если Метод = "GET" Тогда
            Возврат HTTP.Получить(Запрос);
        ИначеЕсли Метод = "DELETE" Тогда
            Возврат HTTP.Удалить(Запрос);
        Иначе
            Возврат HTTP.ОтправитьДляОбработки(Запрос);
        КонецЕсли;
    Исключение
        Сообщить("ШHTTP-запрос " + Путь + ": " + ОписаниеОшибки(), СтатусСообщения.Внимание);
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

&НаСервере
Функция ШВыполнитьHTTPЗапрос(Путь, ТелоЗапроса = "", Метод = "POST")
    Ответ = ШОтправитьHTTP(Путь, ТелоЗапроса, Метод);
    Если Ответ <> Неопределено И Ответ.КодСостояния = 401 Тогда
        MiddlewareТокен = "";
        ШПолучитьТокенАвторизации();
        Если Не ПустаяСтрока(MiddlewareТокен) Тогда
            Ответ = ШОтправитьHTTP(Путь, ТелоЗапроса, Метод);
        КонецЕсли;
    КонецЕсли;
    Возврат Ответ;
КонецФункции

&НаСервере
Функция ШСериализоватьВJSON(Данные)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    Возврат ЗаписьJSON.Закрыть();
КонецФункции

&НаСервере
Функция ШДесериализоватьИзJSON(СтрокаJSON)
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
        Результат = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        Возврат Результат;
    Исключение
        Сообщить("ШJSON-десериализация: " + ОписаниеОшибки(), СтатусСообщения.Внимание);
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

&НаСервере
Функция ШЭкранироватьHTML(Текст)
    Если Текст = Неопределено Тогда Возврат ""; КонецЕсли;
    Результат = СтрЗаменить(Текст, "&", "&amp;");
    Результат = СтрЗаменить(Результат, "<", "&lt;");
    Результат = СтрЗаменить(Результат, ">", "&gt;");
    Результат = СтрЗаменить(Результат, """", "&quot;");
    Результат = СтрЗаменить(Результат, "'", "&#39;");
    Возврат Результат;
КонецФункции

