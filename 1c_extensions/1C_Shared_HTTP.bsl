// =============================================================================
// 1C_Shared_HTTP.bsl — Канонический шаблон общего HTTP/Auth/JSON-кода
// =============================================================================
//
// Требуемые реквизиты формы:
//   АдресMiddleware   (Строка, 150)  — адрес сервера, по умолчанию "http://127.0.0.1:8000"
//   ЛогинMiddleware   (Строка, 100)  — логин сервисного аккаунта, по умолчанию "1c_service"
//   ПарольMiddleware  (Строка, 100)  — пароль сервисного аккаунта, по умолчанию "1c_service_2024"
//   ИспользоватьHTTPS  (Булево)      — флаг HTTPS, по умолчанию Ложь
//   MiddlewareТокен   (Строка, 500)  — JWT-токен авторизации
//

// === SHARED_HTTP_START =======================================================

&НаСервере
Процедура ШПолучитьТокенАвторизации()
    Если Не ПустаяСтрока(MiddlewareТокен) Тогда
        Возврат;
    КонецЕсли;
    
    Попытка
        HTTP = ШСоздатьСоединение();
        Заголовки = Новый Соответствие;
        Заголовки.Вставить("Content-Type", "application/json");
        
        Запрос = Новый HTTPЗапрос("/auth/login", Заголовки);
        Тело = ШСериализоватьВJSON(Новый Структура("username, password", СокрЛП(ЛогинMiddleware), СокрЛП(ПарольMiddleware)));
        Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        
        Ответ = HTTP.ОтправитьДляОбработки(Запрос);
        Если Ответ.КодСостояния = 200 Тогда
            Структура = ШДесериализоватьИзJSON(Ответ.ПолучитьТелоКакСтроку());
            Если Структура <> Неопределено И Структура.Свойство("access_token") Тогда
                MiddlewareТокен = Структура.access_token;
            КонецЕсли;
        КонецЕсли;
    Исключение
        MiddlewareТокен = "";
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ШСоздатьСоединение()
    Адрес = СокрЛП(АдресMiddleware);
    
    ИспользоватьSSL = ИспользоватьHTTPS;
    Если СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
        ИспользоватьSSL = Истина;
        Адрес = Сред(Адрес, 9);
    ИначеЕсли СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
        Адрес = Сред(Адрес, 8);
    КонецЕсли;
    
    // Выделение порта
    Порт = ?(ИспользоватьSSL, 443, 8000);
    ИндПорта = СтрНайти(Адрес, ":");
    Если ИндПорта > 0 Тогда
        ПортСтрока = Сред(Адрес, ИндПорта + 1);
        Адрес = Лев(Адрес, ИндПорта - 1);
        Попытка
            Порт = Число(ПортСтрока);
        Исключение
            Порт = 8000;
        КонецПопытки;
    КонецЕсли;
    
    // Удаление завершающего слэша
    ИндСлэша = СтрНайти(Адрес, "/");
    Если ИндСлэша > 0 Тогда
        Адрес = Лев(Адрес, ИндСлэша - 1);
    КонецЕсли;
    
    Если ИспользоватьSSL Тогда
        Возврат Новый HTTPСоединение(Адрес, Порт, , , , 30, Новый ЗащищенноеСоединениеOpenSSL());
    Иначе
        Возврат Новый HTTPСоединение(Адрес, Порт, , , , 30);
    КонецЕсли;
КонецФункции

&НаСервере
Функция ШЗаголовкиСАвторизацией()
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Content-Type", "application/json");
    Если Не ПустаяСтрока(MiddlewareТокен) Тогда
        Заголовки.Вставить("X-Auth-Token", MiddlewareТокен);
    КонецЕсли;
    Заголовки.Вставить("X-Request-ID", Строка(Новый УникальныйИдентификатор()));
    Возврат Заголовки;
КонецФункции

&НаСервере
Функция ШОтправитьHTTP(Путь, ТелоЗапроса, Метод)
    Попытка
        HTTP = ШСоздатьСоединение();
        Заголовки = ШЗаголовкиСАвторизацией();
        Запрос = Новый HTTPЗапрос(Путь, Заголовки);
        
        Если Не ПустаяСтрока(ТелоЗапроса) Тогда
            Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        КонецЕсли;
        
        Если Метод = "GET" Тогда
            Возврат HTTP.Получить(Запрос);
        ИначеЕсли Метод = "DELETE" Тогда
            Возврат HTTP.Удалить(Запрос);
        Иначе
            Возврат HTTP.ОтправитьДляОбработки(Запрос);
        КонецЕсли;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

&НаСервере
Функция ШВыполнитьHTTPЗапрос(Путь, ТелоЗапроса = "", Метод = "POST")
    Ответ = ШОтправитьHTTP(Путь, ТелоЗапроса, Метод);
    // Автоматический ретрай с повторным получением токена при ошибке 401 Unauthorized
    Если Ответ <> Неопределено И Ответ.КодСостояния = 401 Тогда
        MiddlewareТокен = "";
        ШПолучитьТокенАвторизации();
        Если Не ПустаяСтрока(MiddlewareТокен) Тогда
            Ответ = ШОтправитьHTTP(Путь, ТелоЗапроса, Метод);
        КонецЕсли;
    КонецЕсли;
    Возврат Ответ;
КонецФункции

&НаСервереБезКонтекста
Функция ШСериализоватьВJSON(Данные)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    Возврат ЗаписьJSON.Закрыть();
КонецФункции

&НаСервереБезКонтекста
Функция ШДесериализоватьИзJSON(СтрокаJSON)
    Если ПустаяСтрока(СтрокаJSON) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
        Результат = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        Возврат Результат;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ШЭкранироватьHTML(Текст)
    Если Текст = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Рез = СтрЗаменить(Текст, "&", "&amp;");
    Рез = СтрЗаменить(Рез, "<", "&lt;");
    Рез = СтрЗаменить(Рез, ">", "&gt;");
    Рез = СтрЗаменить(Рез, """", "&quot;");
    Рез = СтрЗаменить(Рез, "'", "&#39;");
    Возврат Рез;
КонецФункции

// === SHARED_HTTP_END =========================================================
