// =============================================================================
// Форма задачи — нативная форма редактирования задачи в 1С
// =============================================================================

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    НастроитьТипыРеквизитов();
    Элементы.Состояние.СписокВыбора.Очистить();
    Элементы.Состояние.СписокВыбора.Добавить("todo", "К выполнению");
    Элементы.Состояние.СписокВыбора.Добавить("in_progress", "В работе");
    Элементы.Состояние.СписокВыбора.Добавить("review", "На проверке");
    Элементы.Состояние.СписокВыбора.Добавить("done", "Готово");
    
    Элементы.Важность.СписокВыбора.Очистить();
    Попытка
        Элементы.Важность.СписокВыбора.Добавить(Перечисления.ВариантыВажностиЗадачи.Высокая, "Высокая (Срочно)");
        Элементы.Важность.СписокВыбора.Добавить(Перечисления.ВариантыВажностиЗадачи.Обычная, "Обычная (Средняя)");
        Элементы.Важность.СписокВыбора.Добавить(Перечисления.ВариантыВажностиЗадачи.Низкая, "Низкая");
    Исключение КонецПопытки;
    
    КлючУИД = "";
    Если Параметры.Свойство("Ключ", КлючУИД) И ЗначениеЗаполнено(КлючУИД) Тогда
        СсылкаУИД = Строка(КлючУИД);
        ЗагрузитьЗадачуИз1СНаСервере(СсылкаУИД);
    Иначе
        Наименование = "";
        Описание = "";
        Состояние = "todo";
        Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
        СрокИсполнения = ТекущаяДата() + (86400 * 2);
        
        Попытка
            Исполнитель = Пользователи.АвторизованныйПользователь();
        Исключение
            ЗаписьЖурналаРегистрации("AIAssistant.ЗаполнениеИсполнителя", УровеньЖурналаРегистрации.Предупреждение,
                , , "Не удалось определить текущего пользователя. Выберите исполнителя вручную.");
        КонецПопытки;
    КонецЕсли;
КонецПроцедуры

// В XML расширения ссылки универсальны, поскольку объекты типовой УНФ не заимствованы.
// Стандартные поля выбора ограничены конкретными типами работающей конфигурации.
&НаСервере
Процедура НастроитьТипыРеквизитов()
    Элементы.Контрагент.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
    Элементы.ЗаказПокупателя.ОграничениеТипа = Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя");
    Элементы.Исполнитель.ОграничениеТипа = Метаданные.Задачи.ЗадачаИсполнителя.РеквизитыАдресации.Исполнитель.Тип;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказПокупателяПриИзменении(Элемент)
    ЗаполнитьКонтрагентаПоЗаказу();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтрагентаПоЗаказу()
    Если ЗначениеЗаполнено(ЗаказПокупателя) Тогда
        Контрагент = ЗаказПокупателя.Контрагент;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
    СброситьНесогласованныйЗаказ();
КонецПроцедуры

&НаСервере
Процедура СброситьНесогласованныйЗаказ()
    Если ЗначениеЗаполнено(ЗаказПокупателя) И ЗаказПокупателя.Контрагент <> Контрагент Тогда
        ЗаказПокупателя = Документы.ЗаказПокупателя.ПустаяСсылка();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЗадачуИз1СНаСервере(УИДСтрока)
    Попытка
        УИД = Новый УникальныйИдентификатор(УИДСтрока);
        Ссылка = Задачи.ЗадачаИсполнителя.ПолучитьСсылку(УИД);
        Если ЗначениеЗаполнено(Ссылка) Тогда
            Наименование = Ссылка.Наименование;
            Описание = Ссылка.Описание;
            Важность = Ссылка.Важность;
            СрокИсполнения = Ссылка.СрокИсполнения;
            Исполнитель = Ссылка.Исполнитель;
            
            Если ТипЗнч(Ссылка.Предмет) = Тип("СправочникСсылка.Контрагенты") Тогда
                Контрагент = Ссылка.Предмет;
            ИначеЕсли ТипЗнч(Ссылка.Предмет) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
                ЗаказПокупателя = Ссылка.Предмет;
                Контрагент = ЗаказПокупателя.Контрагент;
            КонецЕсли;
            
            Если Ссылка.Выполнена Тогда
                Состояние = "done";
            ИначеЕсли Ссылка.Важность = Перечисления.ВариантыВажностиЗадачи.Высокая И Ссылка.ПринятаКИсполнению Тогда
                Состояние = "review";
            ИначеЕсли Ссылка.ПринятаКИсполнению Тогда
                Состояние = "in_progress";
            Иначе
                Состояние = "todo";
            КонецЕсли;
        КонецЕсли;
    Исключение КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрытьНажатие(Команда)
    Если ПустаяСтрока(Наименование) Тогда
        ПоказатьПредупреждение(, "Укажите тему или наименование задачи!");
        Возврат;
    КонецЕсли;
    
    ЗаписатьЗадачуНаСервере();
    Оповестить("ЗадачиОбновлены");
    Закрыть();
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЗадачуНаСервере()
    Если ЗначениеЗаполнено(Контрагент) И ТипЗнч(Контрагент) <> Тип("СправочникСсылка.Контрагенты") Тогда
        ВызватьИсключение "Выберите контрагента из справочника контрагентов.";
    КонецЕсли;
    Если ЗначениеЗаполнено(ЗаказПокупателя) И ТипЗнч(ЗаказПокупателя) <> Тип("ДокументСсылка.ЗаказПокупателя") Тогда
        ВызватьИсключение "Выберите документ заказа покупателя.";
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Исполнитель) Тогда
        ВызватьИсключение "Выберите ответственного исполнителя задачи.";
    КонецЕсли;
    Если Не Метаданные.Задачи.ЗадачаИсполнителя.РеквизитыАдресации.Исполнитель.Тип.СодержитТип(ТипЗнч(Исполнитель)) Тогда
        ВызватьИсключение "Выберите исполнителя допустимого для задачи типа.";
    КонецЕсли;
    Если ЗначениеЗаполнено(ЗаказПокупателя) Тогда
        Если ЗаказПокупателя.Контрагент <> Контрагент Тогда
            ВызватьИсключение "Контрагент не соответствует выбранному заказу покупателя.";
        КонецЕсли;
    КонецЕсли;
    Попытка
        мОбъектЗадачи = Неопределено;
        Если ЗначениеЗаполнено(СсылкаУИД) Тогда
            УИД = Новый УникальныйИдентификатор(СсылкаУИД);
            Ссылка = Задачи.ЗадачаИсполнителя.ПолучитьСсылку(УИД);
            Если ЗначениеЗаполнено(Ссылка) Тогда
                мОбъектЗадачи = Ссылка.ПолучитьОбъект();
            КонецЕсли;
        КонецЕсли;
        
        Если мОбъектЗадачи = Неопределено Тогда
            мОбъектЗадачи = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
            мОбъектЗадачи.Дата = ТекущаяДата();
            Попытка
                мОбъектЗадачи.Автор = Пользователи.АвторизованныйПользователь();
            Исключение КонецПопытки;
        КонецЕсли;
        
        мОбъектЗадачи.Наименование = СокрЛП(Наименование);
        мОбъектЗадачи.Описание = Описание;
        мОбъектЗадачи.Важность = Важность;
        мОбъектЗадачи.СрокИсполнения = СрокИсполнения;
        
        мОбъектЗадачи.Исполнитель = Исполнитель;
        
        Если ЗначениеЗаполнено(ЗаказПокупателя) Тогда
            мОбъектЗадачи.Предмет = ЗаказПокупателя;
        ИначеЕсли ЗначениеЗаполнено(Контрагент) Тогда
            мОбъектЗадачи.Предмет = Контрагент;
        ИначеЕсли ТипЗнч(мОбъектЗадачи.Предмет) = Тип("СправочникСсылка.Контрагенты")
            Или ТипЗнч(мОбъектЗадачи.Предмет) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
            // Очистка полей должна сохраняться; чужие виды предмета задачи не затрагиваем.
            мОбъектЗадачи.Предмет = Неопределено;
        КонецЕсли;
        
        Если Состояние = "todo" Тогда
            мОбъектЗадачи.ПринятаКИсполнению = Ложь;
            мОбъектЗадачи.Выполнена = Ложь;
        ИначеЕсли Состояние = "in_progress" Тогда
            мОбъектЗадачи.ПринятаКИсполнению = Истина;
            мОбъектЗадачи.Выполнена = Ложь;
        ИначеЕсли Состояние = "review" Тогда
            мОбъектЗадачи.ПринятаКИсполнению = Истина;
            мОбъектЗадачи.Выполнена = Ложь;
            мОбъектЗадачи.Важность = Перечисления.ВариантыВажностиЗадачи.Высокая;
        ИначеЕсли Состояние = "done" Тогда
            мОбъектЗадачи.Выполнена = Истина;
            мОбъектЗадачи.ДатаИсполнения = ТекущаяДата();
        КонецЕсли;
        
        мОбъектЗадачи.ОбменДанными.Загрузка = Истина;
        мОбъектЗадачи.Записать();
        СсылкаУИД = Строка(мОбъектЗадачи.Ссылка.УникальныйИдентификатор());
    Исключение
        ВызватьИсключение "Ошибка сохранения задачи в 1С: " + ОписаниеОшибки();
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗадачуНажатие(Команда)
    Если ПустаяСтрока(СсылкаУИД) Тогда
        Закрыть();
        Возврат;
    КонецЕсли;
    
    ПометитьУдалениеНаСервере(СсылкаУИД);
    Оповестить("ЗадачиОбновлены");
    Закрыть();
КонецПроцедуры

&НаСервере
Процедура ПометитьУдалениеНаСервере(УИДСтрока)
    Попытка
        УИД = Новый УникальныйИдентификатор(УИДСтрока);
        Ссылка = Задачи.ЗадачаИсполнителя.ПолучитьСсылку(УИД);
        Если ЗначениеЗаполнено(Ссылка) Тогда
            мОбъектЗадачи = Ссылка.ПолучитьОбъект();
            Если мОбъектЗадачи <> Неопределено Тогда
                мОбъектЗадачи.ОбменДанными.Загрузка = Истина;
                мОбъектЗадачи.УстановитьПометкуУдаления(Истина);
            КонецЕсли;
        КонецЕсли;
    Исключение КонецПопытки;
КонецПроцедуры
