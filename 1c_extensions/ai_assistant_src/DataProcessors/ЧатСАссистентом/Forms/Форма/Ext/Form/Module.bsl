КонецПроцедуры

&НаКлиенте
Функция ШПолучитьПараметр(Параметры, Ключ, Знач ПоУмолчанию = "")
    Если ТипЗнч(Параметры) = Тип("Структура") Тогда
        ЗначРез = Неопределено;
        Если Параметры.Свойство(Ключ, ЗначРез) Тогда
            Возврат ?(ЗначРез <> Неопределено, Строка(ЗначРез), ПоУмолчанию);
        КонецЕсли;
    ИначеЕсли ТипЗнч(Параметры) = Тип("Соответствие") Тогда
        ЗначРез = Параметры.Получить(Ключ);
        Если ЗначРез <> Неопределено Тогда
            Возврат Строка(ЗначРез);
        КонецЕсли;
    КонецЕсли;
    Возврат ПоУмолчанию;
КонецФункции

&НаКлиенте
Функция РазобратьПараметрыURL(СтрокаПараметров)
    Результат = Новый Структура;
    Если ПустаяСтрока(СтрокаПараметров) Тогда
        Возврат Результат;
    КонецЕсли;
    
    МассивПар = СтрРазделить(СтрокаПараметров, "&");
    Для Каждого Пара Из МассивПар Цикл
        ИндРавно = СтрНайти(Пара, "=");
        Если ИндРавно > 0 Тогда
            Ключ = СокрЛП(Лев(Пара, ИндРавно - 1));
            Значение = Сред(Пара, ИндРавно + 1);
            Значение = СтрЗаменить(Значение, "+", " ");
            Значение = СтрЗаменить(Значение, "%20", " ");
            Значение = СтрЗаменить(Значение, "%23", "#");
            Значение = СтрЗаменить(Значение, "%26", "&");
            Значение = СтрЗаменить(Значение, "%3D", "=");
            Значение = СтрЗаменить(Значение, "%2F", "/");
            Значение = СтрЗаменить(Значение, "%3A", ":");
            Значение = СтрЗаменить(Значение, "%3F", "?");
            Попытка
                Результат.Вставить(Ключ, Значение);
            Исключение
            КонецПопытки;
        КонецЕсли;
    КонецЦикла;
    
    Возврат Результат;
КонецФункции

