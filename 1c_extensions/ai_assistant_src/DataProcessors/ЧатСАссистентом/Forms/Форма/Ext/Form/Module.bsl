//
// Реквизиты формы:
//   АдресMiddleware   (Строка, 150)  — адрес сервера middleware (по умолчанию "http://127.0.0.1:8000")
//   ЛогинMiddleware   (Строка, 100)  — логин сервисного аккаунта ("1c_service")
//   ПарольMiddleware  (Строка, 100)  — пароль сервисного аккаунта ("1c_service_2024")
//   ИспользоватьHTTPS  (Булево)      — использование защищенного протокола HTTPS
//   MiddlewareТокен   (Строка, 500)  — действующий JWT-токен доступа
//   ЧатИстория        (ТаблицаЗначений / ТабличнаяЧасть) — Автор, Текст, Время, ТипСообщения, Действие, ДанныеJSON
//   ЧатHTML           (Строка)       — HTML-разметка отображаемого чата
//   ТекстСообщения    (Строка, 1000) — поле ввода сообщения пользователя
//   ФлагЗагрузки      (Булево)       — индикатор ожидания ответа от модели
//

// =============================================================================
// 1. ИНИЦИАЛИЗАЦИЯ И СОБЫТИЯ ФОРМЫ
// =============================================================================

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    MiddlewareТокен = "";
    ФлагЗагрузки = Ложь;
    
    Если ПустаяСтрока(АдресMiddleware) Тогда
        АдресMiddleware = "http://127.0.0.1:8000";
    КонецЕсли;
    Если ПустаяСтрока(ЛогинMiddleware) Тогда
        ЛогинMiddleware = "1c_service";
    КонецЕсли;
    Если ПустаяСтрока(ПарольMiddleware) Тогда
        ПарольMiddleware = "1c_service_2024";
    КонецЕсли;
    
    Если ЧатИстория.Количество() = 0 Тогда
        Приветствие = "Здравствуйте! Я интеллектуальный ассистент 1С:УНФ." + Символы.ПС
            + "Помогу найти информацию, сформировать документы, проверить остатки и должников, либо поставить задачу на канбан-доску." + Символы.ПС
            + "Задайте вопрос в свободной форме или воспользуйтесь быстрыми кнопками вверху.";
        ДобавитьСообщениеВЧатНаСервере(Приветствие, "bot", "expert_answer", Неопределено);
    КонецЕсли;
    
    ЧатHTML = СгенерироватьЧатHTML();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
    Если ПустаяСтрока(АдресMiddleware) Тогда
        АдресMiddleware = "http://127.0.0.1:8000";
    КонецЕсли;
    ПолучитьТокенАвторизацииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДобавитьСообщениеВЧатНаСервере(Знач Текст, Знач ТипСообщения = "bot", Знач Действие = "", Знач ДанныеJSON = "")
    СтрокаЧата = ЧатИстория.Добавить();
    СтрокаЧата.Текст = Текст;
    СтрокаЧата.ТипСообщения = ТипСообщения;
    СтрокаЧата.Время = Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm");
    
    Попытка
        СтрокаЧата.Автор = ?(ТипСообщения = "user", "Вы", "AI Ассистент");
    Исключение КонецПопытки;
    
    Попытка
        СтрокаЧата.Действие = Действие;
    Исключение КонецПопытки;
    
    Попытка
        Если ЗначениеЗаполнено(ДанныеJSON) Тогда
            Если ТипЗнч(ДанныеJSON) = Тип("Строка") Тогда
                СтрокаЧата.ДанныеJSON = ДанныеJSON;
            Иначе
                СтрокаЧата.ДанныеJSON = ШСериализоватьВJSON(ДанныеJSON);
            КонецЕсли;
        КонецЕсли;
    Исключение КонецПопытки;
КонецПроцедуры


