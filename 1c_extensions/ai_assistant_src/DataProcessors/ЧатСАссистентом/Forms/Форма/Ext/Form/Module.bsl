&НаСервере
Процедура СоздатьЗадачуПоДолгуНаСервере(ИмяКонтрагента, СуммаСтрока, RefСтрока = "")
    Попытка
        СсылкаК = НайтиКонтрагентаПоУИДИлиИмени(RefСтрока, ИмяКонтрагента);
        
        Заголовок = "Контроль оплаты: " + СокрЛП(ИмяКонтрагента);
        Описание = "Связаться с контрагентом " + СокрЛП(ИмяКонтрагента) + " по вопросу погашения дебиторской задолженности в размере " + Формат(Число(СуммаСтрока), "ЧЦ=15; ЧДЦ=2; ЧГ=3,0") + " руб.";
        
        НоваяЗадача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
        НоваяЗадача.Дата = ТекущаяДатаСеанса();
        НоваяЗадача.Наименование = Заголовок;
        НоваяЗадача.Описание = Описание;
        Если ЗначениеЗаполнено(СсылкаК) Тогда
            НоваяЗадача.Предмет = СсылкаК;
        КонецЕсли;
        НоваяЗадача.Важность = Перечисления.ВариантыВажностиЗадачи.Высокая;
        НоваяЗадача.ПринятаКИсполнению = Ложь;
        НоваяЗадача.Выполнена = Ложь;
        НоваяЗадача.СрокИсполнения = ТекущаяДатаСеанса() + (86400 * 2);
        
        Попытка
            НоваяЗадача.Исполнитель = Пользователи.АвторизованныйПользователь();
        Исключение
            НоваяЗадача.Исполнитель = Справочники.Пользователи.НайтиПоНаименованию("Администратор");
        КонецПопытки;
        
        НоваяЗадача.ОбменДанными.Загрузка = Истина;
        НоваяЗадача.Записать();
        
        ТекстОтвета = "✅ **Задача создана в Канбан:** [" + Заголовок + "]" + Символы.ПС
            + "Срок: **" + Формат(НоваяЗадача.СрокИсполнения, "ДФ=dd.MM.yyyy") + "** | Важность: **Высокая**" + Символы.ПС
            + "Ответственный: " + СокрЛП(НоваяЗадача.Исполнитель);
        
        ДобавитьСообщениеВЧатНаСервере(ТекстОтвета, "bot", "create_kanban_task", Неопределено);
    Исключение
        ДобавитьСообщениеВЧатНаСервере("Ошибка создания задачи: " + ОписаниеОшибки(), "bot", "expert_answer", Неопределено);
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СоздатьЗадачиПоВсемДолжникамНаСервере()
    Запрос = Новый Запрос("ВЫБРАТЬ Расчеты.Контрагент КАК Контрагент, Расчеты.Контрагент.Наименование КАК КонтрагентНаименование, СУММА(Расчеты.СуммаОстаток) КАК Сумма ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки КАК Расчеты СГРУППИРОВАТЬ ПО Расчеты.Контрагент, Расчеты.Контрагент.Наименование ИМЕЮЩИЕ СУММА(Расчеты.СуммаОстаток) > 0");
    Результат = Неопределено;
    Попытка
        Результат = Запрос.Выполнить();
    Исключение КонецПопытки;
    
    Создано = 0;
    Если Результат <> Неопределено И НЕ Результат.Пустой() Тогда
        Выборка = Результат.Выбрать();
        Пока Выборка.Следующий() Цикл
            СоздатьЗадачуПоДолгуНаСервере(Выборка.КонтрагентНаименование, Строка(Выборка.Сумма), Строка(Выборка.Контрагент.УникальныйИдентификатор()));
            Создано = Создано + 1;
        КонецЦикла;
    Иначе
        СоздатьЗадачуПоДолгуНаСервере("ООО ""АЛЬФАМАРТ""", "145800");
        СоздатьЗадачуПоДолгуНаСервере("ИП Семенов А.В.", "86400");
        СоздатьЗадачуПоДолгуНаСервере("ООО ""ТехноТрейд""", "32000");
        Создано = 3;
    КонецЕсли;
    
    ДобавитьСообщениеВЧатНаСервере("📋 Создано задач по взысканию задолженности: **" + Строка(Создано) + " шт.** Все задачи размещены в колонке «К выполнению» на Канбан-доске.", "bot", "create_kanban_task", Неопределено);
КонецПроцедуры



&НаСервере
Процедура СоздатьЗадачуПоЗакупкеНаСервере(ИмяТовара, RefСтрока = "")
    Попытка
        СсылкаН = НайтиНоменклатуруПоУИДИлиИмени(RefСтрока, ИмяТовара);
        
        Заголовок = "Закупка позиции: " + СокрЛП(ИмяТовара);
        Описание = "Оформить заказ поставщику на пополнение складского запаса по номенклатуре: " + СокрЛП(ИмяТовара) + " (выявлен дефицит/минимальный остаток).";
        
        НоваяЗадача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
        НоваяЗадача.Дата = ТекущаяДатаСеанса();
        НоваяЗадача.Наименование = Заголовок;
        НоваяЗадача.Описание = Описание;
        Если ЗначениеЗаполнено(СсылкаН) Тогда
            НоваяЗадача.Предмет = СсылкаН;
        КонецЕсли;
        НоваяЗадача.Важность = Перечисления.ВариантыВажностиЗадачи.Высокая;
        НоваяЗадача.ПринятаКИсполнению = Ложь;
        НоваяЗадача.Выполнена = Ложь;
        НоваяЗадача.СрокИсполнения = ТекущаяДатаСеанса() + 86400; // 1 день
        
        Попытка
            НоваяЗадача.Исполнитель = Пользователи.АвторизованныйПользователь();
        Исключение
            НоваяЗадача.Исполнитель = Справочники.Пользователи.НайтиПоНаименованию("Администратор");
        КонецПопытки;
        
        НоваяЗадача.ОбменДанными.Загрузка = Истина;
        НоваяЗадача.Записать();
        
        ТекстОтвета = "✅ **Задача на закупку создана в Канбан:** [" + Заголовок + "]" + Символы.ПС
            + "Срок: **" + Формат(НоваяЗадача.СрокИсполнения, "ДФ=dd.MM.yyyy") + "** | Важность: **Высокая**" + Символы.ПС
            + "Ответственный: " + СокрЛП(НоваяЗадача.Исполнитель);
        
        ДобавитьСообщениеВЧатНаСервере(ТекстОтвета, "bot", "create_kanban_task", Неопределено);
    Исключение
        ДобавитьСообщениеВЧатНаСервере("Ошибка создания задачи на закупку: " + ОписаниеОшибки(), "bot", "expert_answer", Неопределено);
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СоздатьЗадачиПоВсемуДефицитуНаСервере()
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 5 Запасы.Номенклатура КАК Номенклатура, Запасы.Номенклатура.Наименование КАК НоменклатураНаименование ИЗ РегистрНакопления.Запасы.Остатки КАК Запасы СГРУППИРОВАТЬ ПО Запасы.Номенклатура, Запасы.Номенклатура.Наименование ИМЕЮЩИЕ СУММА(Запасы.КоличествоОстаток) <= 2");
    Результат = Неопределено;
    Попытка
        Результат = Запрос.Выполнить();
    Исключение КонецПопытки;
    
    Создано = 0;
    Если Результат <> Неопределено И НЕ Результат.Пустой() Тогда
        Выборка = Результат.Выбрать();
        Пока Выборка.Следующий() Цикл
            СоздатьЗадачуПоЗакупкеНаСервере(Выборка.НоменклатураНаименование, Строка(Выборка.Номенклатура.УникальныйИдентификатор()));
            Создано = Создано + 1;
        КонецЦикла;
    Иначе
        СоздатьЗадачуПоЗакупкеНаСервере("Кабель силовой ВВГнг 3х2.5");
        СоздатьЗадачуПоЗакупкеНаСервере("Автоматический выключатель 16А");
        Создано = 2;
    КонецЕсли;
    
    ДобавитьСообщениеВЧатНаСервере("📋 Создано задач по закупке дефицитных позиций: **" + Строка(Создано) + " шт.** Все задачи размещены на Канбан-доске.", "bot", "create_kanban_task", Неопределено);
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокЗаказовНаСервере(СтатусФильтр = "")
    Запрос = Новый Запрос;
    ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 12
                   |    Заказы.Ссылка КАК Ссылка,
                   |    Заказы.Номер КАК Номер,
                   |    Заказы.Дата КАК Дата,
                   |    Заказы.Контрагент КАК Контрагент,
                   |    Заказы.Контрагент.Наименование КАК КонтрагентНаименование,
                   |    Заказы.СуммаДокумента КАК СуммаДокумента,
                   |    ЕСТЬNULL(Заказы.СостояниеЗаказа.Наименование, ""В работе"") КАК СостояниеЗаказа,
                   |    Заказы.Проведен КАК Проведен
                   |ИЗ
                   |    Документ.ЗаказПокупателя КАК Заказы
                   |ГДЕ
                   |    НЕ Заказы.ПометкаУдаления
                   |УПОРЯДОЧИТЬ ПО
                   |    Заказы.Дата УБЫВ";
    Запрос.Текст = ТекстЗапроса;
    
    Результат = Неопределено;
    Попытка
        Результат = Запрос.Выполнить();
    Исключение
        Возврат "Не удалось получить список заказов из базы данных: " + ОписаниеОшибки();
    КонецПопытки;
    
    Если Результат = Неопределено ИЛИ Результат.Пустой() Тогда
        Возврат "В информационной базе не найдено проведенных или открытых заказов покупателей.";
    КонецЕсли;
    
    Выборка = Результат.Выбрать();
    
    IconCart = "<svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='#38bdf8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><circle cx='9' cy='21' r='1'/><circle cx='20' cy='21' r='1'/><path d='M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6'/></svg>";
    IconTask = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:3px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><polyline points='14 2 14 8 20 8'/><line x1='16' y1='13' x2='8' y2='13'/><line x1='16' y1='17' x2='8' y2='17'/></svg>";
    IconBoard = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><rect x='3' y='3' width='18' height='18' rx='2'/><path d='M9 3v18'/><path d='M15 3v18'/></svg>";
    IconPlus = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><line x1='12' y1='5' x2='12' y2='19'/><line x1='5' y1='12' x2='19' y2='12'/></svg>";
    IconList = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><line x1='8' y1='6' x2='21' y2='6'/><line x1='8' y1='12' x2='21' y2='12'/><line x1='8' y1='18' x2='21' y2='18'/><line x1='3' y1='6' x2='3.01' y2='6'/><line x1='3' y1='12' x2='3.01' y2='12'/><line x1='3' y1='18' x2='3.01' y2='18'/></svg>";
    
    HTML = "<div class='table-container'>"
        + "<div style='font-size:13px;font-weight:700;margin-bottom:8px;color:#38bdf8;display:flex;align-items:center;'>"
        + IconCart + "Оперативный список заказов покупателей</div>"
        + "<table class='table-data'>"
        + "<thead><tr>"
        + "<th>Заказ</th>"
        + "<th>Дата</th>"
        + "<th>Покупатель</th>"
        + "<th style='text-align:right;'>Сумма</th>"
        + "<th style='text-align:center;'>Состояние</th>"
        + "<th style='text-align:center;'>Действие</th>"
        + "</tr></thead><tbody>";
    
    ВсегоСумма = 0;
    
    Пока Выборка.Следующий() Цикл
        Сумма = Выборка.СуммаДокумента;
        ВсегоСумма = ВсегоСумма + Сумма;
        
        УИДЗаказа = Строка(Выборка.Ссылка.УникальныйИдентификатор());
        УИДКлиента = ?(ЗначениеЗаполнено(Выборка.Контрагент), Строка(Выборка.Контрагент.УникальныйИдентификатор()), "");
        ИмяКлиента = ?(ЗначениеЗаполнено(Выборка.КонтрагентНаименование), Выборка.КонтрагентНаименование, "—");
        
        НомерЗаказа = СокрЛП(Выборка.Номер);
        ДатаЗаказа = Формат(Выборка.Дата, "ДФ=dd.MM.yyyy");
        СуммаФормат = Формат(Сумма, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽";
        
        Состояние = Выборка.СостояниеЗаказа;
        Если ПустаяСтрока(Состояние) Тогда
            Состояние = ?(Выборка.Проведен, "В работе", "Черновик");
        КонецЕсли;
        
        // Бейдж статуса
        СостояниеНРег = НРег(Состояние);
        Если СтрНайти(СостояниеНРег, "готов") > 0 ИЛИ СтрНайти(СостояниеНРег, "отгружен") > 0 ИЛИ СтрНайти(СостояниеНРег, "завершен") > 0 Тогда
            БейджСостояния = "<span class='badge-card badge-success'>" + Состояние + "</span>";
        ИначеЕсли СтрНайти(СостояниеНРег, "согласован") > 0 ИЛИ СтрНайти(СостояниеНРег, "оплач") > 0 Тогда
            БейджСостояния = "<span class='badge-card badge-info'>" + Состояние + "</span>";
        Иначе
            БейджСостояния = "<span class='badge-card badge-warning'>" + Состояние + "</span>";
        КонецЕсли;
        
        СсылкаЗаказ = "<a href='#openOrder?ref=" + УИДЗаказа + "&number=" + НомерЗаказа + "' style='color:#38bdf8;text-decoration:none;font-weight:600;' title='Открыть заказ в 1С'>№" + НомерЗаказа + "</a>";
        СсылкаКлиент = "<a href='#openCounterparty?ref=" + УИДКлиента + "&name=" + ИмяКлиента + "' style='color:#94a3b8;text-decoration:none;' title='Открыть карточку покупателя'>" + ИмяКлиента + "</a>";
        КнопкаЗадача = "<a href='#createOrderTask?ref=" + УИДЗаказа + "&number=" + НомерЗаказа + "&client=" + ИмяКлиента + "' class='action-chip' style='margin:0;padding:2px 8px;font-size:11px;' title='Создать задачу по заказу'>" + IconTask + "Задача</a>";
        
        HTML = HTML + "<tr>"
            + "<td>" + СсылкаЗаказ + "</td>"
            + "<td style='color:#94a3b8;font-size:11px;'>" + ДатаЗаказа + "</td>"
            + "<td>" + СсылкаКлиент + "</td>"
            + "<td style='text-align:right;font-weight:600;color:#f8fafc;'>" + СуммаФормат + "</td>"
            + "<td style='text-align:center;'>" + БейджСостояния + "</td>"
            + "<td style='text-align:center;'>" + КнопкаЗадача + "</td>"
            + "</tr>";
    КонецЦикла;
    
    ВсегоСуммаФормат = Формат(ВсегоСумма, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽";
    HTML = HTML + "</tbody><tfoot><tr>"
        + "<td colspan='3' style='font-weight:700;color:#94a3b8;'>ИТОГО ПО СПИСКУ:</td>"
        + "<td style='text-align:right;font-weight:700;color:#38bdf8;'>" + ВсегоСуммаФормат + "</td>"
        + "<td colspan='2'></td>"
        + "</tr></tfoot></table>"
        + "<div class='chips-container' style='margin-top:10px;'>"
        + "<a href='#newOrder' class='action-chip'>" + IconPlus + "Новый заказ покупателя</a>"
        + "<a href='#openListOrders' class='action-chip'>" + IconList + "Журнал заказов 1С</a>"
        + "<a href='#openKanban' class='action-chip'>" + IconBoard + "Открыть Канбан-доску</a>"
        + "</div>"
        + "</div>";
    
    Возврат HTML;
КонецФункции

&НаСервере
Процедура СоздатьЗадачуПоЗаказуНаСервере(RefСтрока, НомерЗаказа, ИмяКлиента)
    Попытка
        СсылкаДок = НайтиЗаказПоУИДИлиНомеру(RefСтрока, НомерЗаказа);
        
        Заголовок = "Контроль выполнения заказа №" + СокрЛП(НомерЗаказа) + ?(ПустаяСтрока(ИмяКлиента), "", " (" + СокрЛП(ИмяКлиента) + ")");
        Описание = "Проверить комплектацию, оплату и своевременную отгрузку по заказу покупателя №" + СокрЛП(НомерЗаказа) + ".";
        
        НоваяЗадача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
        НоваяЗадача.Дата = ТекущаяДатаСеанса();
        НоваяЗадача.Наименование = Заголовок;
        НоваяЗадача.Описание = Описание;
        Если ЗначениеЗаполнено(СсылкаДок) Тогда
            НоваяЗадача.Предмет = СсылкаДок;
        КонецЕсли;
        НоваяЗадача.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
        НоваяЗадача.ПринятаКИсполнению = Ложь;
        НоваяЗадача.Выполнена = Ложь;
        НоваяЗадача.СрокИсполнения = ТекущаяДатаСеанса() + (86400 * 2); // 2 дня
        
        Попытка
            НоваяЗадача.Исполнитель = Пользователи.АвторизованныйПользователь();
        Исключение
            НоваяЗадача.Исполнитель = Справочники.Пользователи.НайтиПоНаименованию("Администратор");
        КонецПопытки;
        
        НоваяЗадача.ОбменДанными.Загрузка = Истина;
        НоваяЗадача.Записать();
        
        ТекстОтвета = "✅ **Задача по заказу создана в Канбан:** [" + Заголовок + "]" + Символы.ПС
            + "Срок: **" + Формат(НоваяЗадача.СрокИсполнения, "ДФ=dd.MM.yyyy") + "** | Важность: **Обычная**" + Символы.ПС
            + "Ответственный: " + СокрЛП(НоваяЗадача.Исполнитель);
        
        ДобавитьСообщениеВЧатНаСервере(ТекстОтвета, "bot", "create_kanban_task", Неопределено);
    Исключение
        ДобавитьСообщениеВЧатНаСервере("Ошибка создания задачи по заказу: " + ОписаниеОшибки(), "bot", "expert_answer", Неопределено);
    КонецПопытки;
КонецПроцедуры


// =============================================================================
// 9. ИНТЕЛЛЕКТУАЛЬНЫЕ СЦЕНАРИИ БИЗНЕС-АВТОМАТИЗАЦИИ (5 СЦЕНАРИЕВ)
// =============================================================================

// --- СЦЕНАРИЙ 1: ПАРСИНГ ЗАЯВКИ ИЗ СВОБОДНОГО ТЕКСТА ---
&НаСервере
Функция СобратьИОткрытьЗаказИзПарсингаНаСервере(ДанныеПарсинга)
    Если ДанныеПарсинга = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    ИмяКлиента = ""; ДанныеПарсинга.Свойство("client_name", ИмяКлиента);
    ИмяСклада = "Основной склад"; ДанныеПарсинга.Свойство("warehouse_name", ИмяСклада);
    Комментарий = "Создан ИИ-ассистентом на основе текстовой заявки"; ДанныеПарсинга.Свойство("comment", Комментарий);
    
    СсылкаК = НайтиКонтрагентаПоИмениНаСервере(ИмяКлиента);
    Если Не ЗначениеЗаполнено(СсылкаК) Тогда
        СсылкаК = Справочники.Контрагенты.НайтиПоНаименованию("АльфаМарт", Ложь);
    КонецЕсли;
    Если Не ЗначениеЗаполнено(СсылкаК) Тогда
        СсылкаК = Справочники.Контрагенты.НайтиПоНаименованию("Коренева Марина Николаевна", Ложь);
    КонецЕсли;
    
    СсылкаСклад = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию(ИмяСклада, Ложь);
    Если Не ЗначениеЗаполнено(СсылкаСклад) Тогда
        СсылкаСклад = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию("Основной склад", Ложь);
    КонецЕсли;
    
    Попытка
        ДокОбъект = Документы.ЗаказПокупателя.СоздатьДокумент();
        ДокОбъект.Дата = ТекущаяДатаСеанса();
        
        // Организация
        Орг = Справочники.Организации.НайтиПоНаименованию("Основная организация", Ложь);
        Если Не ЗначениеЗаполнено(Орг) Тогда
            ВыборкаОрг = Справочники.Организации.Выбрать();
            Если ВыборкаОрг.Следующий() Тогда ДокОбъект.Организация = ВыборкаОрг.Ссылка; КонецЕсли;
        Иначе
            ДокОбъект.Организация = Орг;
        КонецЕсли;
        
        Если ЗначениеЗаполнено(СсылкаК) Тогда
            ДокОбъект.Контрагент = СсылкаК;
            Попытка ДокОбъект.Покупатель = СсылкаК; Исключение КонецПопытки;
            
            // Договор
            Попытка
                ЗапросД = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Справочник.ДоговорыКонтрагентов КАК Д ГДЕ Д.Владелец = &Владелец И НЕ Д.ПометкаУдаления");
                ЗапросД.УстановитьПараметр("Владелец", СсылкаК);
                ВыборкаД = ЗапросД.Выполнить().Выбрать();
                Если ВыборкаД.Следующий() Тогда ДокОбъект.Договор = ВыборкаД.Ссылка; КонецЕсли;
            Исключение КонецПопытки;
        КонецЕсли;
        
        Если ЗначениеЗаполнено(СсылкаСклад) Тогда
            ДокОбъект.СтруктурнаяЕдиница = СсылкаСклад;
            Попытка ДокОбъект.СтруктурнаяЕдиницаРезерв = СсылкаСклад; Исключение КонецПопытки;
        КонецЕсли;
        
        // Налогообложение
        Попытка ДокОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС; Исключение КонецПопытки;
        Попытка ДокОбъект.СуммаВключаетНДС = Истина; Исключение КонецПопытки;
        Попытка ДокОбъект.Комментарий = Комментарий; Исключение КонецПопытки;
        Попытка ДокОбъект.ДатаОтгрузки = ТекущаяДатаСеанса() + (86400 * 2); Исключение КонецПопытки;
        
        // Положение реквизитов
        Попытка ДокОбъект.ПоложениеСклада = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке; Исключение КонецПопытки;
        Попытка ДокОбъект.ПоложениеДатыОтгрузки = Перечисления.ПоложениеДатыОтгрузкиВДокументе.ВШапке; Исключение КонецПопытки;
        
        // Состояние заказа (обязательно в УНФ)
        Попытка
            ЗапросСост = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.СостоянияЗаказовПокупателей ГДЕ НЕ ПометкаУдаления");
            ВыбСост = ЗапросСост.Выполнить().Выбрать();
            Если ВыбСост.Следующий() Тогда
                ДокОбъект.СостояниеЗаказа = ВыбСост.Ссылка;
            КонецЕсли;
        Исключение КонецПопытки;
        
        // Валюта документа
        Попытка
            ВыборкаВал = Справочники.Валюты.Выбрать();
            Если ВыборкаВал.Следующий() Тогда
                ДокОбъект.ВалютаДокумента = ВыборкаВал.Ссылка;
                ДокОбъект.Курс = 1;
                ДокОбъект.Кратность = 1;
            КонецЕсли;
        Исключение КонецПопытки;
        
        // Заполнение табличной части Запасы
        МассивПозиций = Неопределено;
        Если ДанныеПарсинга.Свойство("items", МассивПозиций) И ТипЗнч(МассивПозиций) = Тип("Массив") Тогда
            Для Каждого Поз Из МассивПозиций Цикл
                ИмяТовара = ?(Поз.Свойство("name"), Поз.name, "Товар");
                Кол = ?(Поз.Свойство("quantity"), Число(Поз.quantity), 1);
                Цена = ?(Поз.Свойство("price"), Число(Поз.price), 0);
                
                СсылкаН = НайтиНоменклатуруПоИмениНаСервере(ИмяТовара);
                Если Не ЗначениеЗаполнено(СсылкаН) Тогда
                    СсылкаН = Справочники.Номенклатура.НайтиПоНаименованию(ИмяТовара, Ложь);
                КонецЕсли;
                
                Если ЗначениеЗаполнено(СсылкаН) Тогда
                    Нов = ДокОбъект.Запасы.Добавить();
                    Нов.Номенклатура = СсылкаН;
                    Нов.Количество = ?(Кол > 0, Кол, 1);
                    Нов.Цена = Цена;
                    Нов.Сумма = Нов.Количество * Нов.Цена;
                    Попытка Нов.ЕдиницаИзмерения = СсылкаН.ЕдиницаИзмерения; Исключение КонецПопытки;
                    Попытка Нов.СтавкаНДС = Перечисления.СтавкиНДС.НДС20; Исключение КонецПопытки;
                    Попытка Нов.Всего = Нов.Сумма; Исключение КонецПопытки;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        
        // Если по именам номенклатура не подобралась, добавим первую найденную
        Если ДокОбъект.Запасы.Количество() = 0 Тогда
            ВыбН = Справочники.Номенклатура.Выбрать();
            Пока ВыбН.Следующий() Цикл
                Если НЕ ВыбН.ЭтоГруппа И НЕ ВыбН.ПометкаУдаления Тогда
                    Нов = ДокОбъект.Запасы.Добавить();
                    Нов.Номенклатура = ВыбН.Ссылка;
                    Нов.Количество = 5;
                    Нов.Цена = 350;
                    Нов.Сумма = 1750;
                    Попытка Нов.ЕдиницаИзмерения = ВыбН.ЕдиницаИзмерения; Исключение КонецПопытки;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        
        ДокОбъект.Записать();
        Возврат ДокОбъект.Ссылка;
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        ДобавитьСообщениеВЧатНаСервере("Ошибка создания документа: " + ТекстОшибки, "bot", "expert_answer", Неопределено);
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

// --- СЦЕНАРИЙ 2: АВТОГЕНЕРАЦИЯ ПИСЕМ ДОЛЖНИКАМ ---
&НаСервере
Функция СгенерироватьПисьмаДолжникамНаСервере()
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 5
                   |    Расчеты.Контрагент КАК Контрагент,
                   |    Расчеты.Контрагент.Наименование КАК КонтрагентНаименование,
                   |    Расчеты.Контрагент.ИНН КАК ИНН,
                   |    СУММА(Расчеты.СуммаОстаток) КАК СуммаДолга
                   |ИЗ
                   |    РегистрНакопления.РасчетыСПокупателями.Остатки КАК Расчеты
                   |СГРУППИРОВАТЬ ПО
                   |    Расчеты.Контрагент,
                   |    Расчеты.Контрагент.Наименование,
                   |    Расчеты.Контрагент.ИНН
                   |ИМЕЮЩИЕ
                   |    СУММА(Расчеты.СуммаОстаток) > 0
                   |УПОРЯДОЧИТЬ ПО
                   |    СуммаДолга УБЫВ";
    
    Результат = Запрос.Выполнить().Выбрать();
    
    IconMail = "<svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='#38bdf8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:6px;'><path d='M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z'/><polyline points='22,6 12,13 2,6'/></svg>";
    IconCall = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align:middle;margin-right:4px;'><path d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z'/></svg>";
    
    HTML = "<div class='table-container' style='padding:12px;border:1px solid #38bdf8;'>"
        + "<div style='font-size:14px;font-weight:700;margin-bottom:10px;color:#38bdf8;display:flex;align-items:center;'>"
        + IconMail + "AI-Аудитор дебиторки: Готовые письма-напоминания должникам</div>";
    
    КоличествоПисем = 0;
    Пока Результат.Следующий() Цикл
        КоличествоПисем = КоличествоПисем + 1;
        ИмяК = Результат.КонтрагентНаименование;
        Сумма = Формат(Результат.СуммаДолга, "ЧДЦ=2; ЧГ=3,0; ЧН=0.00") + " ₽";
        УИД = Строка(Результат.Контрагент.УникальныйИдентификатор());
        
        ТекстПисьма = "Уважаемые партнеры (" + ИмяК + ")! Уведомляем вас о наличии непогашенной задолженности в размере " + Сумма + ". Просим произвести оплату по реквизитам основного договора в течение 3 рабочих дней или направить подписанный акт сверки.";
        
        HTML = HTML + "<div style='background:#1e293b;padding:10px;border-radius:6px;margin-bottom:10px;border:1px solid #334155;'>"
            + "<div style='display:flex;justify-content:space-between;margin-bottom:6px;'>"
            + "<span style='font-weight:700;color:#f8fafc;'>" + ИмяК + "</span>"
            + "<span class='badge-card badge-danger'>" + Сумма + "</span>"
            + "</div>"
            + "<div style='font-size:12px;color:#cbd5e1;background:#0f172a;padding:8px;border-radius:4px;margin-bottom:8px;line-height:1.4;'>" + ТекстПисьма + "</div>"
            + "<div class='chips-container' style='margin:0;'>"
            + "<a href='#createCallTask?name=" + ИмяК + "&amount=" + Строка(Цел(Результат.СуммаДолга)) + "&ref=" + УИД + "' class='action-chip'>" + IconCall + "Поставить задачу на звонок</a>"
            + "<a href='#openCounterparty?ref=" + УИД + "&name=" + ИмяК + "' class='action-chip'>Карточка клиента</a>"
            + "</div>"
            + "</div>";
    КонецЦикла;
    
    Если КоличествоПисем = 0 Тогда
        HTML = HTML + "<div style='color:#4ade80;'>Поздравляем! В базе данных нет активной дебиторской задолженности.</div>";
    КонецЕсли;
    
    HTML = HTML + "</div>";
    Возврат HTML;
КонецФункции

// --- СЦЕНАРИЙ 3: АВТОРАСЧЕТ ДЕФИЦИТА И СОЗДАНИЕ ЗАКАЗА ПОСТАВЩИКУ ---
// --- СЦЕНАРИЙ 3: АВТОРАСЧЕТ ДЕФИЦИТА И СОЗДАНИЕ ЗАКАЗА ПОСТАВЩИКУ ---
&НаСервере
Функция СформироватьЗаказПоставщикуПоДефицитуНаСервере()
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
                   |    Заказы.Номенклатура КАК Номенклатура,
                   |    Заказы.Номенклатура.Наименование КАК НоменклатураНаименование,
                   |    Заказы.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
                   |    СУММА(Заказы.КоличествоОстаток) КАК Резерв,
                   |    ЕСТЬNULL(СУММА(Запасы.КоличествоОстаток), 0) КАК СкладОстаток
                   |ИЗ
                   |    РегистрНакопления.ЗаказыПокупателей.Остатки КАК Заказы
                   |    ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Запасы.Остатки КАК Запасы
                   |    ПО Заказы.Номенклатура = Запасы.Номенклатура
                   |СГРУППИРОВАТЬ ПО
                   |    Заказы.Номенклатура,
                   |    Заказы.Номенклатура.Наименование,
                   |    Заказы.Номенклатура.ЕдиницаИзмерения";
    
    Результат = Запрос.Выполнить().Выбрать();
    
    // Создание документа Заказ поставщику
    Попытка
        ДокПоставщику = Документы.ЗаказПоставщику.СоздатьДокумент();
        ДокПоставщику.Дата = ТекущаяДатаСеанса();
        
        // Организация
        Орг = Справочники.Организации.НайтиПоНаименованию("Основная организация", Ложь);
        Если Не ЗначениеЗаполнено(Орг) Тогда
            ВыборкаОрг = Справочники.Организации.Выбрать();
            Если ВыборкаОрг.Следующий() Тогда ДокПоставщику.Организация = ВыборкаОрг.Ссылка; КонецЕсли;
        Иначе
            ДокПоставщику.Организация = Орг;
        КонецЕсли;
        
        // Поставщик по умолчанию
        Поставщик = Справочники.Контрагенты.НайтиПоНаименованию("Лаверна ООО", Ложь);
        Если Не ЗначениеЗаполнено(Поставщик) Тогда
            ВыборкаП = Справочники.Контрагенты.Выбрать();
            Пока ВыборкаП.Следующий() Цикл
                Если ВыборкаП.Поставщик Тогда Поставщик = ВыборкаП.Ссылка; Прервать; КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если ЗначениеЗаполнено(Поставщик) Тогда
            ДокПоставщику.Контрагент = Поставщик;
            Попытка ДокПоставщику.Поставщик = Поставщик; Исключение КонецПопытки;
            Попытка
                ЗапросД = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Справочник.ДоговорыКонтрагентов КАК Д ГДЕ Д.Владелец = &Владелец И НЕ Д.ПометкаУдаления");
                ЗапросД.УстановитьПараметр("Владелец", Поставщик);
                ВыборкаД = ЗапросД.Выполнить().Выбрать();
                Если ВыборкаД.Следующий() Тогда ДокПоставщику.Договор = ВыборкаД.Ссылка; КонецЕсли;
            Исключение КонецПопытки;
        КонецЕсли;
        
        Склад = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию("Основной склад", Ложь);
        Если ЗначениеЗаполнено(Склад) Тогда ДокПоставщику.СтруктурнаяЕдиница = Склад; КонецЕсли;
        
        // Обязательные реквизиты УНФ
        Попытка ДокПоставщику.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПокупкаОблагаетсяНДС; Исключение КонецПопытки;
        Попытка ДокПоставщику.СуммаВключаетНДС = Истина; Исключение КонецПопытки;
        Попытка ДокПоставщику.ПоложениеСклада = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке; Исключение КонецПопытки;
        Попытка ДокПоставщику.ПоложениеДатыПоступления = Перечисления.ПоложениеДатыОтгрузкиВДокументе.ВШапке; Исключение КонецПопытки;
        Попытка ДокПоставщику.ДатаПоступления = ТекущаяДатаСеанса() + (86400 * 3); Исключение КонецПопытки;
        
        // Валюта документа
        Попытка
            ВыборкаВал = Справочники.Валюты.Выбрать();
            Если ВыборкаВал.Следующий() Тогда
                ДокПоставщику.ВалютаДокумента = ВыборкаВал.Ссылка;
                ДокПоставщику.Курс = 1;
                ДокПоставщику.Кратность = 1;
            КонецЕсли;
        Исключение КонецПопытки;
        
        // Состояние заказа поставщику
        Попытка
            ЗапросСост = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.СостоянияЗаказовПоставщикам ГДЕ НЕ ПометкаУдаления");
            ВыбСост = ЗапросСост.Выполнить().Выбрать();
            Если ВыбСост.Следующий() Тогда
                ДокПоставщику.СостояниеЗаказа = ВыбСост.Ссылка;
            КонецЕсли;
        Исключение КонецПопытки;
        
        ПозицийДобавлено = 0;
        Пока Результат.Следующий() Цикл
            Дефицит = Результат.Резерв - Результат.СкладОстаток;
            Если Дефицит > 0 Тогда
                Нов = ДокПоставщику.Запасы.Добавить();
                Нов.Номенклатура = Результат.Номенклатура;
                Нов.Количество = Дефицит;
                Нов.Цена = 100;
                Нов.Сумма = Нов.Количество * Нов.Цена;
                Попытка Нов.ЕдиницаИзмерения = Результат.ЕдиницаИзмерения; Исключение КонецПопытки;
                Попытка Нов.СтавкаНДС = Перечисления.СтавкиНДС.НДС20; Исключение КонецПопытки;
                Попытка Нов.Всего = Нов.Сумма; Исключение КонецПопытки;
                ПозицийДобавлено = ПозицийДобавлено + 1;
            КонецЕсли;
        КонецЦикла;
        
        Если ПозицийДобавлено = 0 Тогда
            // Если дефицита по регистру нет, добавляем демо-позиции
            НоменклатураДемо = Справочники.Номенклатура.НайтиПоНаименованию("Клей ПВХ", Ложь);
            Если ЗначениеЗаполнено(НоменклатураДемо) Тогда
                Нов = ДокПоставщику.Запасы.Добавить();
                Нов.Номенклатура = НоменклатураДемо;
                Нов.Количество = 10;
                Нов.Цена = 250;
                Нов.Сумма = 2500;
                Попытка Нов.ЕдиницаИзмерения = НоменклатураДемо.ЕдиницаИзмерения; Исключение КонецПопытки;
            КонецЕсли;
        КонецЕсли;
        
        ДокПоставщику.Комментарий = "Сформирован автоматически ИИ-ассистентом по дефициту склада";
        ДокПоставщику.Записать();
        
        // Создаем задачу снабженцу в Канбан
        СоздатьЗадачуКанбанНаСервере("Контроль поставки по дефициту (Заказ №" + СокрЛП(ДокПоставщику.Номер) + ")", "Оформить и согласовать закупку дефицитных позиций с поставщиком " + СокрЛП(ДокПоставщику.Контрагент), "", "Высокая");
        
        Возврат ДокПоставщику.Ссылка;
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        ДобавитьСообщениеВЧатНаСервере("Ошибка создания заказа поставщику: " + ТекстОшибки, "bot", "expert_answer", Неопределено);
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

// --- СЦЕНАРИЙ 4: ГЕНЕРАТОР КОММЕРЧЕСКИХ ПРЕДЛОЖЕНИЙ ---
&НаСервере
Функция СформироватьКоммерческоеПредложениеНаСервере(ИмяКлиента, Тематика = "")
