&НаСервере
Процедура ПолучитьТокенАвторизацииНаСервере()
    ШПолучитьТокенАвторизации();
КонецПроцедуры

&НаСервере
Функция ВыполнитьHTTPЗапрос(Путь, ТелоЗапроса = "", Метод = "POST")
    Возврат ШВыполнитьHTTPЗапрос(Путь, ТелоЗапроса, Метод);
КонецФункции

&НаСервере
Процедура ШПолучитьТокенАвторизации()
    Если Не ПустаяСтрока(MiddlewareТокен) Тогда
        Возврат;
    КонецЕсли;
    
    Логин = СокрЛП(ЛогинMiddleware);
    Если ПустаяСтрока(Логин) Тогда
        Логин = "1c_service";
        ЛогинMiddleware = "1c_service";
    КонецЕсли;
    
    Пароль = СокрЛП(ПарольMiddleware);
    Если ПустаяСтрока(Пароль) Тогда
        Пароль = "1c_service_2024";
        ПарольMiddleware = "1c_service_2024";
    КонецЕсли;
    
    Попытка
        HTTP = ШСоздатьСоединение();
        Заголовки = Новый Соответствие;
        Заголовки.Вставить("Content-Type", "application/json");
        
        Запрос = Новый HTTPЗапрос("/auth/login", Заголовки);
        Тело = ШСериализоватьВJSON(Новый Структура("username, password", Логин, Пароль));
        Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        
        Ответ = HTTP.ОтправитьДляОбработки(Запрос);
        Если Ответ.КодСостояния = 200 Тогда
            Структура = ШДесериализоватьИзJSON(Ответ.ПолучитьТелоКакСтроку());
            Если Структура <> Неопределено И Структура.Свойство("access_token") Тогда
                MiddlewareТокен = Структура.access_token;
            КонецЕсли;
        КонецЕсли;
    Исключение
        MiddlewareТокен = "";
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ШСоздатьСоединение()
    Адрес = СокрЛП(АдресMiddleware);
    Если ПустаяСтрока(Адрес) Тогда
        Адрес = "http://127.0.0.1:8000";
        АдресMiddleware = "http://127.0.0.1:8000";
    КонецЕсли;
    
    ИспользоватьSSL = ИспользоватьHTTPS;
    Если СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
        ИспользоватьSSL = Истина;
        Адрес = Сред(Адрес, 9);
    ИначеЕсли СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
        Адрес = Сред(Адрес, 8);
    КонецЕсли;
    
    // Выделение порта
    Порт = ?(ИспользоватьSSL, 443, 8000);
    ИндПорта = СтрНайти(Адрес, ":");
    Если ИндПорта > 0 Тогда
        ПортСтрока = Сред(Адрес, ИндПорта + 1);
        Адрес = Лев(Адрес, ИндПорта - 1);
        ИндСлэшаПорт = СтрНайти(ПортСтрока, "/");
        Если ИндСлэшаПорт > 0 Тогда
            ПортСтрока = Лев(ПортСтрока, ИндСлэшаПорт - 1);
        КонецЕсли;
        Попытка
            Порт = Число(ПортСтрока);
        Исключение
            Порт = 8000;
        КонецПопытки;
    КонецЕсли;
    
    // Удаление завершающего слэша
    ИндСлэша = СтрНайти(Адрес, "/");
    Если ИндСлэша > 0 Тогда
        Адрес = Лев(Адрес, ИндСлэша - 1);
    КонецЕсли;
    
    Если ПустаяСтрока(Адрес) Тогда
        Адрес = "127.0.0.1";
    КонецЕсли;
    
    Если ИспользоватьSSL Тогда
        Возврат Новый HTTPСоединение(Адрес, Порт, , , , 60, Новый ЗащищенноеСоединениеOpenSSL());
    Иначе
        Возврат Новый HTTPСоединение(Адрес, Порт, , , , 60);
    КонецЕсли;
КонецФункции

&НаСервере
Функция ШЗаголовкиСАвторизацией()
    Если ПустаяСтрока(MiddlewareТокен) Тогда
        ШПолучитьТокенАвторизации();
    КонецЕсли;
    
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Content-Type", "application/json");
    Если Не ПустаяСтрока(MiddlewareТокен) Тогда
        Заголовки.Вставить("X-Auth-Token", MiddlewareТокен);
        Заголовки.Вставить("Authorization", "Bearer " + MiddlewareТокен);
    КонецЕсли;
    Заголовки.Вставить("X-Request-ID", Строка(Новый УникальныйИдентификатор()));
    Возврат Заголовки;
КонецФункции

&НаСервере
Функция ШОтправитьHTTP(Путь, ТелоЗапроса, Метод)
    Попытка
        HTTP = ШСоздатьСоединение();
        Заголовки = ШЗаголовкиСАвторизацией();
        Запрос = Новый HTTPЗапрос(Путь, Заголовки);
        
        Если Не ПустаяСтрока(ТелоЗапроса) Тогда
            Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        КонецЕсли;
        
        Если Метод = "GET" Тогда
            Возврат HTTP.Получить(Запрос);
        ИначеЕсли Метод = "DELETE" Тогда
            Возврат HTTP.Удалить(Запрос);
        Иначе
            Возврат HTTP.ОтправитьДляОбработки(Запрос);
        КонецЕсли;
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        ДобавитьСообщениеВЧатНаСервере("Ошибка соединения с Middleware (" + СокрЛП(АдресMiddleware) + "): " + ТекстОшибки, "bot", "expert_answer", Неопределено);
        ЧатHTML = СгенерироватьЧатHTML();
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

&НаСервере
Функция ШВыполнитьHTTPЗапрос(Путь, ТелоЗапроса = "", Метод = "POST")
    Ответ = ШОтправитьHTTP(Путь, ТелоЗапроса, Метод);
    // Автоматический ретрай с повторным получением токена при ошибке 401 Unauthorized
    Если Ответ <> Неопределено И Ответ.КодСостояния = 401 Тогда
        MiddlewareТокен = "";
        ШПолучитьТокенАвторизации();
        Если Не ПустаяСтрока(MiddlewareТокен) Тогда
            Ответ = ШОтправитьHTTP(Путь, ТелоЗапроса, Метод);
        КонецЕсли;
    КонецЕсли;
    Возврат Ответ;
КонецФункции

&НаСервереБезКонтекста
Функция ШСериализоватьВJSON(Данные)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Данные);
    Возврат ЗаписьJSON.Закрыть();
КонецФункции

&НаСервереБезКонтекста
Функция ШДесериализоватьИзJSON(СтрокаJSON)
    Если ПустаяСтрока(СтрокаJSON) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Попытка
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
        Результат = ПрочитатьJSON(ЧтениеJSON);
        ЧтениеJSON.Закрыть();
        Возврат Результат;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ШЭкранироватьHTML(Текст)
    Если Текст = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Рез = СтрЗаменить(Текст, "&", "&amp;");
    Рез = СтрЗаменить(Рез, "<", "&lt;");
    Рез = СтрЗаменить(Рез, ">", "&gt;");
    Рез = СтрЗаменить(Рез, """", "&quot;");
    Рез = СтрЗаменить(Рез, "'", "&#39;");
    Возврат Рез;
КонецФункции

&НаКлиенте
Процедура ЧатHTMLПриНажатииНаСсылку(Элемент, ДанныеСобытия, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    
    СтрокаВызова = "";
    Если ТипЗнч(ДанныеСобытия) = Тип("Строка") Тогда
        СтрокаВызова = ДанныеСобытия;
    Иначе
        Попытка
            СтрокаВызова = ДанныеСобытия.Href;
        Исключение
            Попытка
                СтрокаВызова = ДанныеСобытия.href;
            Исключение
                СтрокаВызова = Строка(ДанныеСобытия);
            КонецПопытки;
        КонецПопытки;
    КонецЕсли;
    
    ИндРешетки = СтрНайти(СтрокаВызова, "#");
    Если ИндРешетки > 0 Тогда
        СтрокаВызова = Сред(СтрокаВызова, ИндРешетки + 1);
    КонецЕсли;
    
    Если СтрНачинаетсяС(СтрокаВызова, "/") Тогда
        СтрокаВызова = Сред(СтрокаВызова, 2);
    КонецЕсли;
    
    ИндВопроса = СтрНайти(СтрокаВызова, "?");
    ИмяКоманды = ?(ИндВопроса > 0, Лев(СтрокаВызова, ИндВопроса - 1), СтрокаВызова);
    СтрокаПараметров = ?(ИндВопроса > 0, Сред(СтрокаВызова, ИндВопроса + 1), "");
    
    мПараметры = РазобратьПараметрыURL(СтрокаПараметров);
    
    // --- 1. Контрагенты и Должники ---
    Если ИмяКоманды = "openCounterparty" Тогда
        Ref = ШПолучитьПараметр(мПараметры, "ref", "");
        ИмяК = ШПолучитьПараметр(мПараметры, "name", "");
        ОткрытьКарточкуКонтрагента(Ref, ИмяК);
        
    ИначеЕсли ИмяКоманды = "openDossier" Тогда
        ИмяК = ШПолучитьПараметр(мПараметры, "name", "");
        ТекстДосье = СобратьДосьеНаСервере("Справочник.Контрагенты", ИмяК);
        ДобавитьСообщениеВЧатНаСервере(ТекстДосье, "bot", "get_dossier", Неопределено);
        ЧатHTML = СгенерироватьЧатHTML();
        
    ИначеЕсли ИмяКоманды = "createDebtTask" Тогда
        ИмяК = ШПолучитьПараметр(мПараметры, "name", "");
        Сумма = ШПолучитьПараметр(мПараметры, "amount", "");
        Ref = ШПолучитьПараметр(мПараметры, "ref", "");
        СоздатьЗадачуПоДолгуНаСервере(ИмяК, Сумма, Ref);
        ЧатHTML = СгенерироватьЧатHTML();
        ПоказатьОповещениеПользователя("Канбан-задача создана", , "Задача по клиенту " + ИмяК + " добавлена на доску!", БиблиотекаКартинок.Информация);
        
    ИначеЕсли ИмяКоманды = "createAllDebtTasks" Тогда
        СоздатьЗадачиПоВсемДолжникамНаСервере();
        ЧатHTML = СгенерироватьЧатHTML();
