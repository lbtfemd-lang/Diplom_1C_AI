&НаСервереБезКонтекста
Функция СформироватьActionChipsHTML(Действие, ДанныеJSON)
    Если ПустаяСтрока(Действие) ИЛИ Действие = "expert_answer" Тогда
        Возврат "";
    КонецЕсли;
    
    Данные = Неопределено;
    Если ЗначениеЗаполнено(ДанныеJSON) Тогда
        Данные = ШДесериализоватьИзJSON(ДанныеJSON);
    КонецЕсли;
    
    Кнопки = "<div class=""chips-container"">";
    
    Если Действие = "create_kanban_task" Тогда
        Кнопки = Кнопки + "<span class=""badge-card badge-success"">Задача сохранена на Канбан</span>";
    ИначеЕсли Действие = "get_orders" Тогда
        Кнопки = Кнопки + "<span class=""badge-card badge-info"">Заказы покупателей</span>";
    ИначеЕсли Действие = "get_stock" Тогда
        Кнопки = Кнопки + "<span class=""badge-card badge-info"">Складские остатки</span>";
    ИначеЕсли Действие = "get_debtors" Тогда
        Кнопки = Кнопки + "<span class=""badge-card badge-warning"">Дебиторская задолженность</span>";
    ИначеЕсли Действие = "get_dossier" Тогда
        Кнопки = Кнопки + "<span class=""badge-card badge-info"">Досье контрагента</span>";
    ИначеЕсли Действие = "parse_order_text" Тогда
        Кнопки = Кнопки + "<span class=""badge-card badge-success"">Заказ покупателя сформирован</span>";
    ИначеЕсли Действие = "generate_debt_letters" Тогда
        Кнопки = Кнопки + "<span class=""badge-card badge-danger"">Письма должникам</span>";
    ИначеЕсли Действие = "create_procurement_order" Тогда
        Кнопки = Кнопки + "<span class=""badge-card badge-warning"">Заказ поставщику</span>";
    ИначеЕсли Действие = "generate_commercial_proposal" Тогда
        Кнопки = Кнопки + "<span class=""badge-card badge-info"">Коммерческое предложение</span>";
    ИначеЕсли Действие = "audit_stalled_orders" Тогда
        Кнопки = Кнопки + "<span class=""badge-card badge-danger"">Аудит зависших заказов</span>";
    КонецЕсли;
    
    Кнопки = Кнопки + "</div>";
    Возврат Кнопки;
КонецФункции

