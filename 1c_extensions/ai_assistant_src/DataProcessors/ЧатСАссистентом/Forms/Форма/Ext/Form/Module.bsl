&НаКлиенте
Процедура ОткрытьКанбанДоску()
    Открыто = Ложь;
    
    // 1. Попытка открыть как встроенную обработку
    Попытка
        Если ЭтоМобильныйКлиент() Тогда
            ОткрытьФорму("Обработка.КанбанДоска.МобильнаяФорма");
        Иначе
            ОткрытьФорму("Обработка.КанбанДоска.Форма");
        КонецЕсли;
        Открыто = Истина;
    Исключение КонецПопытки;
    
    Если Открыто Тогда
        Возврат;
    КонецЕсли;

    // 2. Ищем файл на клиенте и помещаем во временное хранилище
    Пути = Новый Массив;
    Попытка
        Если ЗначениеЗаполнено(ЭтотОбъект.ИспользуемоеИмяФайла) Тогда
            Пути.Добавить(СтрЗаменить(ЭтотОбъект.ИспользуемоеИмяФайла, "ЧатСАссистентом.epf", "КанбанДоска.epf"));
            Пути.Добавить(СтрЗаменить(ЭтотОбъект.ИспользуемоеИмяФайла, "ЧатСАссистентом", "КанбанДоска"));
        КонецЕсли;
    Исключение КонецПопытки;
    
    Пути.Добавить("D:\Share\Projects\diplom\1c_extensions\build\КанбанДоска.epf");
    Пути.Добавить("C:\Users\kobza\Desktop\КанбанДоска.epf");
    
    АдресХранилища = "";
    Для Каждого Путь Из Пути Цикл
        ФайлПроверка = Новый Файл(Путь);
        Если ФайлПроверка.Существует() Тогда
            Попытка
                ДвоичныеДанные = Новый ДвоичныеДанные(Путь);
                АдресХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
                Прервать;
            Исключение КонецПопытки;
        КонецЕсли;
    КонецЦикла;
    
    Если ПустаяСтрока(АдресХранилища) Тогда
        ДобавитьСообщениеВЧатНаСервере("Файл КанбанДоска.epf не найден на диске клиента.", "bot", "expert_answer", Неопределено);
        ЧатHTML = СгенерироватьЧатHTML();
        Возврат;
    КонецЕсли;

    // 3. Подключаем на сервере через адрес временного хранилища
    Диагностика = "";
    ИмяФормыВнешней = ПодключитьКанбанПоАдресуХранилища(АдресХранилища, Диагностика);
    
    Если ЗначениеЗаполнено(ИмяФормыВнешней) Тогда
        Попытка
            ОткрытьФорму(ИмяФормыВнешней);
            Открыто = Истина;
        Исключение
            Попытка
                КороткоеИмя = СтрЗаменить(ИмяФормыВнешней, ".Форма.Форма", ".Форма");
