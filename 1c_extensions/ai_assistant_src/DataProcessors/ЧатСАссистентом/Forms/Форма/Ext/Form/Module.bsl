&НаСервере
Функция СгенерироватьЧатHTMLЗагрузка()
    ОсновнойHTML = СгенерироватьЧатHTML();
    ИндексКонца = СтрНайти(ОсновнойHTML, "</div><script>", НаправлениеПоиска.СКонца);
    Если ИндексКонца = 0 Тогда
        Возврат ОсновнойHTML;
    КонецЕсли;
    
    Индикатор = "<div class=""msg-row bot"">"
        + "<div class=""avatar"">AI</div>"
        + "<div class=""bubble-wrap"">"
        + "<div class=""typing-indicator""><span></span><span></span><span></span></div>"
        + "</div></div>";
    
    Возврат Лев(ОсновнойHTML, ИндексКонца - 1) + Индикатор + "</div><script>"
        + "var el = document.querySelector('.chat-container');"
        + "if(el){ el.scrollTop = el.scrollHeight; }"
        + "</script></body></html>";
КонецФункции

&НаСервереБезКонтекста
Функция ПреобразоватьMarkdownВHTML(Знач ИсходныйТекст)
    Если ПустаяСтрока(ИсходныйТекст) Тогда
        Возврат "";
    КонецЕсли;
    
    // Если текст уже содержит HTML разметку (например таблицу, div или span)
    Если СтрНайти(ИсходныйТекст, "<table") > 0 ИЛИ СтрНайти(ИсходныйТекст, "<div") > 0 ИЛИ СтрНайти(ИсходныйТекст, "<h3") > 0 Тогда
        // Текст уже сформирован в формате HTML — выполняем только точечные Markdown замены (жирный, код)
        Текст = ИсходныйТекст;
        
        Пока Истина Цикл
            Поз1 = СтрНайти(Текст, "**");
            Если Поз1 = 0 Тогда Прервать; КонецЕсли;
            Поз2 = СтрНайти(Текст, "**", , Поз1 + 2);
            Если Поз2 = 0 Тогда Прервать; КонецЕсли;
            
            ТекстЖирный = Сред(Текст, Поз1 + 2, Поз2 - Поз1 - 2);
            Текст = Лев(Текст, Поз1 - 1) + "<b>" + ТекстЖирный + "</b>" + Сред(Текст, Поз2 + 2);
        КонецЦикла;
        
        Возврат Текст;
    КонецЕсли;
    
    Текст = ШЭкранироватьHTML(ИсходныйТекст);
    
    // 1. Заголовки ### Заголовок -> <h3>Заголовок</h3>
    СтрокиМассив = СтрРазделить(Текст, Символы.ПС);
    Результат = "";
    ВнутриСписка = Ложь;
    
    Для Каждого Стр Из СтрокиМассив Цикл
        СтрТрим = СокрЛП(Стр);
        
        Если СтрНачинаетсяС(СтрТрим, "### ") Тогда
            Если ВнутриСписка Тогда
                Результат = Результат + "</ul>";
                ВнутриСписка = Ложь;
            КонецЕсли;
            Результат = Результат + "<h3 style=""margin-bottom:6px;margin-top:6px;"">" + Сред(СтрТрим, 5) + "</h3>";
        ИначеЕсли СтрНачинаетсяС(СтрТрим, "- ") ИЛИ СтрНачинаетсяС(СтрТрим, "* ") Тогда
            Если НЕ ВнутриСписка Тогда
                Результат = Результат + "<ul>";
                ВнутриСписка = Истина;
            КонецЕсли;
            Результат = Результат + "<li>" + Сред(СтрТрим, 3) + "</li>";
        Иначе
            Если ВнутриСписка Тогда
                Результат = Результат + "</ul>";
                ВнутриСписка = Ложь;
            КонецЕсли;
            Если Не ПустаяСтрока(СтрТрим) Тогда
                Результат = Результат + "<p>" + СтрТрим + "</p>";
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    
    Если ВнутриСписка Тогда
        Результат = Результат + "</ul>";
    КонецЕсли;
    
    // 2. Жирный шрифт **текст** -> <b>текст</b>
    Пока Истина Цикл
        Поз1 = СтрНайти(Результат, "**");
        Если Поз1 = 0 Тогда Прервать; КонецЕсли;
        Поз2 = СтрНайти(Результат, "**", , Поз1 + 2);
        Если Поз2 = 0 Тогда Прервать; КонецЕсли;
        
        ТекстЖирный = Сред(Результат, Поз1 + 2, Поз2 - Поз1 - 2);
        Результат = Лев(Результат, Поз1 - 1) + "<b>" + ТекстЖирный + "</b>" + Сред(Результат, Поз2 + 2);
    КонецЦикла;
    
    // 3. Моноширинный код `код` -> <code>код</code>
    Пока Истина Цикл
        Поз1 = СтрНайти(Результат, "`");
        Если Поз1 = 0 Тогда Прервать; КонецЕсли;
        Поз2 = СтрНайти(Результат, "`", , Поз1 + 1);
        Если Поз2 = 0 Тогда Прервать; КонецЕсли;
        
        ТекстКод = Сред(Результат, Поз1 + 1, Поз2 - Поз1 - 1);
        Результат = Лев(Результат, Поз1 - 1) + "<code>" + ТекстКод + "</code>" + Сред(Результат, Поз2 + 1);
    КонецЦикла;
    
    Возврат Результат;
КонецФункции

