Функция НайтиКонтрагентаПоИмениНаСервере(Имя)
    Если ПустаяСтрока(Имя) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Рез = Справочники.Контрагенты.НайтиПоНаименованию(Имя, Ложь);
    Если Не ЗначениеЗаполнено(Рез) Тогда
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка ИЗ Справочник.Контрагенты КАК К ГДЕ К.Наименование ПОДОБНО &Имя И НЕ К.ПометкаУдаления");
        Запрос.УстановитьПараметр("Имя", "%" + СокрЛП(Имя) + "%");
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Рез = Выборка.Ссылка;
        КонецЕсли;
    КонецЕсли;
    Возврат Рез;
КонецФункции

