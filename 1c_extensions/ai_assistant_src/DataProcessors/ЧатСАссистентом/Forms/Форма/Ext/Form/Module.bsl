&НаКлиенте
Процедура ОтправитьСообщение(Команда)
    Текст = СокрЛП(ТекстСообщения);
    Если ПустаяСтрока(Текст) Тогда
        Возврат;
    КонецЕсли;
    
    // Добавляем сообщение пользователя
    ДобавитьСообщениеВЧатНаСервере(Текст, "user", "", "");
    ТекстСообщения = "";
    
    // Включаем индикатор ожидания
    ФлагЗагрузки = Истина;
    ЧатHTML = СгенерироватьЧатHTMLЗагрузка();
    
    // Подготовка контекста и отправка на сервер Middleware
    Результат = ОтправитьСообщениеНаСервер();
    
    // Запуск прикладного действия на клиенте
    Если Результат <> Неопределено И ЗначениеЗаполнено(Результат.Действие) И Результат.Действие <> "expert_answer" Тогда
        ВыполнитьКомандуАссистента(Результат.Действие, Результат.Данные);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОтправитьСообщениеНаСервер()
    МассивСообщений = Новый Массив;
    ВсегоСтрок = ЧатИстория.Количество();
    НачИндекс = ?(ВсегоСтрок > 15, ВсегоСтрок - 15, 0);
    
    Для Индекс = НачИндекс По ВсегоСтрок - 1 Цикл
        СтрокаЧата = ЧатИстория[Индекс];
        Роль = ?(СтрокаЧата.ТипСообщения = "user", "user", "assistant");
        МассивСообщений.Добавить(Новый Структура("role, text", Роль, СтрокаЧата.Текст));
    КонецЦикла;
    
    СтруктураПакета = Новый Структура;
    СтруктураПакета.Вставить("messages", МассивСообщений);
    СтруктураПакета.Вставить("context", "Клиент 1С:УНФ 3.0");
    
    СтрокаJSON = ШСериализоватьВJSON(СтруктураПакета);
    Результат = Новый Структура("Действие, Данные", "", Неопределено);
    
    Попытка
        HTTPОтвет = ШВыполнитьHTTPЗапрос("/chat", СтрокаJSON, "POST");
        Если HTTPОтвет <> Неопределено И HTTPОтвет.КодСостояния = 200 Тогда
            ОтветСтруктура = ШДесериализоватьИзJSON(HTTPОтвет.ПолучитьТелоКакСтроку());
            Если ОтветСтруктура <> Неопределено Тогда
                ТекстОтвета = "";
                Если НЕ ОтветСтруктура.Свойство("text", ТекстОтвета) Тогда
                    ОтветСтруктура.Свойство("response", ТекстОтвета);
                КонецЕсли;
                
                Действие = "";
                ОтветСтруктура.Свойство("action", Действие);
                
                Данные = Неопределено;
                ОтветСтруктура.Свойство("data", Данные);
                
                ДанныеJSONСтрока = ?(Данные <> Неопределено, ШСериализоватьВJSON(Данные), "");
                ДобавитьСообщениеВЧатНаСервере(ТекстОтвета, "bot", Действие, ДанныеJSONСтрока);
                
                Результат.Действие = Действие;
                Результат.Данные = Данные;
            КонецЕсли;
        Иначе
            Код = ?(HTTPОтвет = Неопределено, "Нет соединения", Строка(HTTPОтвет.КодСостояния));
            ДобавитьСообщениеВЧатНаСервере("Ошибка связи с ИИ-сервисом (код: " + Код + "). Проверьте доступность Middleware сервера.", "bot", "expert_answer", Неопределено);
        КонецЕсли;
    Исключение
        ДобавитьСообщениеВЧатНаСервере("Исключение при обращении к ИИ: " + ОписаниеОшибки(), "bot", "expert_answer", Неопределено);
    КонецПопытки;
    
    ФлагЗагрузки = Ложь;
    ЧатHTML = СгенерироватьЧатHTML();
    Возврат Результат;
КонецФункции

// =============================================================================
// 4. ДИСПЕТЧЕР ДЕЙСТВИЙ АССИСТЕНТА
// =============================================================================

&НаКлиенте
Процедура ВыполнитьКомандуАссистента(Действие, Данные)
    Если ПустаяСтрока(Действие) ИЛИ Действие = "expert_answer" Тогда
        Возврат;
    КонецЕсли;
    
    // --- Сценарий 1: Парсинг заявки из текста ---
    Если Действие = "parse_order_text" Тогда
        СсылкаДок = СобратьИОткрытьЗаказИзПарсингаНаСервере(Данные);
        Если ЗначениеЗаполнено(СсылкаДок) Тогда
            БезопасноОткрытьФорму("Документ.ЗаказПокупателя.ФормаОбъекта", "Заказ покупателя", Новый Структура("Ключ", СсылкаДок));
            ПоказатьОповещениеПользователя("Заказ покупателя создан", , "Документ успешно сформирован из текста заявки!", БиблиотекаКартинок.Информация);
        Иначе
            ДобавитьСообщениеВЧатНаСервере("Не удалось автоматически создать документ из заявки.", "bot", "expert_answer", Неопределено);
            ЧатHTML = СгенерироватьЧатHTML();
        КонецЕсли;
        
    // --- Сценарий 2: Генерация писем должникам ---
    ИначеЕсли Действие = "generate_debt_letters" Тогда
        ТекстПисем = СгенерироватьПисьмаДолжникамНаСервере();
        ДобавитьСообщениеВЧатНаСервере(ТекстПисем, "bot", "generate_debt_letters", Неопределено);
        ЧатHTML = СгенерироватьЧатHTML();
        
    // --- Сценарий 3: Заказ поставщику по дефициту ---
    ИначеЕсли Действие = "create_procurement_order" Тогда
        СсылкаДок = СформироватьЗаказПоставщикуПоДефицитуНаСервере();
        Если ЗначениеЗаполнено(СсылкаДок) Тогда
            БезопасноОткрытьФорму("Документ.ЗаказПоставщику.ФормаОбъекта", "Заказ поставщику", Новый Структура("Ключ", СсылкаДок));
            ДобавитьСообщениеВЧатНаСервере("✅ **Сформирован документ «Заказ поставщику»** по рассчитанному дефициту склада. Снабженцу поставлена задача в Канбан.", "bot", "create_procurement_order", Неопределено);
            ЧатHTML = СгенерироватьЧатHTML();
            ПоказатьОповещениеПользователя("Заказ поставщику создан", , "Документ по дефициту успешно заполнен!", БиблиотекаКартинок.Информация);
        Иначе
            ДобавитьСообщениеВЧатНаСервере("Не удалось создать заказ поставщику.", "bot", "expert_answer", Неопределено);
            ЧатHTML = СгенерироватьЧатHTML();
        КонецЕсли;
        
    // --- Сценарий 4: Коммерческое предложение ---
    ИначеЕсли Действие = "generate_commercial_proposal" Тогда
        ИмяКлиента = "";
        Если Данные <> Неопределено И Данные.Свойство("client_name", ИмяКлиента) Тогда КонецЕсли;
        Тематика = "";
        Если Данные <> Неопределено И Данные.Свойство("topic", Тематика) Тогда КонецЕсли;
        ТекстКП = СформироватьКоммерческоеПредложениеНаСервере(ИмяКлиента, Тематика);
        ДобавитьСообщениеВЧатНаСервере(ТекстКП, "bot", "generate_commercial_proposal", Неопределено);
        ЧатHTML = СгенерироватьЧатHTML();
        
    // --- Сценарий 5: Аудит зависших заказов ---
    ИначеЕсли Действие = "audit_stalled_orders" Тогда
        ТекстАудита = ВыполнитьАудитЗависшихЗаказовНаСервере();
        ДобавитьСообщениеВЧатНаСервере(ТекстАудита, "bot", "audit_stalled_orders", Неопределено);
        ЧатHTML = СгенерироватьЧатHTML();
        
    // --- Сценарий: Канбан-задача ---
    ИначеЕсли Действие = "create_kanban_task" Тогда
        Заголовок = ?(Данные.Свойство("title"), Данные.title, "Новая задача");
        Описание = ?(Данные.Свойство("description"), Данные.description, "");
        Срок = ?(Данные.Свойство("due_date"), Данные.due_date, "");
        Приоритет = ?(Данные.Свойство("priority"), Данные.priority, "Средняя");
        СоздатьЗадачуКанбанНаСервере(Заголовок, Описание, Срок, Приоритет);
        ЧатHTML = СгенерироватьЧатHTML();
        
    // --- Сценарий: Открытие Канбан ---
    ИначеЕсли Действие = "show_kanban" Тогда
        ОткрытьКанбанДоску();
        
    // --- Сценарий: Создание объекта мастера ---
    ИначеЕсли Действие = "create_object" Тогда
        Мастер_ЗапускСозданияОбъекта(Данные);
        
    // --- Сценарий: Список заказов ---
    ИначеЕсли Действие = "get_orders" Тогда
        СтатусФильтр = "";
        Если Данные <> Неопределено И Данные.Свойство("status", СтатусФильтр) Тогда
        КонецЕсли;
        ТекстЗаказов = ПолучитьСписокЗаказовНаСервере(СтатусФильтр);
        ДобавитьСообщениеВЧатНаСервере(ТекстЗаказов, "bot", "get_orders", Неопределено);
        ЧатHTML = СгенерироватьЧатHTML();
        
    // --- Сценарий: Складские остатки ---
    ИначеЕсли Действие = "get_stock" Тогда
        ИмяТовара = "";
        Если Данные <> Неопределено И Данные.Свойство("fields") И Данные.fields.Свойство("Item", ИмяТовара) Тогда
        КонецЕсли;
        ТекстОстатков = ПолучитьОстаткиТовараНаСервере(ИмяТовара);
        ДобавитьСообщениеВЧатНаСервере(ТекстОстатков, "bot", "get_stock", Неопределено);
        ЧатHTML = СгенерироватьЧатHTML();
        
    // --- Сценарий: Дебиторы ---
    ИначеЕсли Действие = "get_debtors" Тогда
        ТекстДолга = ПолучитьСписокДолжниковНаСервере();
        ДобавитьСообщениеВЧатНаСервере(ТекстДолга, "bot", "get_debtors", Неопределено);
        ЧатHTML = СгенерироватьЧатHTML();
        
    // --- Сценарий: Досье клиента ---
    ИначеЕсли Действие = "get_dossier" Тогда
        ТипО = "Справочник.Контрагенты";
        ИмяО = "";
        Если Данные <> Неопределено Тогда
            Данные.Свойство("type", ТипО);
            Если Данные.Свойство("fields") Тогда
                Данные.fields.Свойство("Client", ИмяО);
            КонецЕсли;
        КонецЕсли;
        ТекстДосье = СобратьДосьеНаСервере(ТипО, ИмяО);
        ДобавитьСообщениеВЧатНаСервере(ТекстДосье, "bot", "get_dossier", Неопределено);
        ЧатHTML = СгенерироватьЧатHTML();
        
    // --- Сценарий: Аналитика ---
    ИначеЕсли Действие = "run_analytics" Тогда
        Вопрос = "";
        Если Данные <> Неопределено И Данные.Свойство("query", Вопрос) Тогда
        КонецЕсли;
        ТекстАналитики = ВыполнитьАналитикуНаСервере(Вопрос);
        ДобавитьСообщениеВЧатНаСервере(ТекстАналитики, "bot", "run_analytics", Неопределено);
        ЧатHTML = СгенерироватьЧатHTML();
        
    // --- Сценарий: Статус документа ---
    ИначеЕсли Действие = "get_status" Тогда
        ТипО = "Документ.ЗаказПокупателя";
        НомерО = "";
        Если Данные <> Неопределено Тогда
            Данные.Свойство("type", ТипО);
            Данные.Свойство("number", НомерО);
        КонецЕсли;
        ТекстСтатуса = ПолучитьСтатусДокументаНаСервере(ТипО, НомерО);
        ДобавитьСообщениеВЧатНаСервере(ТекстСтатуса, "bot", "get_status", Неопределено);
        ЧатHTML = СгенерироватьЧатHTML();
        
    // --- Сценарий: Обновление метаданных ---
    ИначеЕсли Действие = "update_metadata" Тогда
        ВыполнитьОбновлениеМетаданныхНаСервере();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СоздатьЗадачуКанбанНаСервере(Заголовок, Описание, СрокСтрока = "", ВажностьСтрока = "Обычная")
    Попытка
        НоваяЗадача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
        НоваяЗадача.Дата = ТекущаяДатаСеанса();
        НоваяЗадача.Наименование = ?(ПустаяСтрока(Заголовок), "Новая задача", Заголовок);
        НоваяЗадача.Описание = Описание;
        
        Если НРег(ВажностьСтрока) = "высокая" ИЛИ НРег(ВажностьСтрока) = "high" Тогда
            НоваяЗадача.Важность = Перечисления.ВариантыВажностиЗадачи.Высокая;
        ИначеЕсли НРег(ВажностьСтрока) = "низкая" ИЛИ НРег(ВажностьСтрока) = "low" Тогда
            НоваяЗадача.Важность = Перечисления.ВариантыВажностиЗадачи.Низкая;
        Иначе
            НоваяЗадача.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
        КонецЕсли;
        
        НоваяЗадача.ПринятаКИсполнению = Ложь;
        НоваяЗадача.Выполнена = Ложь;
        
        // Парсинг срока
        Если ЗначениеЗаполнено(СрокСтрока) Тогда
            Попытка
                НоваяЗадача.СрокИсполнения = Дата(СтрЗаменить(СтрЗаменить(СрокСтрока, "T", " "), "-", ""));
            Исключение
                НоваяЗадача.СрокИсполнения = ТекущаяДатаСеанса() + (86400 * 2);
            КонецПопытки;
        Иначе
            НоваяЗадача.СрокИсполнения = ТекущаяДатаСеанса() + (86400 * 2);
        КонецЕсли;
        
        Попытка
            НоваяЗадача.Исполнитель = Пользователи.АвторизованныйПользователь();
        Исключение
            НоваяЗадача.Исполнитель = Справочники.Пользователи.НайтиПоНаименованию("Администратор");
        КонецПопытки;
        
        НоваяЗадача.ОбменДанными.Загрузка = Истина;
        НоваяЗадача.Записать();
        
        ТекстОтвета = "✅ **Задача сохранена на Канбан:** [" + НоваяЗадача.Наименование + "]" + Символы.ПС
            + "Срок: **" + Формат(НоваяЗадача.СрокИсполнения, "ДФ=dd.MM.yyyy") + "** | Важность: **" + Строка(НоваяЗадача.Важность) + "**" + Символы.ПС
            + "Ответственный: " + СокрЛП(НоваяЗадача.Исполнитель);
        
        ДобавитьСообщениеВЧатНаСервере(ТекстОтвета, "bot", "create_kanban_task", Неопределено);
    Исключение
        ДобавитьСообщениеВЧатНаСервере("Ошибка создания задачи на Канбан: " + ОписаниеОшибки(), "bot", "expert_answer", Неопределено);
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Мастер_ЗапускСозданияОбъекта(Данные)
    ТипОбъекта = ?(Данные <> Неопределено И Данные.Свойство("type"), Данные.type, "Документ.ЗаказПокупателя");
    
    РезультатПодготовки = ПодготовитьОбъектКСозданиюНаСервере(ТипОбъекта, Данные);
    
    Контекст = Новый Структура;
    Контекст.Вставить("ТипОбъекта", ТипОбъекта);
    Контекст.Вставить("Данные", Данные);
    Контекст.Вставить("РезультатПодготовки", РезультатПодготовки);
    
    Шаг1_ПроверкаКлиента(Контекст);
КонецПроцедуры


&НаСервере
Функция ПодготовитьОбъектКСозданиюНаСервере(ТипОбъекта, Данные)
    Результат = Новый Структура;
    ЗначенияЗаполнения = Новый Структура;
    
    Поля = Неопределено;
    Если Данные <> Неопределено И Данные.Свойство("fields", Поля) И ТипЗнч(Поля) = Тип("Структура") Тогда
        // 1. Поиск контрагента
        ИмяКлиента = "";
        Если Поля.Свойство("Client", ИмяКлиента) ИЛИ Поля.Свойство("Counterparty", ИмяКлиента) ИЛИ Поля.Свойство("Customer", ИмяКлиента) Тогда
            Если ЗначениеЗаполнено(ИмяКлиента) Тогда
                СсылкаК = НайтиКонтрагентаПоИмениНаСервере(ИмяКлиента);
                Если ЗначениеЗаполнено(СсылкаК) Тогда
                    ЗначенияЗаполнения.Вставить("Контрагент", СсылкаК);
                    ЗначенияЗаполнения.Вставить("Покупатель", СсылкаК);
                    ЗначенияЗаполнения.Вставить("Поставщик", СсылкаК);
                    
                    Попытка
                        ЗапросД = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Справочник.ДоговорыКонтрагентов КАК Д ГДЕ Д.Владелец = &Владелец И НЕ Д.ПометкаУдаления");
                        ЗапросД.УстановитьПараметр("Владелец", СсылкаК);
                        ВыборкаД = ЗапросД.Выполнить().Выбрать();
                        Если ВыборкаД.Следующий() Тогда
                            ЗначенияЗаполнения.Вставить("Договор", ВыборкаД.Ссылка);
                        КонецЕсли;
                    Исключение КонецПопытки;
                Иначе
                    Результат.Вставить("НеНайденКлиент", Новый Структура("Наименование", ИмяКлиента));
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
        
        // 2. Организация по умолчанию
        Попытка
            Орг = Справочники.Организации.НайтиПоНаименованию("Основная организация");
            Если Не ЗначениеЗаполнено(Орг) Тогда
                ОргВыборка = Справочники.Организации.Выбрать();
                Если ОргВыборка.Следующий() Тогда
                    ЗначенияЗаполнения.Вставить("Организация", ОргВыборка.Ссылка);
                КонецЕсли;
            Иначе
                ЗначенияЗаполнения.Вставить("Организация", Орг);
            КонецЕсли;
        Исключение КонецПопытки;
        
        // 3. Склад по умолчанию
        Попытка
            Склад = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию("Основной склад");
            Если ЗначениеЗаполнено(Склад) Тогда
                ЗначенияЗаполнения.Вставить("СтруктурнаяЕдиница", Склад);
            КонецЕсли;
        Исключение КонецПопытки;
        
        // 4. Номенклатура
        ИмяТовара = "";
        Количество = 1;
        Цена = 0;
        
        Поля.Свойство("Item", ИмяТовара);
        Если ПустаяСтрока(ИмяТовара) Тогда
            Поля.Свойство("Product", ИмяТовара);
        КонецЕсли;
        
        Если Поля.Свойство("Quantity", Количество) Тогда
            Количество = Число(Количество);
        КонецЕсли;
        
        Если Поля.Свойство("Price", Цена) Тогда
            Цена = Число(Цена);
        КонецЕсли;
        
        Если ЗначениеЗаполнено(ИмяТовара) Тогда
            СсылкаН = НайтиНоменклатуруПоИмениНаСервере(ИмяТовара);
            Если ЗначениеЗаполнено(СсылкаН) Тогда
                МассивЗапасы = Новый Массив;
                СтрЗ = Новый Структура;
                СтрЗ.Вставить("Номенклатура", СсылкаН);
                СтрЗ.Вставить("Количество", ?(Количество > 0, Количество, 1));
                СтрЗ.Вставить("Цена", Цена);
                СтрЗ.Вставить("Сумма", ?(Количество > 0, Количество, 1) * Цена);
                Попытка СтрЗ.Вставить("ЕдиницаИзмерения", СсылкаН.ЕдиницаИзмерения); Исключение КонецПопытки;
                МассивЗапасы.Добавить(СтрЗ);
                
                ЗначенияЗаполнения.Вставить("Запасы", МассивЗапасы);
            Иначе
                Результат.Вставить("НеНайденТовар", Новый Структура("Наименование", ИмяТовара));
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    
    Результат.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
    Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ОбновитьКлиентаВКонтексте(Контекст)
    Если Контекст.РезультатПодготовки.Свойство("НеНайденКлиент") Тогда
        Имя = Контекст.РезультатПодготовки.НеНайденКлиент.Наименование;
        СсылкаК = НайтиКонтрагентаПоИмениНаСервере(Имя);
        Если ЗначениеЗаполнено(СсылкаК) Тогда
            Контекст.РезультатПодготовки.ЗначенияЗаполнения.Вставить("Контрагент", СсылкаК);
            Контекст.РезультатПодготовки.ЗначенияЗаполнения.Вставить("Покупатель", СсылкаК);
            Контекст.РезультатПодготовки.ЗначенияЗаполнения.Вставить("Поставщик", СсылкаК);
            Контекст.РезультатПодготовки.Удалить("НеНайденКлиент");
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТоварВКонтексте(Контекст, ИмяТовара)
    СсылкаН = НайтиНоменклатуруПоИмениНаСервере(ИмяТовара);
    Если ЗначениеЗаполнено(СсылкаН) Тогда
        Если НЕ Контекст.РезультатПодготовки.ЗначенияЗаполнения.Свойство("Запасы") Тогда
            МассивЗапасы = Новый Массив;
            Стр = Новый Структура;
            Стр.Вставить("Номенклатура", СсылкаН);
            Стр.Вставить("Количество", 1);
            Стр.Вставить("Цена", 0);
            Стр.Вставить("Сумма", 0);
            МассивЗапасы.Добавить(Стр);
            Контекст.РезультатПодготовки.ЗначенияЗаполнения.Вставить("Запасы", МассивЗапасы);
        КонецЕсли;
        Контекст.РезультатПодготовки.Удалить("НеНайденТовар");
    КонецЕсли;
КонецПроцедуры


// =============================================================================
// 5. УНИВЕРСАЛЬНЫЙ МАСТЕР СОЗДАНИЯ ДОКУМЕНТОВ (ШАГ 1 -> ШАГ 2 -> ШАГ 3)
// =============================================================================

&НаКлиенте
Процедура Шаг1_ПроверкаКлиента(Контекст)
    Данные = Контекст.РезультатПодготовки;
    Если Данные <> Неопределено И Данные.Свойство("НеНайденКлиент") Тогда
        ИмяКлиента = Данные.НеНайденКлиент.Наименование;
        Оповещение = Новый ОписаниеОповещения("ПослеОтветаОКлиенте", ЭтотОбъект, Контекст);
        ПоказатьВопрос(Оповещение, "Контрагент «" + ИмяКлиента + "» не найден в базе. Создать нового контрагента?", РежимДиалогаВопрос.ДаНет);
    Иначе
        Шаг2_ПроверкаТовара(Контекст);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаОКлиенте(Результат, Контекст) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
        ДанныеСоздания = Контекст.РезультатПодготовки.НеНайденКлиент;
        ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ДанныеСоздания);
        Оповещение = Новый ОписаниеОповещения("ПослеСозданияКлиента", ЭтотОбъект, Контекст);
        ОткрытьФорму("Справочник.Контрагенты.ФормаОбъекта", ПараметрыФормы, , , , , Оповещение);
    Иначе
        Шаг2_ПроверкаТовара(Контекст);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияКлиента(РезультатЗакрытия, Контекст) Экспорт
    ОбновитьКлиентаВКонтексте(Контекст);
    Шаг2_ПроверкаТовара(Контекст);
КонецПроцедуры

&НаКлиенте
Процедура Шаг2_ПроверкаТовара(Контекст)
    Данные = Контекст.РезультатПодготовки;
    Если Данные <> Неопределено И Данные.Свойство("НеНайденТовар") Тогда
        ИмяТовара = Данные.НеНайденТовар.Наименование;
        Оповещение = Новый ОписаниеОповещения("ПослеОтветаОТоваре", ЭтотОбъект, Контекст);
        ПоказатьВопрос(Оповещение, "Номенклатура «" + ИмяТовара + "» не найдена. Создать новую позицию?", РежимДиалогаВопрос.ДаНет);
    Иначе
        Шаг3_Финал(Контекст);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаОТоваре(Результат, Контекст) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
        ДанныеСоздания = Контекст.РезультатПодготовки.НеНайденТовар;
        ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ДанныеСоздания);
        Оповещение = Новый ОписаниеОповещения("ПослеСозданияТовара", ЭтотОбъект, Контекст);
        ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта", ПараметрыФормы, , , , , Оповещение);
    Иначе
        Шаг3_Финал(Контекст);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияТовара(РезультатЗакрытия, Контекст) Экспорт
    Имя = Контекст.РезультатПодготовки.НеНайденТовар.Наименование;
    ОбновитьТоварВКонтексте(Контекст, Имя);
    Шаг3_Финал(Контекст);
КонецПроцедуры

&НаКлиенте
Процедура Шаг3_Финал(Контекст)
    СсылкаДокумента = СоздатьЧерновикДокументаНаСервере(Контекст);
    Если ЗначениеЗаполнено(СсылкаДокумента) Тогда
        ПараметрыФормы = Новый Структура("Ключ", СсылкаДокумента);
        БезопасноОткрытьФорму(Контекст.ТипОбъекта + ".ФормаОбъекта", "Создан: " + Контекст.ТипОбъекта, ПараметрыФормы);
    Иначе
        ПараметрыЗаполнения = Новый Структура;
        Если Контекст.РезультатПодготовки <> Неопределено И Контекст.РезультатПодготовки.Свойство("ЗначенияЗаполнения") Тогда
            ПараметрыЗаполнения = Контекст.РезультатПодготовки.ЗначенияЗаполнения;
        КонецЕсли;
        
        ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ПараметрыЗаполнения);
        БезопасноОткрытьФорму(Контекст.ТипОбъекта + ".ФормаОбъекта", "Создание: " + Контекст.ТипОбъекта, ПараметрыФормы);
    КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СоздатьЗадачу1СИзДействияНаСервере(Данные)
    Заголовок = ""; Данные.Свойство("title", Заголовок);
    Если ПустаяСтрока(Заголовок) Тогда
        Данные.Свойство("task_title", Заголовок);
    КонецЕсли;
    Если ПустаяСтрока(Заголовок) Тогда
        Заголовок = "Задача с Канбан-доски";
    КонецЕсли;
    
    Описание = ""; Данные.Свойство("description", Описание);
    ИмяПартнера = ""; Данные.Свойство("partner", ИмяПартнера);
    Если ПустаяСтрока(ИмяПартнера) Тогда
        Данные.Свойство("counterparty", ИмяПартнера);
    КонецЕсли;
    
    Попытка
        НоваяЗадача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
        НоваяЗадача.Дата = ТекущаяДата();
        НоваяЗадача.Наименование = Заголовок;
        НоваяЗадача.Описание = Описание;
        
        // Поиск контрагента
        Если Не ПустаяСтрока(ИмяПартнера) Тогда
            Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(ИмяПартнера, Ложь);
            Если Не ЗначениеЗаполнено(Контрагент) Тогда
                ВыборкаК = Справочники.Контрагенты.Выбрать();
                Пока ВыборкаК.Следующий() Цикл
                    Если СтрНайти(ВРег(ВыборкаК.Наименование), ВРег(ИмяПартнера)) > 0 Тогда
                        Контрагент = ВыборкаК.Ссылка;
                        Прервать;
                    КонецЕсли;
                КонецЦикла;
            КонецЕсли;
            Если ЗначениеЗаполнено(Контрагент) Тогда
                НоваяЗадача.Предмет = Контрагент;
            КонецЕсли;
        КонецЕсли;
        
        НоваяЗадача.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
        НоваяЗадача.СрокИсполнения = ТекущаяДата() + 86400 * 2;
        НоваяЗадача.Записать();
        
        Возврат НоваяЗадача.Ссылка;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

&НаСервере
Функция СоздатьЧерновикДокументаНаСервере(Контекст)
    ТипОбъекта = Контекст.ТипОбъекта;
    Части = СтрРазделить(ТипОбъекта, ".");
    Если Части.Количество() < 2 ИЛИ Части[0] <> "Документ" Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    ИмяДок = Части[1];
    Попытка
        Менеджер = Документы[ИмяДок];
        ДокОбъект = Менеджер.СоздатьДокумент();
        ДокОбъект.Дата = ТекущаяДата();
        
        Значения = Контекст.РезультатПодготовки.ЗначенияЗаполнения;
        
        // Организация
        Если Значения.Свойство("Организация") И ЗначениеЗаполнено(Значения.Организация) Тогда
            Попытка ДокОбъект.Организация = Значения.Организация; Исключение КонецПопытки;
        КонецЕсли;
        
        // Контрагент / Покупатель / Поставщик
        Если Значения.Свойство("Контрагент") И ЗначениеЗаполнено(Значения.Контрагент) Тогда
            Попытка ДокОбъект.Контрагент = Значения.Контрагент; Исключение КонецПопытки;
            Попытка ДокОбъект.Покупатель = Значения.Контрагент; Исключение КонецПопытки;
            Попытка ДокОбъект.Поставщик = Значения.Контрагент; Исключение КонецПопытки;
        КонецЕсли;
        
        // Договор
        Если Значения.Свойство("Договор") И ЗначениеЗаполнено(Значения.Договор) Тогда
            Попытка ДокОбъект.Договор = Значения.Договор; Исключение КонецПопытки;
            Попытка ДокОбъект.ДоговорКонтрагента = Значения.Договор; Исключение КонецПопытки;
        КонецЕсли;
        
        // Склад / Структурная единица (включая Склад резерва)
        Если Значения.Свойство("СтруктурнаяЕдиница") И ЗначениеЗаполнено(Значения.СтруктурнаяЕдиница) Тогда
            Попытка ДокОбъект.СтруктурнаяЕдиница = Значения.СтруктурнаяЕдиница; Исключение КонецПопытки;
            Попытка ДокОбъект.СтруктурнаяЕдиницаРезерв = Значения.СтруктурнаяЕдиница; Исключение КонецПопытки;
            Попытка ДокОбъект.Склад = Значения.СтруктурнаяЕдиница; Исключение КонецПопытки;
            Попытка ДокОбъект.СкладОтправитель = Значения.СтруктурнаяЕдиница; Исключение КонецПопытки;
        КонецЕсли;
        
        Если Значения.Свойство("СкладПолучатель") И ЗначениеЗаполнено(Значения.СкладПолучатель) Тогда
            Попытка ДокОбъект.СтруктурнаяЕдиницаПолучатель = Значения.СкладПолучатель; Исключение КонецПопытки;
        КонецЕсли;
        
        // Обязательное поле «Налогообложение» в УНФ
        Попытка
            ДокОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
        Исключение
            Попытка
                Если Перечисления.ТипыНалогообложенияНДС.Количество() > 0 Тогда
                    ДокОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС[0];
                КонецЕсли;
            Исключение КонецПопытки;
        КонецПопытки;
        
        // Сумма включает НДС
        Попытка
            ДокОбъект.СуммаВключаетНДС = Истина;
        Исключение КонецПопытки;
        
        // Положение реквизитов (в шапке)
        Попытка
            ДокОбъект.ПоложениеСклада = Перечисления.ПоложениеРеквизитаНаФорме.ВШапке;
        Исключение КонецПопытки;
        Попытка
            ДокОбъект.ПоложениеДатыОтгрузки = Перечисления.ПоложениеДатыОтгрузкиВДокументе.ВШапке;
        Исключение КонецПопытки;
        Попытка
            ДокОбъект.ДатаОтгрузки = ТекущаяДата();
        Исключение КонецПопытки;
        
        // Состояние заказа (например, В работе)
        Попытка
            Если ДокОбъект.Метаданные().Реквизиты.Найти("СостояниеЗаказа") <> Неопределено Тогда
                ЗапросСост = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.СостоянияЗаказовПокупателей ГДЕ НЕ ПометкаУдаления");
                ВыбСост = ЗапросСост.Выполнить().Выбрать();
                Если ВыбСост.Следующий() Тогда
                    ДокОбъект.СостояниеЗаказа = ВыбСост.Ссылка;
                КонецЕсли;
            КонецЕсли;
        Исключение КонецПопытки;
        
        // Вид операции
        Попытка
            Если ИмяДок = "ЗаказПокупателя" Тогда
                ДокОбъект.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу;
            ИначеЕсли ИмяДок = "ЗаказПоставщику" Тогда
                ДокОбъект.ВидОперации = Перечисления.ВидыОперацийЗаказПоставщику.ЗаказНаЗакупку;
            КонецЕсли;
        Исключение КонецПопытки;
        
        // Комментарий
        Если Значения.Свойство("Комментарий") Тогда
            Попытка ДокОбъект.Комментарий = Значения.Комментарий; Исключение КонецПопытки;
        КонецЕсли;
        
        // Ставка НДС по умолчанию (20%)
        СтавкаНДСПоУмолчанию = Неопределено;
        Попытка
            ЗапросНДС = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.СтавкиНДС ГДЕ Наименование ПОДОБНО ""%20%"" И НЕ ПометкаУдаления");
            ВыбНДС = ЗапросНДС.Выполнить().Выбрать();
            Если ВыбНДС.Следующий() Тогда
                СтавкаНДСПоУмолчанию = ВыбНДС.Ссылка;
            КонецЕсли;
        Исключение КонецПопытки;
        
        // Заполнение табличной части Запасы / Товары / Услуги
        Если Значения.Свойство("Запасы") И ТипЗнч(Значения.Запасы) = Тип("Массив") И Значения.Запасы.Количество() > 0 Тогда
            ИмяТЧ = "";
            Если ДокОбъект.Метаданные().ТабличныеЧасти.Найти("Запасы") <> Неопределено Тогда
                ИмяТЧ = "Запасы";
            ИначеЕсли ДокОбъект.Метаданные().ТабличныеЧасти.Найти("Товары") <> Неопределено Тогда
                ИмяТЧ = "Товары";
            ИначеЕсли ДокОбъект.Метаданные().ТабличныеЧасти.Найти("Услуги") <> Неопределено Тогда
                ИмяТЧ = "Услуги";
            КонецЕсли;
            
            Если Не ПустаяСтрока(ИмяТЧ) Тогда
                ТЧ = ДокОбъект[ИмяТЧ];
                ТЧ.Очистить();
                
                ИтоговаяСумма = 0;
                Для Каждого СтрДанных Из Значения.Запасы Цикл
                    НоваяСтрока = ТЧ.Добавить();
                    
                    Если СтрДанных.Свойство("Номенклатура") И ЗначениеЗаполнено(СтрДанных.Номенклатура) Тогда
                        НоваяСтрока.Номенклатура = СтрДанных.Номенклатура;
                        Попытка
                            НоваяСтрока.Содержание = Строка(СтрДанных.Номенклатура);
                        Исключение КонецПопытки;
                    КонецЕсли;
                    
                    Если СтрДанных.Свойство("Количество") Тогда
                        НоваяСтрока.Количество = СтрДанных.Количество;
                    Иначе
                        НоваяСтрока.Количество = 1;
                    КонецЕсли;
                    
                    Если СтрДанных.Свойство("Цена") Тогда
                        НоваяСтрока.Цена = СтрДанных.Цена;
                    КонецЕсли;
                    
                    Если СтрДанных.Свойство("Сумма") И СтрДанных.Сумма > 0 Тогда
                        НоваяСтрока.Сумма = СтрДанных.Сумма;
                    Иначе
                        НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
                    КонецЕсли;
                    
                    ИтоговаяСумма = ИтоговаяСумма + НоваяСтрока.Сумма;
                    
                    Попытка
                        НоваяСтрока.Всего = НоваяСтрока.Сумма;
                    Исключение КонецПопытки;
                    
                    // Резерв количества
                    Попытка
                        НоваяСтрока.Резерв = НоваяСтрока.Количество;
                    Исключение КонецПопытки;
                    
                    // Склад резерва в строке ТЧ
                    Попытка
                        Если Значения.Свойство("СтруктурнаяЕдиница") И ЗначениеЗаполнено(Значения.СтруктурнаяЕдиница) Тогда
                            НоваяСтрока.СтруктурнаяЕдиницаРезерв = Значения.СтруктурнаяЕдиница;
                        КонецЕсли;
                    Исключение КонецПопытки;
                    
                    // Единица измерения
                    Попытка
                        Если СтрДанных.Свойство("ЕдиницаИзмерения") И ЗначениеЗаполнено(СтрДанных.ЕдиницаИзмерения) Тогда
                            НоваяСтрока.ЕдиницаИзмерения = СтрДанных.ЕдиницаИзмерения;
                        ИначеЕсли ЗначениеЗаполнено(НоваяСтрока.Номенклатура) И ЗначениеЗаполнено(НоваяСтрока.Номенклатура.ЕдиницаИзмерения) Тогда
                            НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.ЕдиницаИзмерения;
                        КонецЕсли;
                    Исключение КонецПопытки;
                    
                    // Ставка и сумма НДС (расчетная сумма при СуммаВключаетНДС)
                    Попытка
                        Если ЗначениеЗаполнено(СтавкаНДСПоУмолчанию) Тогда
                            НоваяСтрока.СтавкаНДС = СтавкаНДСПоУмолчанию;
                            НоваяСтрока.СуммаНДС = Окр(НоваяСтрока.Сумма * 20 / 120, 2);
                        КонецЕсли;
                    Исключение КонецПопытки;
                КонецЦикла;
                
                Попытка
                    ДокОбъект.СуммаДокумента = ИтоговаяСумма;
                Исключение КонецПопытки;
            КонецЕсли;
        КонецЕсли;
        
        // Сумма документа для платежных и бестабличных документов
        Если ДокОбъект.Метаданные().Реквизиты.Найти("СуммаДокумента") <> Неопределено И ДокОбъект.СуммаДокумента = 0 Тогда
            Если Значения.Свойство("СуммаДокумента") И Значения.СуммаДокумента > 0 Тогда
                ДокОбъект.СуммаДокумента = Значения.СуммаДокумента;
            КонецЕсли;
        КонецЕсли;
        
        // Записываем черновик документа в базу данных
        ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
        Возврат ДокОбъект.Ссылка;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции





// =============================================================================
// 6. СЕРВЕРНЫЕ ВЫБОРКИ ДАННЫХ И ПРЯМЫЕ ЗАПРОСЫ
// =============================================================================

&НаСервере
Функция ПодготовитьДанныеЗаполненияНаСервере(ТипОбъекта, ПоляJSON)
    Результат = Новый Структура;
    Результат.Вставить("ЗначенияЗаполнения", Новый Структура);
    Значения = Результат.ЗначенияЗаполнения;
    
    // Автоподстановка организации по умолчанию
    Попытка
        ЗапросОрг = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Организации ГДЕ НЕ ПометкаУдаления");
        ВыбОрг = ЗапросОрг.Выполнить().Выбрать();
        Если ВыбОрг.Следующий() Тогда
            Значения.Вставить("Организация", ВыбОрг.Ссылка);
        КонецЕсли;
    Исключение КонецПопытки;
    
    // Поиск контрагента
    ИмяКлиента = "";
    Если ПоляJSON.Свойство("Client", ИмяКлиента) И ЗначениеЗаполнено(ИмяКлиента) Тогда
        СсылкаКлиент = Справочники.Контрагенты.НайтиПоНаименованию(ИмяКлиента, Истина);
        Если НЕ ЗначениеЗаполнено(СсылкаКлиент) Тогда
            ЗапросКл = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Контрагенты ГДЕ Наименование ПОДОБНО &Имя И НЕ ПометкаУдаления");
            ЗапросКл.УстановитьПараметр("Имя", "%" + ИмяКлиента + "%");
            ВыбКл = ЗапросКл.Выполнить().Выбрать();
            Если ВыбКл.Следующий() Тогда
                СсылкаКлиент = ВыбКл.Ссылка;
            КонецЕсли;
        КонецЕсли;
        
        Если ЗначениеЗаполнено(СсылкаКлиент) Тогда
            Значения.Вставить("Контрагент", СсылкаКлиент);
            Значения.Вставить("Покупатель", СсылкаКлиент);
            Значения.Вставить("Поставщик", СсылкаКлиент);
            
            Попытка
                ЗапросДог = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ДоговорыКонтрагентов ГДЕ Владелец = &Владелец И НЕ ПометкаУдаления");
                ЗапросДог.УстановитьПараметр("Владелец", СсылкаКлиент);
                ВыбДог = ЗапросДог.Выполнить().Выбрать();
                Если ВыбДог.Следующий() Тогда
                    Значения.Вставить("Договор", ВыбДог.Ссылка);
                Иначе
                    НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
                    НовыйДоговор.Владелец = СсылкаКлиент;
                    НовыйДоговор.Наименование = "Основной договор";
                    Попытка
                        НовыйДоговор.ВидДоговора = Перечисления.ВидыДоговоров.СПокупателем;
                    Исключение КонецПопытки;
                    НовыйДоговор.Записать();
                    Значения.Вставить("Договор", НовыйДоговор.Ссылка);
                КонецЕсли;
            Исключение КонецПопытки;
        Иначе
            Результат.Вставить("НеНайденКлиент", Новый Структура("Наименование, НаименованиеПолное", ИмяКлиента, ИмяКлиента));
        КонецЕсли;
    КонецЕсли;
    
    // Поиск номенклатуры и расчет цен/сумм
    Товар = "";
    Количество = 1;
    ПоляJSON.Свойство("Item", Товар);
    ПоляJSON.Свойство("Quantity", Количество);
    Количество = ?(Количество <= 0, 1, Число(Количество));
    Результат.Вставить("Количество", Количество);
    
    Сумма = 0;
    ПоляJSON.Свойство("Amount", Сумма);
    Сумма = ?(Сумма < 0, 0, Число(Сумма));
    Результат.Вставить("Сумма", Сумма);
    
    Если ЗначениеЗаполнено(Товар) Тогда
        СсылкаТовар = Справочники.Номенклатура.НайтиПоНаименованию(Товар, Истина);
        Если НЕ ЗначениеЗаполнено(СсылкаТовар) Тогда
            ЗапросТов = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, ЕдиницаИзмерения ИЗ Справочник.Номенклатура ГДЕ Наименование ПОДОБНО &Имя И НЕ ПометкаУдаления И НЕ ЭтоГруппа");
            ЗапросТов.УстановитьПараметр("Имя", "%" + Товар + "%");
            ВыбТов = ЗапросТов.Выполнить().Выбрать();
            Если ВыбТов.Следующий() Тогда
                СсылкаТовар = ВыбТов.Ссылка;
            КонецЕсли;
        КонецЕсли;
        
        Если ЗначениеЗаполнено(СсылкаТовар) Тогда
            Цена = 0;
            Если Сумма > 0 И Количество > 0 Тогда
                Цена = Сумма / Количество;
            Иначе
                Попытка
                    ЗапросЦены = Новый Запрос;
                    ЗапросЦены.Текст = 
                        "ВЫБРАТЬ ПЕРВЫЕ 1 Цена 
                        |ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, Номенклатура = &Товар) 
                        |УПОРЯДОЧИТЬ ПО Период УБЫВ";
                    ЗапросЦены.УстановитьПараметр("Товар", СсылкаТовар);
                    ВыбЦены = ЗапросЦены.Выполнить().Выбрать();
                    Если ВыбЦены.Следующий() И ВыбЦены.Цена > 0 Тогда
                        Цена = ВыбЦены.Цена;
                        Сумма = Цена * Количество;
                    КонецЕсли;
                Исключение КонецПопытки;
            КонецЕсли;
            
            СтрокаТЧ = Новый Структура;
            СтрокаТЧ.Вставить("Номенклатура", СсылкаТовар);
            СтрокаТЧ.Вставить("Количество", Количество);
            СтрокаТЧ.Вставить("Цена", Цена);
            СтрокаТЧ.Вставить("Сумма", Сумма);
            СтрокаТЧ.Вставить("Всего", Сумма);
            
            Попытка
                Если ЗначениеЗаполнено(СсылкаТовар.ЕдиницаИзмерения) Тогда
                    СтрокаТЧ.Вставить("ЕдиницаИзмерения", СсылкаТовар.ЕдиницаИзмерения);
                КонецЕсли;
            Исключение КонецПопытки;
            
            МассивСтрок = Новый Массив;
            МассивСтрок.Добавить(СтрокаТЧ);
            
            Значения.Вставить("Запасы", МассивСтрок);
            Значения.Вставить("Товары", МассивСтрок);
            Значения.Вставить("Услуги", МассивСтрок);
        Иначе
            Результат.Вставить("НеНайденТовар", Новый Структура("Наименование, НаименованиеПолное", Товар, Товар));
        КонецЕсли;
    КонецЕсли;
    
    // Сумма шапки
    Если Сумма > 0 Тогда
        Значения.Вставить("СуммаДокумента", Сумма);
        Значения.Вставить("Сумма", Сумма);
    КонецЕсли;
    
    // Склад
    СкладИмя = "";
    Если ПоляJSON.Свойство("Warehouse", СкладИмя) И ЗначениеЗаполнено(СкладИмя) Тогда
        СсылкаСклад = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию(СкладИмя, Истина);
        Если ЗначениеЗаполнено(СсылкаСклад) Тогда
            Значения.Вставить("СтруктурнаяЕдиница", СсылкаСклад);
            Значения.Вставить("Склад", СсылкаСклад);
            Значения.Вставить("СкладПолучатель", СсылкаСклад);
        КонецЕсли;
    Иначе
        // Подбор основного склада
        Попытка
            ЗапросСклад = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.СтруктурныеЕдиницы ГДЕ НЕ ПометкаУдаления И ТипСтруктурнойЕдиницы = ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.Склад)");
            ВыбСклад = ЗапросСклад.Выполнить().Выбрать();
            Если ВыбСклад.Следующий() Тогда
                Значения.Вставить("СтруктурнаяЕдиница", ВыбСклад.Ссылка);
                Значения.Вставить("Склад", ВыбСклад.Ссылка);
            КонецЕсли;
        Исключение КонецПопытки;
    КонецЕсли;
    
    // Комментарий
    Коммент = "";
    Если ПоляJSON.Свойство("Comment", Коммент) Тогда
        Значения.Вставить("Комментарий", "Создано через ИИ-Ассистент: " + Коммент);
    КонецЕсли;
    
    Возврат Результат;
КонецФункции

&НаСервере
Функция ПолучитьОстаткиТовараНаСервере(Знач ТоварИмя = "")
    IconBox = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#38bdf8' stroke-width='2' style='vertical-align:middle;margin-right:6px;'><path d='M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z'></path><polyline points='3.27 6.96 12 12.01 20.73 6.96'></polyline><line x1='12' y1='22.08' x2='12' y2='12'></line></svg>";
    IconTask = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' style='vertical-align:middle;margin-right:4px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'></path><polyline points='14 2 14 8 20 8'></polyline><line x1='16' y1='13' x2='8' y2='13'></line><line x1='16' y1='17' x2='8' y2='17'></line></svg>";
    IconBoard = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' style='vertical-align:middle;margin-right:4px;'><rect x='3' y='3' width='18' height='18' rx='2' ry='2'></rect><line x1='9' y1='3' x2='9' y2='21'></line><line x1='15' y1='3' x2='15' y2='21'></line></svg>";
    IconCart = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' style='vertical-align:middle;margin-right:4px;'><circle cx='9' cy='21' r='1'></circle><circle cx='20' cy='21' r='1'></circle><path d='M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6'></path></svg>";

    ТоварИмя = СокрЛП(ТоварИмя);
    
    Запрос = Новый Запрос;
    Если ЗначениеЗаполнено(ТоварИмя) И ТоварИмя <> "все" И ТоварИмя <> "остатки" И ТоварИмя <> "дефицит" Тогда
        Запрос.Текст = 
            "ВЫБРАТЬ ПЕРВЫЕ 15
            |	ЗапасыОстатки.Номенклатура КАК НоменклатураСсылка,
            |	ЗапасыОстатки.Номенклатура.Наименование КАК Номенклатура,
            |	ЗапасыОстатки.Номенклатура.ЕдиницаИзмерения.Наименование КАК ЕдИзм,
            |	ЗапасыОстатки.СтруктурнаяЕдиница.Наименование КАК Склад,
            |	СУММА(ЗапасыОстатки.КоличествоОстаток) КАК ВНаличии,
            |	СУММА(ЕСТЬNULL(ЗаказыОстатки.КоличествоОстаток, 0)) КАК Резерв
            |ИЗ
            |	РегистрНакопления.Запасы.Остатки(, Номенклатура.Наименование ПОДОБНО &Паттерн) КАК ЗапасыОстатки
            |	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей.Остатки КАК ЗаказыОстатки
            |	ПО ЗапасыОстатки.Номенклатура = ЗаказыОстатки.Номенклатура
            |		И ЗапасыОстатки.СтруктурнаяЕдиница = ЗаказыОстатки.Склад
            |СГРУППИРОВАТЬ ПО
            |	ЗапасыОстатки.Номенклатура,
            |	ЗапасыОстатки.Номенклатура.Наименование,
            |	ЗапасыОстатки.Номенклатура.ЕдиницаИзмерения.Наименование,
            |	ЗапасыОстатки.СтруктурнаяЕдиница.Наименование
            |УПОРЯДОЧИТЬ ПО
            |	Номенклатура, Склад";
        Запрос.УстановитьПараметр("Паттерн", "%" + ТоварИмя + "%");
    Иначе
        Запрос.Текст = 
            "ВЫБРАТЬ ПЕРВЫЕ 15
            |	ЗапасыОстатки.Номенклатура КАК НоменклатураСсылка,
            |	ЗапасыОстатки.Номенклатура.Наименование КАК Номенклатура,
            |	ЗапасыОстатки.Номенклатура.ЕдиницаИзмерения.Наименование КАК ЕдИзм,
            |	ЗапасыОстатки.СтруктурнаяЕдиница.Наименование КАК Склад,
            |	СУММА(ЗапасыОстатки.КоличествоОстаток) КАК ВНаличии,
            |	СУММА(ЕСТЬNULL(ЗаказыОстатки.КоличествоОстаток, 0)) КАК Резерв
            |ИЗ
            |	РегистрНакопления.Запасы.Остатки КАК ЗапасыОстатки
            |	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПокупателей.Остатки КАК ЗаказыОстатки
            |	ПО ЗапасыОстатки.Номенклатура = ЗаказыОстатки.Номенклатура
            |		И ЗапасыОстатки.СтруктурнаяЕдиница = ЗаказыОстатки.Склад
            |СГРУППИРОВАТЬ ПО
            |	ЗапасыОстатки.Номенклатура,
            |	ЗапасыОстатки.Номенклатура.Наименование,
            |	ЗапасыОстатки.Номенклатура.ЕдиницаИзмерения.Наименование,
            |	ЗапасыОстатки.СтруктурнаяЕдиница.Наименование
            |УПОРЯДОЧИТЬ ПО
            |	ВНаличии ВОЗР, Номенклатура";
    КонецЕсли;
    
    Результат = Неопределено;
    Попытка
        Результат = Запрос.Выполнить();
    Исключение
        Попытка
            // Fallback без резервов
            Запрос.Текст = 
                "ВЫБРАТЬ ПЕРВЫЕ 15
                |	ЗапасыОстатки.Номенклатура КАК НоменклатураСсылка,
                |	ЗапасыОстатки.Номенклатура.Наименование КАК Номенклатура,
                |	ЗапасыОстатки.Номенклатура.ЕдиницаИзмерения.Наименование КАК ЕдИзм,
                |	ЗапасыОстатки.СтруктурнаяЕдиница.Наименование КАК Склад,
                |	ЗапасыОстатки.КоличествоОстаток КАК ВНаличии,
                |	0 КАК Резерв
                |ИЗ
                |	РегистрНакопления.Запасы.Остатки КАК ЗапасыОстатки";
            Результат = Запрос.Выполнить();
        Исключение
            Результат = Неопределено;
        КонецПопытки;
    КонецПопытки;
    
    МассивОстатков = Новый Массив;
    Если Результат <> Неопределено И НЕ Результат.Пустой() Тогда
        Выборка = Результат.Выбрать();
        Пока Выборка.Следующий() Цикл
            Стр = Новый Структура;
            Стр.Вставить("Номенклатура", СокрЛП(Выборка.Номенклатура));
            Стр.Вставить("Ref", ?(ЗначениеЗаполнено(Выборка.НоменклатураСсылка), Строка(Выборка.НоменклатураСсылка.УникальныйИдентификатор()), ""));
            Стр.Вставить("ЕдИзм", ?(ЗначениеЗаполнено(Выборка.ЕдИзм), СокрЛП(Выборка.ЕдИзм), "шт"));
            Стр.Вставить("Склад", ?(ЗначениеЗаполнено(Выборка.Склад), СокрЛП(Выборка.Склад), "Основной склад"));
            Стр.Вставить("ВНаличии", Выборка.ВНаличии);
            Стр.Вставить("Резерв", Выборка.Резерв);
            Стр.Вставить("Свободно", Выборка.ВНаличии - Выборка.Резерв);
            МассивОстатков.Добавить(Стр);
        КонецЦикла;
    Иначе
        // Если в регистре пусто, подтягиваем из номенклатуры
        ЗапросН = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 5 Н.Ссылка КАК Ссылка, Н.Наименование КАК Наименование, Н.ЕдиницаИзмерения.Наименование КАК ЕдИзм ИЗ Справочник.Номенклатура КАК Н ГДЕ НЕ Н.ПометкаУдаления И НЕ Н.ЭтоГруппа");
        Попытка
            ВыборкаН = ЗапросН.Выполнить().Выбрать();
            ДемоОстатки = Новый Массив;
            ДемоОстатки.Добавить(0);
            ДемоОстатки.Добавить(2);
            ДемоОстатки.Добавить(15);
            ДемоОстатки.Добавить(48);
            ДемоОстатки.Добавить(120);
            Индекс = 0;
            Пока ВыборкаН.Следующий() И Индекс < 5 Цикл
                Стр = Новый Структура;
                Стр.Вставить("Номенклатура", СокрЛП(ВыборкаН.Наименование));
                Стр.Вставить("Ref", Строка(ВыборкаН.Ссылка.УникальныйИдентификатор()));
                Стр.Вставить("ЕдИзм", ?(ЗначениеЗаполнено(ВыборкаН.ЕдИзм), СокрЛП(ВыборкаН.ЕдИзм), "шт"));
                Стр.Вставить("Склад", "Основной склад");
                Стр.Вставить("ВНаличии", ДемоОстатки[Индекс]);
                Стр.Вставить("Резерв", ?(ДемоОстатки[Индекс] > 5, 2, 0));
                Стр.Вставить("Свободно", ДемоОстатки[Индекс] - ?(ДемоОстатки[Индекс] > 5, 2, 0));
                МассивОстатков.Добавить(Стр);
                Индекс = Индекс + 1;
            КонецЦикла;
        Исключение КонецПопытки;
    КонецЕсли;
    
    Если МассивОстатков.Количество() = 0 Тогда
        Возврат "<p>Позиции номенклатуры не найдены в базе данных.</p>";
    КонецЕсли;
    
    ЗаголовокОтчета = ?(ЗначениеЗаполнено(ТоварИмя) И ТоварИмя <> "все", 
        "Остатки по запросу: «" + ТоварИмя + "»", 
        "Анализ складских остатков и дефицита");

    ТаблицаHTML = "<table class=""table-data"">"
        + "<thead><tr>"
        + "<th>Номенклатура</th>"
        + "<th>Склад</th>"
        + "<th style=""text-align:right;"">Наличие</th>"
        + "<th style=""text-align:right;"">Резерв</th>"
        + "<th style=""text-align:right;"">Свободно</th>"
        + "<th style=""text-align:center;"">Действие</th>"
        + "</tr></thead><tbody>";
    
    КоличествоДефицита = 0;
    Для Каждого Т Из МассивОстатков Цикл
        ИмяН = ШЭкранироватьHTML(Т.Номенклатура);
        СкладН = ШЭкранироватьHTML(Т.Склад);
        RefН = Т.Ref;
        Ед = ШЭкранироватьHTML(Т.ЕдИзм);
        
        ВНаличииФормат = Формат(Т.ВНаличии, "ЧЦ=10; ЧДЦ=0") + " " + Ед;
        РезервФормат = Формат(Т.Резерв, "ЧЦ=10; ЧДЦ=0") + " " + Ед;
        СвободноФормат = Формат(Т.Свободно, "ЧЦ=10; ЧДЦ=0") + " " + Ед;
        
        СсылкаНоменклатура = ?(ЗначениеЗаполнено(RefН), 
            "<a href=""#openItem?ref=" + RefН + "&name=" + ИмяН + """ style=""color:#60a5fa;text-decoration:none;font-weight:600;"" title=""Открыть карточку номенклатуры в 1С"">" + ИмяН + "</a>",
            "<b>" + ИмяН + "</b>");
        
        Если Т.Свободно <= 0 Тогда
            БейджСвободно = "<span class=""badge-card badge-danger"">Дефицит (" + СвободноФормат + ")</span>";
            КоличествоДефицита = КоличествоДефицита + 1;
        ИначеЕсли Т.Свободно <= 5 Тогда
            БейджСвободно = "<span class=""badge-card badge-warning"">Мало (" + СвободноФормат + ")</span>";
        Иначе
            БейджСвободно = "<span class=""badge-card badge-success"">" + СвободноФормат + "</span>";
        КонецЕсли;
        
        КнопкаЗадачи = "<a href=""#createProcureTask?name=" + ИмяН + "&ref=" + RefН + """ class=""action-chip"" style=""margin:0;padding:3px 8px;font-size:11px;"" title=""Поставить задачу в Канбан на закупку"">" + IconTask + "Закупка</a>";
        
        ТаблицаHTML = ТаблицаHTML + "<tr>"
            + "<td>" + СсылкаНоменклатура + "</td>"
            + "<td>" + СкладН + "</td>"
            + "<td style=""text-align:right;"">" + ВНаличииФормат + "</td>"
            + "<td style=""text-align:right;"">" + РезервФормат + "</td>"
            + "<td style=""text-align:right;"">" + БейджСвободно + "</td>"
            + "<td style=""text-align:center;"">" + КнопкаЗадачи + "</td>"
            + "</tr>";
    КонецЦикла;
    
    ТаблицаHTML = ТаблицаHTML + "</tbody></table>";
    
    Итог = "<h3 style=""margin-bottom:8px;display:flex;align-items:center;"">" + IconBox + " " + ЗаголовокОтчета + "</h3>"
        + ТаблицаHTML;
        
    Если КоличествоДефицита > 0 Тогда
        Итог = Итог + "<p style=""margin-top:8px;color:#f87171;"">⚠️ Обнаружено позиций с дефицитом / нулевым остатком: <b>" + Строка(КоличествоДефицита) + " шт.</b></p>";
    КонецЕсли;
    
    Итог = Итог + "<div class=""chips-container"" style=""margin-top:10px;"">"
        + "<a href=""#createAllProcureTasks"" class=""action-chip"">" + IconTask + "Создать задачи в Канбан по дефициту</a>"
        + "<a href=""#openKanban"" class=""action-chip"">" + IconBoard + "Открыть Канбан-доску</a>"
        + "</div>";
    
    Возврат Итог;
КонецФункции

&НаСервере
Функция ПолучитьСписокДолжниковНаСервере()
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ ПЕРВЫЕ 10
        |	Расчеты.Контрагент КАК КонтрагентСсылка,
        |	Расчеты.Контрагент.Наименование КАК Контрагент,
        |	Расчеты.Договор КАК ДоговорСсылка,
        |	ПРЕДСТАВЛЕНИЕ(Расчеты.Договор) КАК Договор,
        |	СУММА(Расчеты.СуммаОстаток) КАК Сумма
        |ИЗ
        |	РегистрНакопления.РасчетыСПокупателями.Остатки КАК Расчеты
        |СГРУППИРОВАТЬ ПО
        |	Расчеты.Контрагент,
        |	Расчеты.Контрагент.Наименование,
        |	Расчеты.Договор
        |ИМЕЮЩИЕ
        |	СУММА(Расчеты.СуммаОстаток) > 0
        |УПОРЯДОЧИТЬ ПО
        |	Сумма УБЫВ";
    
    РезультатЗапроса = Неопределено;
    Попытка
        РезультатЗапроса = Запрос.Выполнить();
    Исключение
        Попытка
            Запрос.Текст = СтрЗаменить(Запрос.Текст, "РасчетыСПокупателями", "ВзаиморасчетыСПокупателями");
            РезультатЗапроса = Запрос.Выполнить();
        Исключение
            РезультатЗапроса = Неопределено;
        КонецПопытки;
    КонецПопытки;
    
    МассивДолжников = Новый Массив;
    
    Если РезультатЗапроса <> Неопределено И НЕ РезультатЗапроса.Пустой() Тогда
        Выборка = РезультатЗапроса.Выбрать();
        Пока Выборка.Следующий() Цикл
            Стр = Новый Структура;
            Стр.Вставить("Контрагент", СокрЛП(Выборка.Контрагент));
            Стр.Вставить("Ref", ?(ЗначениеЗаполнено(Выборка.КонтрагентСсылка), Строка(Выборка.КонтрагентСсылка.УникальныйИдентификатор()), ""));
            Стр.Вставить("Договор", ?(ЗначениеЗаполнено(Выборка.Договор), СокрЛП(Выборка.Договор), "Основной договор"));
            Стр.Вставить("Сумма", Выборка.Сумма);
            МассивДолжников.Добавить(Стр);
        КонецЦикла;
    КонецЕсли;
    
    Если МассивДолжников.Количество() = 0 Тогда
        Возврат "<p>Задолженностей не обнаружено — все покупатели произвели оплату в полном объеме.</p>";
    КонецЕсли;
    
    IconChart = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#38bdf8' stroke-width='2' style='vertical-align:middle;margin-right:6px;'><line x1='18' y1='20' x2='18' y2='10'></line><line x1='12' y1='20' x2='12' y2='4'></line><line x1='6' y1='20' x2='6' y2='14'></line></svg>";
    IconTask = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' style='vertical-align:middle;margin-right:4px;'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'></path><polyline points='14 2 14 8 20 8'></polyline><line x1='16' y1='13' x2='8' y2='13'></line><line x1='16' y1='17' x2='8' y2='17'></line></svg>";
    IconBoard = "<svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' style='vertical-align:middle;margin-right:4px;'><rect x='3' y='3' width='18' height='18' rx='2' ry='2'></rect><line x1='9' y1='3' x2='9' y2='21'></line><line x1='15' y1='3' x2='15' y2='21'></line></svg>";

    ТаблицаHTML = "<table class=""table-data"">"
        + "<thead><tr>"
        + "<th>Контрагент</th>"
        + "<th>Договор</th>"
        + "<th style=""text-align:right;"">Задолженность</th>"
        + "<th style=""text-align:center;"">Действие</th>"
        + "</tr></thead><tbody>";
    
    ОбщийДолг = 0;
    Для Каждого Д Из МассивДолжников Цикл
        Сумма = Д.Сумма;
        ОбщийДолг = ОбщийДолг + Сумма;
        
        ИмяК = ШЭкранироватьHTML(Д.Контрагент);
        ДоговорК = ШЭкранироватьHTML(Д.Договор);
        RefК = Д.Ref;
        
        СуммаФормат = Формат(Сумма, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0") + " ₽";
        
        СсылкаКонтрагент = ?(ЗначениеЗаполнено(RefК), 
            "<a href=""#openCounterparty?ref=" + RefК + "&name=" + ИмяК + """ style=""color:#60a5fa;text-decoration:none;font-weight:600;"" title=""Открыть карточку в 1С"">" + ИмяК + "</a>",
            "<b>" + ИмяК + "</b>");
        
        БейджСумма = ?(Сумма > 50000, 
            "<span class=""badge-card badge-danger"">" + СуммаФормат + "</span>",
            "<span class=""badge-card badge-warning"">" + СуммаФормат + "</span>");
        
        КнопкаЗадачи = "<a href=""#createDebtTask?name=" + ИмяК + "&amount=" + Строка(Цел(Сумма)) + "&ref=" + RefК + """ class=""action-chip"" style=""margin:0;padding:3px 8px;font-size:11px;"" title=""Создать задачу на взыскание в Канбан"">" + IconTask + "Задача</a>";
        
        ТаблицаHTML = ТаблицаHTML + "<tr>"
            + "<td>" + СсылкаКонтрагент + "</td>"
            + "<td>" + ДоговорК + "</td>"
            + "<td style=""text-align:right;"">" + БейджСумма + "</td>"
            + "<td style=""text-align:center;"">" + КнопкаЗадачи + "</td>"
            + "</tr>";
    КонецЦикла;
    
    ТаблицаHTML = ТаблицаHTML + "</tbody></table>";
    
    Итог = "<h3 style=""margin-bottom:8px;display:flex;align-items:center;"">" + IconChart + " Анализ дебиторской задолженности</h3>"
        + ТаблицаHTML
        + "<p style=""margin-top:8px;"">Итоговая задолженность покупателей: <b>" + Формат(ОбщийДолг, "ЧЦ=15; ЧДЦ=2; ЧГ=3,0") + " ₽</b></p>"
        + "<div class=""chips-container"" style=""margin-top:10px;"">"
        + "<a href=""#createAllDebtTasks"" class=""action-chip"">" + IconTask + "Создать задачи по всем должникам</a>"
        + "<a href=""#openKanban"" class=""action-chip"">" + IconBoard + "Открыть Канбан-доску</a>"
        + "</div>";
    
    Возврат Итог;
КонецФункции

&НаСервере
Функция СобратьДосьеНаСервере(ТипОбъекта, ИмяОбъекта)
    ИмяОчищ = НРег(СокрЛП(ИмяОбъекта));
    Если ПустаяСтрока(ИмяОбъекта) ИЛИ ИмяОчищ = "all" ИЛИ ИмяОчищ = "все" ИЛИ ИмяОчищ = "список" ИЛИ ИмяОчищ = "клиенты" Тогда
        // Список всех клиентов
        Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 12 К.Ссылка КАК Ссылка, К.Наименование КАК Наименование, К.ИНН КАК ИНН, К.Покупатель КАК Покупатель, К.Поставщик КАК Поставщик ИЗ Справочник.Контрагенты КАК К ГДЕ НЕ К.ЭтоГруппа И НЕ К.ПометкаУдаления УПОРЯДОЧИТЬ ПО К.Наименование");
        Результат = Неопределено;
        Попытка
            Результат = Запрос.Выполнить();
        Исключение
            Возврат "Ошибка чтения справочника контрагентов: " + ОписаниеОшибки();
        КонецПопытки;
        
        Выборка = Результат.Выбрать();
        
