    Шапка = "<!DOCTYPE html><html><head><meta charset=""UTF-8"">"
        + "<style>"
        + "* { margin: 0; padding: 0; box-sizing: border-box; }"
        + "html, body { height: 100%; width: 100%; overflow: hidden; }"
