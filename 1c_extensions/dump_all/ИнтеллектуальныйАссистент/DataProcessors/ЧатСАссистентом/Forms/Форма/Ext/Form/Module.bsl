&НаКлиенте
Процедура ОбновитьМетаданные(Команда)
    ДобавитьСообщениеВЧатНаСервере("Сборка метаданных конфигурации 1С:УНФ...", "bot", "expert_answer", Неопределено);
    ЧатHTML = СгенерироватьЧатHTML();
    
    АдресХранилища = СобратьМетаданныеНаСервере();
    JSON = ПолучитьИзВременногоХранилища(АдресХранилища);
    
    Попытка
        Ответ = ВыполнитьHTTPЗапрос("/update_metadata", JSON, "POST");
        Если Ответ <> Неопределено И Ответ.КодСостояния = 200 Тогда
            ДобавитьСообщениеВЧатНаСервере("✓ Метаданные успешно выгружены на Middleware и проиндексированы!", "bot", "expert_answer", Неопределено);
        Иначе
            ДобавитьСообщениеВЧатНаСервере("Ошибка обновления метаданных: " + ?(Ответ=Неопределено, "нет связи с сервером", Строка(Ответ.КодСостояния)), "bot", "expert_answer", Неопределено);
        КонецЕсли;
    Исключение
        ДобавитьСообщениеВЧатНаСервере("Исключение при обновлении метаданных: " + ОписаниеОшибки(), "bot", "expert_answer", Неопределено);
    КонецПопытки;
    ЧатHTML = СгенерироватьЧатHTML();
КонецПроцедуры

&НаСервере
Функция СобратьМетаданныеНаСервере()
    Список = Новый Массив;
    Коллекции = Новый Массив;
    Коллекции.Добавить("Справочники");
    Коллекции.Добавить("Документы");
    Коллекции.Добавить("Отчеты");
    Коллекции.Добавить("РегистрыНакопления");
    Коллекции.Добавить("РегистрыСведений");
    
    Для Каждого ИмяКоллекции Из Коллекции Цикл
        Для Каждого МетаОбъект Из Метаданные[ИмяКоллекции] Цикл
            ИмяТипа = ?(ИмяКоллекции="Справочники", "Справочник",
                      ?(ИмяКоллекции="Документы", "Документ",
                      ?(ИмяКоллекции="Отчеты", "Отчет",
                      ?(ИмяКоллекции="РегистрыНакопления", "РегистрНакопления", "РегистрСведений"))));
            
            МассивПолей = Новый Массив;
            Если ИмяКоллекции = "Справочники" ИЛИ ИмяКоллекции = "Документы" Тогда
                Для Каждого Рек Из МетаОбъект.СтандартныеРеквизиты Цикл
                    МассивПолей.Добавить(Новый Структура("name, synonym, type", Рек.Имя, Рек.Синоним, Строка(Рек.Тип)));
                КонецЦикла;
            КонецЕсли;
            Для Каждого Рек Из МетаОбъект.Реквизиты Цикл
                МассивПолей.Добавить(Новый Структура("name, synonym, type", Рек.Имя, Рек.Синоним, Строка(Рек.Тип)));
            КонецЦикла;
            
            СинонимОбъекта = ?(ПустаяСтрока(МетаОбъект.Синоним), МетаОбъект.Имя, МетаОбъект.Синоним);
            Список.Добавить(Новый Структура("name, synonym, fields", ИмяТипа + "." + МетаОбъект.Имя, СинонимОбъекта, МассивПолей));
        КонецЦикла;
    КонецЦикла;
    
    Пакет = Новый Структура("items", Список);
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Пакет);
    Возврат ПоместитьВоВременноеХранилище(ЗаписьJSON.Закрыть(), УникальныйИдентификатор);
КонецФункции

