# ═══════════════════════════════════════════════════════════════════
# 1C AI ASSISTANT MIDDLEWARE — КОНФИГУРАЦИОННЫЙ ФАЙЛ (.ENV)
# Поддержка отечественных ИИ-моделей (Сбер GigaChat, Яндекс YandexGPT)
# ═══════════════════════════════════════════════════════════════════

# ─── 1. ОТЕЧЕСТВЕННЫЙ ИИ-СТЕК (ПРИОРИТЕТНЫЙ) ──────────────────────
# Сбер GigaChat (GigaChat-Pro / GigaChat-Max):
# GIGACHAT_CREDENTIALS=your_sber_gigachat_api_credential_here
# GIGACHAT_MODEL=GigaChat-Pro

# Яндекс YandexGPT 5 Pro / Yandex SpeechKit:
# YANDEX_API_KEY=your_yandex_cloud_api_key_here
# YANDEX_FOLDER_ID=your_yandex_folder_id_here
# YANDEX_SPEECHKIT_API_KEY=your_yandex_speechkit_key_here

# Локальная суверенная модель по 152-ФЗ (Vikhr-7B / T-Lite) через vLLM / Ollama:
# LOCAL_RUSSIAN_LLM=true
# OLLAMA_HOST=http://localhost:11434/v1

# ─── 2. БАЗОВЫЕ НАСТРОЙКИ СЕРВЕРА ─────────────────────────────────
MIDDLEWARE_HOST=127.0.0.1
MIDDLEWARE_PORT=8000
JWT_SECRET=diplom_1c_demo_secret_key_2026_super_secure_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
RATE_LIMIT_ENABLED=false
LOG_LEVEL=INFO

# ─── 3. ОМНИКАНАЛЬНОСТЬ (VKONTAKTE / TELEGRAM / EMAIL) ─────────────
# ВКонтакте (Российская социальная сеть)
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_BIND_IP=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Required for VK Callback API; long polling does not use this secret.
VK_SECRET_KEY=
# Optional shared secret for the email ingestion endpoint; JWT also supported.
EMAIL_HOOK_SECRET=

# Корпоративная почта (Яндекс 360 / Mail.ru / VK WorkMail)
DIRECTOR_EMAIL=director@company.ru
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=bot@company.ru
SMTP_PASSWORD=
SMTP_FROM=bot@company.ru

IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
IMAP_USER=bot@company.ru
IMAP_PASSWORD=
