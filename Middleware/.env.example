FIREWORKS_API_KEY=your_fireworks_api_key_here
JWT_SECRET=your_random_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ─── Drone Tender Matcher (прикладное расширение для ООО «АТС Технологии») ───
# Фича-флаг прикладного расширения. При значении false эндпоинты /tender/*
# возвращают HTTP 404, а пост-обработка тендерных маркеров в /chat не активируется.
DRONE_FEATURE_ENABLED=true

# Параметры семантического поиска кандидатов в каталоге БПЛА.
DRONE_TOPK=10
# Лимит финального ранжирования готовых моделей.
MATCH_TOPN=5

# Веса финального скоринга готовых моделей (сумма должна быть = 1.0).
W_COSINE=0.20
W_COVER=0.35
W_LLM=0.45

# Веса скоринга собранной конфигурации BoM (сумма должна быть = 1.0).
BOM_W_COVER=0.35
BOM_W_COMPAT=0.30
BOM_W_OWN=0.15
BOM_W_PRICE_FIT=0.20

# Режим тестов качества подбора: live / offline / record.
# DRONE_EVAL_MODE=offline
